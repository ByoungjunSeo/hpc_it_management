<%- include('../partials/header', { title, currentPath, extraCss }) %>

<div class="page-header">
    <h1>자산 매칭</h1>
    <div class="btn-group">
        <button class="btn btn-primary" onclick="scanAllAssets()" id="scanAllBtn">전체 스캔</button>
        <button class="btn btn-secondary" onclick="scanSelectedAssets()" id="scanSelectedBtn">선택 스캔</button><%# B-T1.5: 스캔 위계 — 전체=primary, 선택/수동=secondary %>
        <button class="btn btn-outline" onclick="toggleManualScan()">수동 스캔</button>
    </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-error">자산 로드 오류: <%= error %></div>
<% } %>

<%
  var catMap = {};
  var totalWithChildren = 0;
  if (typeof assets !== 'undefined') {
    assets.forEach(function(a) {
      var mn = a.management_number || '';
      var cat = mn.replace(/-\d+$/, '');
      if (!catMap[cat]) catMap[cat] = 0;
      catMap[cat]++;
      totalWithChildren++;
      if (a.children) {
        catMap[cat] += a.children.length;
        totalWithChildren += a.children.length;
      }
    });
  }
  var catKeys = Object.keys(catMap).sort();
%>

<!-- Asset Matching Table -->
<div class="card" id="assetMatchingCard">
    <div class="card-header">
        <h2>서버실 자산 목록</h2>
        <span class="text-muted" style="font-size:13px;" id="assetCount">
            총 <strong><%= totalWithChildren %></strong>개 자산
        </span>
    </div>

    <!-- Category filter -->
    <div id="categoryFilter" style="padding:10px 16px; border-bottom:1px solid var(--border); display:flex; flex-wrap:wrap; gap:6px; align-items:center;">
        <span style="font-size:12px; color:var(--text-secondary); margin-right:4px;">분류:</span>
        <button class="btn btn-sm btn-primary category-btn" data-category="all" onclick="filterCategory('all')" style="font-size:11px; padding:2px 10px;">전체</button>
        <% catKeys.forEach(function(cat) { %>
        <button class="btn btn-sm btn-outline category-btn" data-category="<%= cat %>" onclick="filterCategory('<%= cat %>')" style="font-size:11px; padding:2px 10px;"><%= cat %> <span class="text-muted">(<%= catMap[cat] %>)</span></button>
        <% }); %>
    </div>

    <!-- Progress bar (hidden by default) -->
    <div id="scanAllProgress" style="display:none; padding:12px 16px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
            <span id="scanAllProgressText" style="font-size:13px;">스캔 준비중...</span>
            <span id="scanAllProgressCount" style="font-size:13px; color:var(--text-secondary);">0/0</span>
        </div>
        <div class="progress-bar" style="height:8px;">
            <div class="progress-fill" id="scanAllProgressFill" style="width:0%; background:var(--primary); transition:width 0.3s;"></div>
        </div>
        <div id="scanAllSummary" style="display:none; margin-top:8px; display:flex; gap:8px; flex-wrap:wrap;"></div>
    </div>

    <div style="overflow-x:auto;">
        <table id="assetTable">
            <thead>
                <tr>
                    <th style="width:40px;"><input type="checkbox" id="selectAll" onchange="toggleSelectAll(this)"></th>
                    <th>관리번호</th>
                    <th>자산번호</th>
                    <th>모델</th>
                    <th>위치</th>
                    <th>IP</th>
                    <th>등록 모듈</th>
                    <th>실제 모듈</th>
                    <th>상태</th>
                    <th style="width:100px;">작업</th>
                </tr>
            </thead>
            <tbody id="assetTableBody">
                <% if (typeof assets !== 'undefined' && assets.length > 0) { %>
                <% assets.forEach(function(asset) { %>
                <% var _cat = (asset.management_number || '').replace(/-\d+$/, ''); %>
                <tr id="asset-row-<%= asset.id %>" data-asset-id="<%= asset.id %>" data-category="<%= _cat %>"<% if (asset.children && asset.children.length > 0) { %> data-is-chassis="true"<% } %>>
                    <td><input type="checkbox" class="asset-check" value="<%= asset.id %>"<% if (asset.children && asset.children.length > 0) { %> disabled title="샤시는 하위 노드를 스캔하세요"<% } %>></td>
                    <td>
                        <a href="/assets/<%= asset.id %>" target="_blank" style="font-weight:600;">
                            <%= asset.management_number || asset.asset_number || 'ID:' + asset.id %>
                        </a>
                        <% if (asset.children && asset.children.length > 0) { %>
                        <span class="badge badge-info" style="font-size:10px; margin-left:4px;" title="하위 노드 <%= asset.children.length %>개">+<%= asset.children.length %></span>
                        <% } %>
                    </td>
                    <td style="font-size:12px;"><%= asset.asset_number || '-' %></td>
                    <td><%= asset.model_name || '-' %><% if (asset.manufacturer) { %> <span class="text-muted" style="font-size:11px;">(<%= asset.manufacturer %>)</span><% } %></td>
                    <td style="font-size:12px;">
                        <% if (asset.room_name) { %><%= asset.room_name %><% } %>
                        <% if (asset.rack_name) { %> / <%= asset.rack_name %><% } %>
                    </td>
                    <td style="font-size:12px;">
                        <% if (asset.ips && asset.ips.length > 0) { %>
                            <% var mgmtIp = asset.ips.find(function(i) { return i.ip_type === 'management'; }) || asset.ips.find(function(i) { return i.ip_type === 'os'; }) || asset.ips.find(function(i) { return i.ip_type !== 'bmc'; }) || asset.ips[0]; %>
                            <code><%= mgmtIp.ip_address %></code>
                            <% if (asset.ips.length > 1) { %>
                            <span class="text-muted">(+<%= asset.ips.length - 1 %>)</span>
                            <% } %>
                        <% } else if (asset.ip_address) { %>
                            <code><%= asset.ip_address %></code>
                        <% } else { %>
                            <span class="text-muted">-</span>
                        <% } %>
                    </td>
                    <td style="font-size:11px; line-height:1.6;" id="registered-modules-<%= asset.id %>">
                        <% if (asset.registered_modules && asset.registered_modules.length > 0) { %>
                            <% var regGroup = {};
                               asset.registered_modules.forEach(function(m) {
                                 if (!regGroup[m.module_type]) regGroup[m.module_type] = 0;
                                 regGroup[m.module_type] += (m.count || 1);
                               });
                               var typeLabels = { cpu:'CPU', memory:'MEM', disk:'DISK', network:'NIC', raid:'RAID', gpu:'GPU', npu:'NPU' };
                            %>
                            <% Object.keys(regGroup).forEach(function(t) { %>
                                <span class="badge badge-secondary" style="font-size:10px; margin:1px;"><%= typeLabels[t] || t %> <%= regGroup[t] %></span>
                            <% }); %>
                        <% } else { %>
                            <span class="text-muted">-</span>
                        <% } %>
                    </td>
                    <td style="font-size:11px; line-height:1.6;" id="discovered-count-<%= asset.id %>">
                        <span class="text-muted">-</span>
                    </td>
                    <td style="text-align:center;" id="match-status-<%= asset.id %>">
                        <% if (asset.children && asset.children.length > 0) { %>
                        <span class="badge badge-secondary" title="샤시 — 하위 노드 참조" style="opacity:0.6;">&#x1F4E6; 샤시</span>
                        <% } else { %>
                        <span class="badge badge-secondary" title="대기">&#x23F3; 대기</span>
                        <% } %>
                    </td>
                    <td>
                        <% if (asset.children && asset.children.length > 0) { %>
                        <span class="text-muted" style="font-size:11px;">하위 노드 스캔</span>
                        <% } else { %>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline" onclick="scanAsset(<%= asset.id %>)" id="scan-btn-<%= asset.id %>" title="스캔">&#x1F50D;</button>
                            <button class="btn btn-sm btn-outline" onclick="showDetail(<%= asset.id %>)" id="detail-btn-<%= asset.id %>" title="상세" style="display:none;">&#x1F4CB;</button>
                        </div>
                        <% } %>
                    </td>
                </tr>
                <tr id="asset-detail-<%= asset.id %>" data-category="<%= _cat %>" style="display:none;">
                    <td colspan="10" style="padding:0;">
                        <div id="asset-detail-content-<%= asset.id %>" style="padding:16px; background:var(--bg-secondary, #f8f9fa);"></div>
                    </td>
                </tr>
                <% if (asset.children && asset.children.length > 0) { %>
                <% asset.children.forEach(function(child) { %>
                <% var _childCat = _cat; %>
                <tr id="asset-row-<%= child.id %>" data-asset-id="<%= child.id %>" data-category="<%= _childCat %>" data-parent-id="<%= asset.id %>">
                    <td><input type="checkbox" class="asset-check" value="<%= child.id %>"></td>
                    <td style="padding-left:28px;">
                        <span style="color:var(--text-secondary); margin-right:4px;">&#x2514;</span>
                        <a href="/assets/<%= child.id %>" target="_blank" style="font-weight:600;">
                            <%= child.management_number || child.asset_number || 'ID:' + child.id %>
                        </a>
                        <% if (child.blade_slot) { %>
                        <span class="badge badge-secondary" style="font-size:9px; margin-left:4px;">슬롯 <%= child.blade_slot %></span>
                        <% } %>
                    </td>
                    <td style="font-size:12px;"><%= child.asset_number || '-' %></td>
                    <td><%= child.model_name || '-' %></td>
                    <td style="font-size:12px;"><span class="text-muted">&#x2514; <%= asset.management_number || '' %></span></td>
                    <td style="font-size:12px;">
                        <% if (child.ips && child.ips.length > 0) { %>
                            <% var childMgmtIp = child.ips.find(function(i) { return i.ip_type === 'management'; }) || child.ips.find(function(i) { return i.ip_type === 'os'; }) || child.ips.find(function(i) { return i.ip_type !== 'bmc'; }) || child.ips[0]; %>
                            <code><%= childMgmtIp.ip_address %></code>
                            <% if (child.ips.length > 1) { %>
                            <span class="text-muted">(+<%= child.ips.length - 1 %>)</span>
                            <% } %>
                        <% } else { %>
                            <span class="text-muted">-</span>
                        <% } %>
                    </td>
                    <td style="font-size:11px; line-height:1.6;" id="registered-modules-<%= child.id %>">
                        <% if (child.registered_modules && child.registered_modules.length > 0) { %>
                            <% var childRegGroup = {};
                               child.registered_modules.forEach(function(m) {
                                 if (!childRegGroup[m.module_type]) childRegGroup[m.module_type] = 0;
                                 childRegGroup[m.module_type] += (m.count || 1);
                               });
                               var typeLabels2 = { cpu:'CPU', memory:'MEM', disk:'DISK', network:'NIC', raid:'RAID', gpu:'GPU', npu:'NPU' };
                            %>
                            <% Object.keys(childRegGroup).forEach(function(t) { %>
                                <span class="badge badge-secondary" style="font-size:10px; margin:1px;"><%= typeLabels2[t] || t %> <%= childRegGroup[t] %></span>
                            <% }); %>
                        <% } else { %>
                            <span class="text-muted">-</span>
                        <% } %>
                    </td>
                    <td style="font-size:11px; line-height:1.6;" id="discovered-count-<%= child.id %>">
                        <span class="text-muted">-</span>
                    </td>
                    <td style="text-align:center;" id="match-status-<%= child.id %>">
                        <span class="badge badge-secondary" title="대기">&#x23F3; 대기</span>
                    </td>
                    <td>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline" onclick="scanAsset(<%= child.id %>)" id="scan-btn-<%= child.id %>" title="스캔">&#x1F50D;</button>
                            <button class="btn btn-sm btn-outline" onclick="showDetail(<%= child.id %>)" id="detail-btn-<%= child.id %>" title="상세">&#x1F4CB;</button>
                        </div>
                    </td>
                </tr>
                <tr id="asset-detail-<%= child.id %>" data-category="<%= _childCat %>" style="display:none;">
                    <td colspan="10" style="padding:0;">
                        <div id="asset-detail-content-<%= child.id %>" style="padding:16px; background:var(--bg-secondary, #f8f9fa);"></div>
                    </td>
                </tr>
                <% }); %>
                <% } %>
                <% }); %>
                <% } else { %>
                <tr>
                    <td colspan="10" style="text-align:center; padding:40px; color:var(--text-secondary);">
                        서버실에 등록된 자산이 없습니다.
                    </td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Manual Scan Section (collapsed by default) -->
<div id="manualScanSection" style="display:none;">
    <div class="card">
        <div class="card-header">
            <h2>수동 스캔</h2>
            <button class="btn btn-sm btn-outline" onclick="toggleManualScan()">닫기</button>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>스캔 방식</label>
                <select id="scanMode" class="form-control" onchange="toggleScanMode()">
                    <option value="single">단일 IP</option>
                    <option value="range">IP 범위</option>
                </select>
            </div>
        </div>

        <div id="singleIpFields">
            <div class="form-row">
                <div class="form-group">
                    <label>IP 주소 *</label>
                    <input type="text" id="scanIp" class="form-control" placeholder="10.20.1.100" onblur="lookupIp(this.value)">
                </div>
            </div>
            <div id="ipMatchResult" style="display:none; margin-bottom:16px;"></div>
        </div>

        <div id="rangeIpFields" style="display:none">
            <div class="form-row">
                <div class="form-group">
                    <label>시작 IP *</label>
                    <input type="text" id="startIp" class="form-control" placeholder="10.20.1.1">
                </div>
                <div class="form-group">
                    <label>끝 IP *</label>
                    <input type="text" id="endIp" class="form-control" placeholder="10.20.1.254">
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>사용자</label>
                <input type="text" id="sshUser" class="form-control" value="root" placeholder="root">
            </div>
            <div class="form-group">
                <label>비밀번호</label>
                <input type="password" id="sshPassword" class="form-control" placeholder="기본: qwe123">
            </div>
            <div class="form-group">
                <label>포트</label>
                <input type="number" id="sshPort" class="form-control" value="22">
            </div>
        </div>

        <div class="btn-group mt-2">
            <button class="btn btn-primary" onclick="startManualScan()" id="manualScanBtn">스캔 시작</button>
        </div>
    </div>

    <div id="manualScanProgress" class="card" style="display:none">
        <div class="card-header"><h2>스캔 진행</h2></div>
        <div class="progress-bar" style="height:12px; margin-bottom:12px;">
            <div class="progress-fill" id="manualProgressFill" style="width:0%; background:var(--primary);"></div>
        </div>
        <p id="manualProgressText" class="text-muted">준비중...</p>
    </div>

    <div id="manualScanResults" style="display:none">
        <div class="card">
            <div class="card-header">
                <h2>스캔 결과</h2>
                <%# B-9: 레거시 [모두 자산에 반영] 제거(POST /discovery/apply 중지 — 재고 미반영 경로). 반영은 자산 매칭에서. %>
                <span class="text-muted" style="font-size:12px;">조회 전용 — 반영은 각 자산의 자산 매칭(스캔 → 적용)에서</span>
            </div>
            <div id="manualResultsList"></div>
        </div>
    </div>
</div>

<script src="/js/discovery-core.js"></script>
<script>
// ── State (page) ──  (단일장비 흐름·scanResults는 discovery-core.js로 이동)
var manualScanResultsData = [];
var currentCategory = 'all';


// ── Category Filter ──
function filterCategory(cat) {
    currentCategory = cat;
    // Update button states
    var btns = document.querySelectorAll('.category-btn');
    for (var i = 0; i < btns.length; i++) {
        if (btns[i].getAttribute('data-category') === cat) {
            btns[i].classList.add('btn-primary');
            btns[i].classList.remove('btn-outline');
        } else {
            btns[i].classList.remove('btn-primary');
            btns[i].classList.add('btn-outline');
        }
    }

    // Filter rows
    var rows = document.querySelectorAll('tr[data-category]');
    var visibleCount = 0;
    for (var i = 0; i < rows.length; i++) {
        var rowCat = rows[i].getAttribute('data-category');
        var isDetailRow = rows[i].id && rows[i].id.indexOf('asset-detail-') === 0;
        if (cat === 'all' || rowCat === cat) {
            if (!isDetailRow) {
                rows[i].style.display = '';
                visibleCount++;
            }
            // detail rows keep their own display state (toggled by showDetail)
            // but if hidden by filter, force hide
        } else {
            rows[i].style.display = 'none';
        }
    }

    // Update count
    var totalAssets = document.querySelectorAll('tr[data-asset-id]').length;
    var countEl = document.getElementById('assetCount');
    if (cat === 'all') {
        countEl.innerHTML = '총 <strong>' + totalAssets + '</strong>개 자산';
    } else {
        countEl.innerHTML = '총 <strong>' + totalAssets + '</strong>개 중 <strong>' + visibleCount + '</strong>개 표시';
    }

    // Uncheck select-all
    document.getElementById('selectAll').checked = false;
}

// ── Select All (visible only) ──
function toggleSelectAll(cb) {
    var rows = document.querySelectorAll('tr[data-asset-id]');
    for (var i = 0; i < rows.length; i++) {
        if (rows[i].style.display === 'none') continue;
        var check = rows[i].querySelector('.asset-check');
        if (check) check.checked = cb.checked;
    }
}

// ── Toggle Manual Scan ──
function toggleManualScan() {
    var sec = document.getElementById('manualScanSection');
    sec.style.display = sec.style.display === 'none' ? '' : 'none';
}

function toggleScanMode() {
    var mode = document.getElementById('scanMode').value;
    document.getElementById('singleIpFields').style.display = mode === 'single' ? '' : 'none';
    document.getElementById('rangeIpFields').style.display = mode === 'range' ? '' : 'none';
}

// ── Scan Selected Assets ──
function scanSelectedAssets() {
    var checks = document.querySelectorAll('.asset-check:checked');
    if (checks.length === 0) {
        alert('스캔할 자산을 선택하세요.');
        return;
    }
    var assetIds = [];
    for (var i = 0; i < checks.length; i++) {
        assetIds.push(parseInt(checks[i].value));
    }
    runBatchScan(assetIds, '선택 스캔');
}

// ── Scan All Assets (client-side sequential) ──
var scanAllRunning = false;
var scanAllCancelled = false;

function scanAllAssets() {
    var rows = document.querySelectorAll('tr[data-asset-id]');
    var assetIds = [];
    for (var i = 0; i < rows.length; i++) {
        // Only scan visible (filtered) assets
        if (rows[i].style.display === 'none') continue;
        // Skip chassis (parent with child nodes)
        if (rows[i].getAttribute('data-is-chassis') === 'true') continue;
        assetIds.push(parseInt(rows[i].getAttribute('data-asset-id')));
    }
    if (assetIds.length === 0) {
        alert('스캔할 자산이 없습니다.');
        return;
    }
    runBatchScan(assetIds, '전체 스캔');
}

function runBatchScan(assetIds, label) {
    var btn = document.getElementById('scanAllBtn');

    // If already running, cancel
    if (scanAllRunning) {
        scanAllCancelled = true;
        btn.textContent = '중지 중...';
        return;
    }

    scanAllRunning = true;
    scanAllCancelled = false;
    btn.textContent = '스캔 중지';

    var progressDiv = document.getElementById('scanAllProgress');
    var progressText = document.getElementById('scanAllProgressText');
    var progressCount = document.getElementById('scanAllProgressCount');
    var progressFill = document.getElementById('scanAllProgressFill');
    var summaryDiv = document.getElementById('scanAllSummary');
    progressDiv.style.display = '';
    progressFill.style.width = '0%';
    progressText.textContent = label + ' 시작...';
    progressCount.textContent = '0/' + assetIds.length;
    if (summaryDiv) { summaryDiv.style.display = 'none'; summaryDiv.innerHTML = ''; }

    var total = assetIds.length;
    var completed = 0;
    var successCount = 0;
    var matchCount = 0;
    var mismatchCount = 0;
    var authFailCount = 0;
    var unreachableCount = 0;
    var errorCount = 0;

    function updateSummary() {
        if (!summaryDiv) return;
        var parts = [];
        if (successCount > 0) parts.push('<span class="badge badge-success">성공 ' + successCount + '</span>');
        if (matchCount > 0) parts.push('<span class="badge badge-success">일치 ' + matchCount + '</span>');
        if (mismatchCount > 0) parts.push('<span class="badge badge-warning">불일치 ' + mismatchCount + '</span>');
        if (authFailCount > 0) parts.push('<span class="badge badge-danger">인증실패 ' + authFailCount + '</span>');
        if (unreachableCount > 0) parts.push('<span class="badge badge-danger">접속불가 ' + unreachableCount + '</span>');
        if (errorCount > 0) parts.push('<span class="badge badge-secondary">오류 ' + errorCount + '</span>');
        summaryDiv.innerHTML = parts.join('');
        summaryDiv.style.display = parts.length > 0 ? 'flex' : 'none';
    }

    function scanNext(idx) {
        if (idx >= total || scanAllCancelled) {
            scanAllRunning = false;
            scanAllCancelled = false;
            btn.disabled = false;
            btn.textContent = '전체 스캔';
            progressFill.style.width = '100%';
            if (idx >= total) {
                progressText.textContent = label + ' 완료! ' + total + '개 자산';
            } else {
                progressText.textContent = label + ' 중지됨. 완료: ' + completed + '/' + total;
            }
            updateSummary();
            return;
        }

        var assetId = assetIds[idx];
        var assetRow = document.getElementById('asset-row-' + assetId);
        var assetLabel = assetRow ? (assetRow.querySelector('a') ? assetRow.querySelector('a').textContent.trim() : 'ID:' + assetId) : 'ID:' + assetId;
        progressText.textContent = '스캔 중: ' + assetLabel + ' (' + (idx + 1) + '/' + total + ')';

        // Set scanning status on row
        var statusCell = document.getElementById('match-status-' + assetId);
        if (statusCell) statusCell.innerHTML = '<span class="badge badge-info">&#x1F50D; 스캔중</span>';

        fetch('/discovery/scan-asset', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ asset_id: assetId })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            scanResults[assetId] = data;
            updateAssetRow(data);
            completed++;
            if (data.status === 'success') {
                successCount++;
                if (data.comparison) {
                    var comp = data.comparison;
                    if (comp.mismatched.length === 0 && comp.missing.length === 0 && comp.extra.length === 0) matchCount++;
                    else mismatchCount++;
                }
            }
            else if (data.status === 'auth_failed') authFailCount++;
            else if (data.status === 'unreachable') unreachableCount++;
            else errorCount++;

            var pct = Math.round((completed / total) * 100);
            progressFill.style.width = pct + '%';
            progressCount.textContent = completed + '/' + total;
            updateSummary();

            // Show detail button
            if (data.status === 'success') {
                var detailBtn = document.getElementById('detail-btn-' + assetId);
                if (detailBtn) detailBtn.style.display = '';
            }

            scanNext(idx + 1);
        })
        .catch(function(err) {
            completed++;
            errorCount++;
            var pct = Math.round((completed / total) * 100);
            progressFill.style.width = pct + '%';
            progressCount.textContent = completed + '/' + total;
            updateSummary();
            if (statusCell) statusCell.innerHTML = '<span class="badge badge-danger">&#x274C; 오류</span>';
            scanNext(idx + 1);
        });
    }

    scanNext(0);
}

function updateAssetRow(data) {
    var statusCell = document.getElementById('match-status-' + data.asset_id);
    var discoveredCell = document.getElementById('discovered-count-' + data.asset_id);

    if (!statusCell || !discoveredCell) return;

    if (data.status === 'success') {
        discoveredCell.innerHTML = moduleSummaryHtml(data.discovered_modules);

        // Use client-side comparison for status (consistent with detail panel)
        if (data.registered_modules && data.discovered_modules) {
            var rows = buildUnifiedRows(data);
            var hasMismatch = false;
            var statusParts = [];
            var mm = 0, ms = 0, ex = 0;
            rows.forEach(function(r) {
                if (r.status === 'mismatched') mm++;
                else if (r.status === 'missing') ms++;
                else if (r.status === 'extra') ex++;
            });
            if (mm > 0) { hasMismatch = true; statusParts.push('불일치 ' + mm); }
            if (ms > 0) { hasMismatch = true; statusParts.push('누락 ' + ms); }
            if (ex > 0) { hasMismatch = true; statusParts.push('미등록 ' + ex); }
            if (hasMismatch) {
                statusCell.innerHTML = '<span class="badge badge-warning" title="' + statusParts.join(', ') + '">&#x26A0;&#xFE0F; 불일치</span>';
            } else {
                statusCell.innerHTML = '<span class="badge badge-success" title="일치">&#x2705; 일치</span>';
            }
        } else {
            statusCell.innerHTML = '<span class="badge badge-success">&#x2705; 완료</span>';
        }

        document.getElementById('detail-btn-' + data.asset_id).style.display = '';
    } else if (data.status === 'auth_failed') {
        discoveredCell.innerHTML = '<span class="text-muted">-</span>';
        statusCell.innerHTML = '<span class="badge badge-danger">&#x274C; 인증실패</span>';
    } else if (data.status === 'unreachable') {
        discoveredCell.innerHTML = '<span class="text-muted">-</span>';
        statusCell.innerHTML = '<span class="badge badge-danger">&#x274C; 접속불가</span>';
    } else {
        discoveredCell.innerHTML = '<span class="text-muted">-</span>';
        statusCell.innerHTML = '<span class="badge badge-danger">&#x274C; 오류</span>';
    }
}

// ══════════════════════════════════════════════════════
//  MANUAL SCAN (legacy, kept for backward compatibility)
// ══════════════════════════════════════════════════════

function lookupIp(ip) {
    if (!ip || !ip.trim()) {
        document.getElementById('ipMatchResult').style.display = 'none';
        return;
    }
    fetch('/discovery/lookup-ip?ip=' + encodeURIComponent(ip.trim()))
    .then(function(r) { return r.json(); })
    .then(function(data) {
        var container = document.getElementById('ipMatchResult');
        if (!data.results || data.results.length === 0) {
            container.innerHTML = '<div class="alert" style="background:var(--surface-warn-strong); border:1px solid var(--line-warn); padding:8px 12px; border-radius:6px; font-size:13px;">등록된 자산 없음 - 이 IP에 매칭되는 자산이 없습니다.</div>';
            container.style.display = '';
            return;
        }
        var html = '<div style="background:var(--surface-success-strong); border:1px solid var(--line-success); padding:12px; border-radius:6px;">';
        html += '<strong style="color:#155724;">매칭된 자산 정보</strong>';
        data.results.forEach(function(r) {
            html += '<div style="margin-top:8px; padding:8px; background:var(--bg-white); border-radius:4px;">';
            html += '<span class="badge badge-success">등록됨</span> ';
            html += '<strong>' + escapeHtml(r.asset_number || '') + '</strong> ';
            html += escapeHtml(r.model_name || '') + ' (' + escapeHtml(r.manufacturer || '') + ')';
            html += ' <a href="/assets/' + r.asset_id + '" target="_blank" style="font-size:12px;">[상세]</a>';
            if (r.credentials && r.credentials.length > 0) {
                html += '<div style="margin-top:6px; font-size:13px;">';
                html += '<strong>등록된 자격증명:</strong>';
                html += '<table style="margin-top:4px; font-size:12px; width:100%;"><thead><tr><th>유형</th><th>사용자</th><th>비밀번호</th><th></th></tr></thead><tbody>';
                r.credentials.forEach(function(c) {
                    // BL-11: 비밀번호 원문은 서버가 응답에 싣지 않음(has_password 플래그만). 화면은 등록 여부만 표시.
                    html += '<tr>';
                    html += '<td><span class="badge badge-info">' + escapeHtml(c.credential_type) + '</span></td>';
                    html += '<td>' + escapeHtml(c.username) + '</td>';
                    html += '<td>' + (c.has_password ? '<code>●●●●●●</code> <span style="color:#94a3b8;font-size:11px;">등록됨</span>' : '<span style="color:#94a3b8;">-</span>') + '</td>';
                    html += '<td><button class="btn btn-sm btn-outline" onclick="useCredential(\'' + escapeHtml(c.username) + '\')">사용자명 채우기</button></td>';
                    html += '</tr>';
                });
                html += '</tbody></table></div>';
            }
            html += '</div>';
        });
        html += '</div>';
        container.innerHTML = html;
        container.style.display = '';
    })
    .catch(function(err) { console.error('IP lookup error:', err); });
}

function useCredential(username) {
    // BL-11: 비밀번호는 서버가 응답에 싣지 않으므로 사용자명만 채운다.
    // 비밀번호는 직접 입력하거나, 자산에 등록된 자격증명은 자산 단위 스캔에서 서버측이 사용.
    document.getElementById('sshUser').value = username;
    document.getElementById('sshPassword').value = '';
    document.getElementById('sshPassword').focus();
}

function startManualScan() {
    var mode = document.getElementById('scanMode').value;
    var user = document.getElementById('sshUser').value;
    var password = document.getElementById('sshPassword').value;
    var port = document.getElementById('sshPort').value;

    document.getElementById('manualScanBtn').disabled = true;
    document.getElementById('manualScanBtn').textContent = '스캔 중...';
    document.getElementById('manualScanProgress').style.display = '';
    document.getElementById('manualScanResults').style.display = 'none';
    document.getElementById('manualProgressFill').style.width = '0%';
    document.getElementById('manualProgressText').textContent = '스캔 시작...';

    var url, body;

    if (mode === 'single') {
        var ip = document.getElementById('scanIp').value;
        if (!ip) { alert('IP 주소를 입력하세요.'); resetManualScanBtn(); return; }
        url = '/discovery/scan';
        body = { ip: ip, user: user, password: password, port: port };
    } else {
        var startIp = document.getElementById('startIp').value;
        var endIp = document.getElementById('endIp').value;
        if (!startIp || !endIp) { alert('IP 범위를 입력하세요.'); resetManualScanBtn(); return; }
        url = '/discovery/scan-range';
        body = { start_ip: startIp, end_ip: endIp, user: user, password: password, port: port };
    }

    fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        var results = Array.isArray(data) ? data : [data];
        manualScanResultsData = results;
        document.getElementById('manualProgressFill').style.width = '100%';
        document.getElementById('manualProgressText').textContent = '완료! ' + results.length + '개 호스트 스캔됨';

        // B-9: 단일·범위 모두 IP 매칭 조회(읽기) — 결과마다 자산 매칭 링크 표시용
        {
            var lookupPromises = results.map(function(r) {
                return fetch('/discovery/lookup-ip?ip=' + encodeURIComponent(r.ip))
                    .then(function(resp) { return resp.json(); })
                    .then(function(d) { r._matchInfo = d.results || []; })
                    .catch(function() { r._matchInfo = []; });
            });
            Promise.all(lookupPromises).then(function() {
                renderManualResults(results);
                resetManualScanBtn();
            });
        }
    })
    .catch(function(err) {
        document.getElementById('manualProgressText').textContent = '오류: ' + err.message;
        resetManualScanBtn();
    });
}

function resetManualScanBtn() {
    document.getElementById('manualScanBtn').disabled = false;
    document.getElementById('manualScanBtn').textContent = '스캔 시작';
}

function renderManualResults(results) {
    document.getElementById('manualScanResults').style.display = '';
    var html = '';

    results.forEach(function(r, idx) {
        var statusBadge = '';
        if (r.status === 'success') statusBadge = '<span class="badge badge-success">성공</span>';
        else if (r.status === 'auth_failed') statusBadge = '<span class="badge badge-warning">인증 실패</span>';
        else if (r.status === 'unreachable') statusBadge = '<span class="badge badge-danger">접속 불가</span>';
        else statusBadge = '<span class="badge badge-secondary">' + r.status + '</span>';

        var matchBadge = '';
        if (r._matchInfo && r._matchInfo.length > 0) {
            matchBadge = ' <span class="badge badge-info">등록됨</span>';
        } else if (r._matchInfo) {
            matchBadge = ' <span class="badge badge-secondary">미등록</span>';
        }

        html += '<div style="padding:16px; border-bottom:1px solid var(--border);">';
        html += '<div class="d-flex justify-between align-center mb-1">';
        html += '<strong>' + escapeHtml(r.ip) + '</strong> ' + statusBadge + matchBadge;
        html += '</div>';
        // B-9: [자산에 반영] 대신 매칭된 자산의 자산 매칭 링크(같은 화면 목록 행으로 이동·강조, 스캔은 사용자가 실행)
        if (r._matchInfo && r._matchInfo.length > 0) {
            html += '<div class="mb-1" style="font-size:13px;">';
            r._matchInfo.forEach(function(mi) {
                var aid = parseInt(mi.asset_id, 10);
                if (!aid) return;
                html += '<a class="btn btn-sm btn-outline" style="margin-right:6px;" href="/discovery?asset=' + aid + '#asset-row-' + aid + '">자산 매칭에서 보기: ' + escapeHtml(mi.asset_number || mi.management_number || ('#' + aid)) + '</a>';
            });
            html += '</div>';
        } else if (r.status === 'success') {
            html += '<p class="text-muted" style="font-size:12px;">등록된 자산과 매칭되지 않았습니다 — 자산 등록 후 자산 매칭에서 반영하세요.</p>';
        }
        if (r.status === 'success') html += scanDiagnosticsHtml(r);   // B-9: 도구 없음·권한 없음 안내

        if (r.hostname) html += '<p>호스트명: ' + escapeHtml(r.hostname) + '</p>';
        if (r.totalMemory) html += '<p>총 메모리: ' + escapeHtml(r.totalMemory) + '</p>';

        if (r.modules && r.modules.length > 0) {
            html += '<table style="margin-top:8px;"><thead><tr><th>유형</th><th>모델</th><th>용량</th><th>수량</th><th>사양</th></tr></thead><tbody>';
            r.modules.forEach(function(m) {
                html += '<tr><td>' + escapeHtml(m.module_type) + '</td><td>' + escapeHtml(m.model || '-') + '</td><td>' + escapeHtml(m.capacity || '-') + '</td><td>' + (m.count || 1) + '</td><td>' + escapeHtml(m.specification || '-') + '</td></tr>';
            });
            html += '</tbody></table>';
        }

        if (r.error) html += '<p class="text-muted" style="font-size:12px;">오류: ' + escapeHtml(r.error) + '</p>';
        html += '</div>';
    });

    document.getElementById('manualResultsList').innerHTML = html;
}

// B-9: applyManualResult / applyAllManualResults 제거 — POST /discovery/apply는 410(재고 미반영 경로 중지).

// B-9: /discovery?asset=<id> 진입 시 해당 자산 행으로 이동·강조(자동 스캔 없음)
(function () {
    var m = /[?&]asset=(\d+)/.exec(window.location.search);
    if (!m) return;
    var row = document.getElementById('asset-row-' + m[1]);
    if (!row) return;
    if (typeof filterCategory === 'function') filterCategory('all');
    row.classList.add('disc-focus');
    row.style.outline = '2px solid var(--primary)';
    row.style.outlineOffset = '-2px';
    try { row.scrollIntoView({ block: 'center' }); } catch (e) {}
})();
</script>

