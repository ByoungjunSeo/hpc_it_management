                    html += '</tr>';
                });

                html += '</tbody></table></div>';
                html += '<p class="text-muted mt-1">사용중: ' + data.usage.length + '건</p>';
                html += '<p class="text-muted" style="font-size:12px;">반납/이동 이력은 <a href="#" onclick="switchModalTab(\'history\'); return false;">이력</a> 탭에서 확인하세요.</p>';
                modalBody.innerHTML = html;
            })
            .catch(function(err) {
                modalBody.innerHTML = '<p style="color:red;">오류: ' + err.message + '</p>';
            });
    });
});

// === Inventory tab inline editing ===
(function() {
    var cells = document.querySelectorAll('.inv-editable');
    cells.forEach(function(cell) {
        cell.addEventListener('click', function() {
            if (cell.classList.contains('editing')) return;
            startInvEdit(cell);
        });
    });

    function startInvEdit(cell) {
        var invId = cell.getAttribute('data-inv-id');
        var field = cell.getAttribute('data-field');
        var currentValue = cell.textContent.trim();
        if (currentValue === '-') currentValue = '';

        cell.classList.add('editing');
        var input = document.createElement('input');
        input.type = 'text';
        input.className = 'inline-edit-input';
        input.value = currentValue;
        cell.textContent = '';
        cell.appendChild(input);
        input.focus();
        input.select();

        function save() {
            var newValue = input.value.trim();
            if (newValue === currentValue) { cancel(); return; }
            cell.classList.add('inline-edit-saving');

            fetch('/module-inventory/api/inventory/' + invId + '/inline-update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ field: field, value: newValue })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                cell.classList.remove('editing', 'inline-edit-saving');
                if (data.success) {
                    cell.textContent = newValue || '-';
                    if (data.syncCount > 0) {
                        var msg = document.createElement('span');
                        msg.style.cssText = 'position:absolute; top:-18px; right:0; font-size:11px; color:var(--success,#16a34a); white-space:nowrap; animation:fadeOut 2s forwards;';
                        msg.textContent = data.syncCount + '건 동기화';
                        cell.style.position = 'relative';
                        cell.appendChild(msg);
                        setTimeout(function() { if (msg.parentNode) msg.remove(); }, 2500);
                    }
                } else {
                    cell.textContent = currentValue || '-';
                    alert('수정 실패: ' + (data.error || '알 수 없는 오류'));
                }
            })
            .catch(function(err) {
                cell.classList.remove('editing', 'inline-edit-saving');
                cell.textContent = currentValue || '-';
                alert('수정 오류: ' + err.message);
            });
        }

        function cancel() {
            cell.classList.remove('editing');
            cell.textContent = currentValue || '-';
        }

        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); save(); }
            else if (e.key === 'Escape') { e.preventDefault(); cancel(); }
            else if (e.key === 'Tab') {
                e.preventDefault(); save();
                var nextCell = cell.nextElementSibling;
                while (nextCell && !nextCell.classList.contains('inv-editable')) {
                    nextCell = nextCell.nextElementSibling;
                }
                if (nextCell) setTimeout(function() { nextCell.click(); }, 50);
            }
        });

        input.addEventListener('blur', function() {
            setTimeout(function() {
                if (cell.classList.contains('editing') && !cell.classList.contains('inline-edit-saving')) save();
            }, 100);
        });
    }
})();

// === Storage quantity inline editing ===
(function() {
    document.querySelectorAll('.storage-editable').forEach(function(cell) {
        cell.addEventListener('click', function() {
            if (cell.classList.contains('editing')) return;
            var invId = cell.getAttribute('data-inv-id');
            var currentVal = parseInt(cell.textContent.trim()) || 0;
            cell.classList.add('editing');
            var input = document.createElement('input');
            input.type = 'number';
            input.min = '0';
            input.value = currentVal;
            input.className = 'inline-edit-input';
            input.style.width = '70px';
            input.style.textAlign = 'right';
            cell.textContent = '';
            cell.appendChild(input);
            input.focus();
            input.select();

            function save() {
                var newVal = parseInt(input.value);
                if (isNaN(newVal) || newVal < 0 || newVal === currentVal) { cell.classList.remove('editing'); cell.textContent = currentVal; return; }
                cell.classList.add('inline-edit-saving');
                fetch('/module-inventory/api/inventory/' + invId + '/update-storage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ storage_quantity: newVal })
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    cell.classList.remove('editing', 'inline-edit-saving');
                    if (data.success) {
                        cell.textContent = data.storage_quantity;
                        var row = cell.parentElement;
                        var tds = row.querySelectorAll('td');
                        for (var i = 0; i < tds.length; i++) {
                            if (tds[i] === cell) {
                                if (i > 0 && tds[i-1].querySelector('strong')) tds[i-1].querySelector('strong').textContent = data.total_quantity;
                                if (i+1 < tds.length) tds[i+1].textContent = data.in_use_quantity;
                                if (i+2 < tds.length && tds[i+2].querySelector('strong')) tds[i+2].querySelector('strong').textContent = data.spare_quantity;
                                break;
                            }
                        }
                    } else {
                        cell.textContent = currentVal;
                        alert(data.error || '수정 실패');
                    }
                })
                .catch(function() { cell.classList.remove('editing', 'inline-edit-saving'); cell.textContent = currentVal; alert('서버 오류'); });
            }
            input.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
                if (e.key === 'Escape') { cell.classList.remove('editing'); cell.textContent = currentVal; }
            });
            input.addEventListener('blur', function() { setTimeout(function() { if (cell.classList.contains('editing')) save(); }, 100); });
        });
    });
})();
</script>

