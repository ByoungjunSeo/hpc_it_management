<script>
var _transferModuleId = null;
var _transferAssetsLoaded = false;

function openTransferModal(btn) {
    _transferModuleId = btn.dataset.moduleId;
    var label = btn.dataset.moduleLabel;
    var from = btn.dataset.from;
    document.getElementById('transferTitle').textContent = '모듈 이동';
    document.getElementById('transferInfo').textContent = label + ' (' + from + ' 에서 이동)';
    document.getElementById('transferReason').value = '';
    document.getElementById('transferResult').textContent = '';
    openModal('transferModal');

    if (!_transferAssetsLoaded) {
        fetch('/module-inventory/api/assets')
            .then(function(r) { return r.json(); })
            .then(function(assets) {
                var sel = document.getElementById('transferTarget');
                sel.innerHTML = '<option value="">선택</option>';
                assets.forEach(function(a) {
                    var opt = document.createElement('option');
                    opt.value = a.id;
                    opt.textContent = a.label;
                    sel.appendChild(opt);
                });
                _transferAssetsLoaded = true;
            });
    }
}

function submitTransfer() {
    var toAssetId = document.getElementById('transferTarget').value;
    if (!toAssetId) { alert('이동 대상 서버를 선택해주세요.'); return; }
    var resultEl = document.getElementById('transferResult');
    resultEl.textContent = '처리 중...';
    resultEl.style.color = '#3b82f6';

    fetch('/module-inventory/modules/' + _transferModuleId + '/transfer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            to_asset_id: toAssetId,
            reason: document.getElementById('transferReason').value.trim() || null
        })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            resultEl.style.color = '#22c55e';
            resultEl.textContent = '완료: ' + data.from + ' → ' + data.to;
            setTimeout(function() { location.reload(); }, 800);
        } else {
            resultEl.style.color = '#ef4444';
            resultEl.textContent = '실패: ' + (data.error || '');
        }
    })
    .catch(function(err) {
        resultEl.style.color = '#ef4444';
        resultEl.textContent = '오류: ' + err.message;
    });
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeModal('transferModal');
});

(function() {
    var cells = document.querySelectorAll('.editable-cell');
    cells.forEach(function(cell) {
        cell.addEventListener('click', function() {
            if (cell.classList.contains('editing')) return;
            startInlineEdit(cell);
        });
    });

    function startInlineEdit(cell) {
        var moduleId = cell.getAttribute('data-module-id');
        var field = cell.getAttribute('data-field');
        var currentValue = cell.textContent.trim();
        if (currentValue === '-') currentValue = '';

        cell.classList.add('editing');
        var input = document.createElement('input');
        input.type = 'text';
        input.className = 'inline-edit-input';
        input.value = currentValue;
        cell.textContent = '';
        cell.appendChild(input);
        input.focus();
        input.select();

        function save() {
            var newValue = input.value.trim();
            if (newValue === currentValue) {
                cancel();
                return;
            }
            cell.classList.add('inline-edit-saving');

            fetch('/module-inventory/modules/' + moduleId + '/inline-update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ field: field, value: newValue })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                cell.classList.remove('editing', 'inline-edit-saving');
                if (data.success) {
                    cell.textContent = newValue || '-';
                } else {
                    cell.textContent = currentValue || '-';
                    alert('수정 실패: ' + (data.error || '알 수 없는 오류'));
                }
            })
            .catch(function(err) {
                cell.classList.remove('editing', 'inline-edit-saving');
                cell.textContent = currentValue || '-';
                alert('수정 오류: ' + err.message);
            });
        }

        function cancel() {
            cell.classList.remove('editing');
            cell.textContent = currentValue || '-';
        }

        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                save();
            } else if (e.key === 'Escape') {
                e.preventDefault();
                cancel();
            } else if (e.key === 'Tab') {
                e.preventDefault();
                save();
                var nextCell = cell.nextElementSibling;
                while (nextCell && !nextCell.classList.contains('editable-cell')) {
                    nextCell = nextCell.nextElementSibling;
                }
                if (nextCell) {
                    setTimeout(function() { nextCell.click(); }, 50);
                }
            }
        });

        input.addEventListener('blur', function() {
            setTimeout(function() {
                if (cell.classList.contains('editing') && !cell.classList.contains('inline-edit-saving')) {
                    save();
                }
            }, 100);
        });
    }
})();
</script>

<% } else if (activeTab === 'history') { %>
<!-- ===== Tab 3: 입출고 이력 ===== -->
<%
  var hEventLabels = { incoming: '입고', outgoing: '출고', installed: '설치', removed: '제거', transfer: '이동', adjust: '조정' };
  var hEventColors = { incoming: 'success', outgoing: 'warning', installed: 'info', removed: 'danger', transfer: 'secondary', adjust: 'secondary' };
%>

<div class="card" style="padding:12px 16px;">
    <form class="filters" method="GET" action="/module-inventory" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap; margin:0;">
        <input type="hidden" name="tab" value="history">
        <div class="form-group" style="margin:0;">
            <label>유형</label>
            <select name="event_type" class="form-control" onchange="this.form.submit()">
                <option value="">전체</option>
                <option value="incoming" <%= historyFilters.event_type === 'incoming' ? 'selected' : '' %>>입고</option>
                <option value="outgoing" <%= historyFilters.event_type === 'outgoing' ? 'selected' : '' %>>출고</option>
                <option value="installed" <%= historyFilters.event_type === 'installed' ? 'selected' : '' %>>설치</option>
                <option value="removed" <%= historyFilters.event_type === 'removed' ? 'selected' : '' %>>제거</option>
                <option value="adjust" <%= historyFilters.event_type === 'adjust' ? 'selected' : '' %>>조정</option>
            </select>
        </div>
        <div class="form-group" style="margin:0;">
            <label>부품코드</label>
            <select name="item_code" class="form-control" onchange="this.form.submit()">
                <option value="">전체</option>
                <% allItemCodes.forEach(function(code) { %>
                <option value="<%= code %>" <%= historyFilters.item_code === code ? 'selected' : '' %>><%= code %></option>
                <% }) %>
            </select>
        </div>
        <div class="form-group" style="margin:0;">
            <label>시작일</label>
            <input type="date" name="date_from" class="form-control" value="<%= historyFilters.date_from || '' %>">
        </div>
        <div class="form-group" style="margin:0;">
            <label>종료일</label>
            <input type="date" name="date_to" class="form-control" value="<%= historyFilters.date_to || '' %>">
        </div>
        <div class="form-group" style="margin:0;">
            <label>검색</label>
            <input type="text" name="hist_search" class="form-control" placeholder="서버, 코드, 비고..." value="<%= historyFilters.search || '' %>">
        </div>
        <div class="form-group" style="margin:0;">
            <button type="submit" class="btn btn-primary">검색</button>
            <a href="/module-inventory?tab=history" class="btn btn-secondary">초기화</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>일시</th>
                    <th>유형</th>
                    <th>부품코드</th>
                    <th>수량변동</th>
                    <th>총수량</th>
                    <th>여유</th>
                    <th>서버</th>
                    <th>자산번호</th>
                    <th>사용자</th>
                    <th>비고</th>
                </tr>
            </thead>
            <tbody>
                <% if (historyLogs.length === 0) { %>
                <tr><td colspan="10" class="text-center text-muted">이력이 없습니다.</td></tr>
                <% } %>
                <% historyLogs.forEach(function(log) { %>
                <%
                    var dt = log.created_at ? log.created_at.replace('T', ' ').substring(0, 16) : '-';
                    var evLabel = hEventLabels[log.event_type] || log.event_type;
                    var evColor = hEventColors[log.event_type] || 'secondary';
                    var qtyStr = log.quantity_change > 0 ? '+' + log.quantity_change : (log.quantity_change || '-');
                    var assetInfo = log.asset_label || log.to_asset_label || log.from_asset_label || '-';
                    if (log.from_asset_label && log.to_asset_label) {
                        assetInfo = log.from_asset_label + ' → ' + log.to_asset_label;
                    }
                %>
                <tr>
                    <td style="font-size:12px; white-space:nowrap;"><%= dt %></td>
                    <td><span class="badge badge-<%= evColor %>"><%= evLabel %></span></td>
                    <td><code style="font-weight:bold;"><%= log.item_code %></code></td>
                    <td style="font-weight:bold; color:<%= log.quantity_change > 0 ? 'var(--success, #22c55e)' : 'var(--danger, #ef4444)' %>;"><%= qtyStr %></td>
                    <td><%= log.after_total != null ? log.after_total : '-' %></td>
                    <td><%= log.after_spare != null ? log.after_spare : '-' %></td>
                    <td><%= assetInfo %></td>
                    <td><%= log.asset_number || '-' %></td>
                    <td><%= log.username || '-' %></td>
                    <td style="font-size:12px; max-width:200px; overflow:hidden; text-overflow:ellipsis;"><%= log.notes || '-' %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <p class="text-muted mt-1">총 <%= historyLogs.length %>건</p>
</div>

<% } %>

<%- include('../partials/footer', { extraJs }) %>
