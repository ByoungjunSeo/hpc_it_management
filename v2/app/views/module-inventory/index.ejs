.mi-table .mi-sticky { position: sticky; left: 0; z-index: 1; background: inherit; }
.mi-table thead th.mi-sticky { z-index: 3; background: var(--bg); }
.mi-table td, .mi-table th { overflow: hidden; }
.mi-ellip { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mi-mfm .mi-mf { font-size: 12px; color: var(--text-light); }
.mi-mfm .mi-md { font-weight: 600; }
.mi-num { text-align: right; font-variant-numeric: tabular-nums; }
.mi-group-head td { background: var(--bg); font-size: 13px; padding: 6px 10px; cursor: pointer; }
.mi-group-toggle { border:none; background:none; cursor:pointer; padding:0 6px 0 0; font-size:13px; color:inherit; }
.mi-group-head.collapsed .mi-group-toggle { transform: rotate(-90deg); }
.mi-group-meta { margin-left: 8px; font-size: 12px; color: var(--text-light); }
.mi-menu { position: fixed; z-index: 1100; min-width: 130px; background: var(--bg-white); border: 1px solid var(--border); border-radius: 6px; box-shadow: var(--shadow); padding: 4px 0; display: flex; flex-direction: column; }
.mi-menu[hidden] { display: none; }
.mi-menu-item { border: none; background: none; text-align: left; padding: 7px 14px; cursor: pointer; font-size: 13px; color: var(--text); }
.mi-menu-item:hover, .mi-menu-item:focus { background: var(--bg); outline: none; }
</style>
<script>
// ===== B-7: 부품 재고 탭 — 유형 칩·검색·여유분·업체 그룹 접기(localStorage)·[⋯] 메뉴 =====
(function(){
    var rows = Array.prototype.slice.call(document.querySelectorAll('.mi-table tr.mi-row'));
    var chipsEl = document.getElementById('miChips');
    if (!chipsEl) return;
    var searchEl = document.getElementById('miSearch'), spareEl = document.getElementById('miSpareOnly');
    var state = { type: chipsEl.getAttribute('data-initial') || '', q: '', spare: !!(spareEl && spareEl.checked) };
    var LS_KEY = 'mi.vendor.collapsed';
    var collapsed = {};
    try { collapsed = JSON.parse(localStorage.getItem(LS_KEY) || '{}') || {}; } catch (e) { collapsed = {}; }
    function saveCollapsed() { try { localStorage.setItem(LS_KEY, JSON.stringify(collapsed)); } catch (e) {} }
    function baseMatch(r) {   // 칩 외 조건(검색·여유분)
        if (state.spare && r.getAttribute('data-spare') !== '1') return false;
        if (state.q && (r.getAttribute('data-search') || '').indexOf(state.q) === -1) return false;
        return true;
    }
    function apply() {
        // 칩 개수 = 검색·여유분 반영 후 유형별 건수(현재 소유 탭 범위)
        var counts = { '': 0 };
        rows.forEach(function(r){ if (!baseMatch(r)) return; var t = r.getAttribute('data-type'); counts[t] = (counts[t] || 0) + 1; counts['']++; });
        chipsEl.querySelectorAll('.mi-chip').forEach(function(c){
            var t = c.getAttribute('data-type'), n = counts[t] || 0;
            c.querySelector('.mi-chip-n').textContent = n;
            c.classList.toggle('active', t === state.type);
            c.disabled = (t !== '' && n === 0 && t !== state.type);
        });
        var shown = 0, groupStat = {};
        rows.forEach(function(r){
            var ok = baseMatch(r) && (!state.type || r.getAttribute('data-type') === state.type);
            var v = r.getAttribute('data-vendor');
            if (ok && v) { var g = groupStat[v] = groupStat[v] || { n: 0, q: 0 }; g.n++; g.q += Number(r.getAttribute('data-qty')) || 0; }
            if (ok) shown++;
            r.hidden = !ok || !!(v && collapsed[v]);
        });
        document.querySelectorAll('.mi-table tr.mi-group-head').forEach(function(h){
            var v = h.getAttribute('data-vendor'), g = groupStat[v];
            h.hidden = !g;
            h.classList.toggle('collapsed', !!collapsed[v]);
            var b = h.querySelector('.mi-group-toggle'); if (b) b.setAttribute('aria-expanded', collapsed[v] ? 'false' : 'true');
            if (g) h.querySelector('.mi-group-meta').textContent = g.n + '품목 · ' + g.q + '개';
        });
        var empty = document.querySelector('.mi-table tr.mi-empty-filter');
        if (empty) empty.hidden = !(rows.length && shown === 0);
        var s = document.getElementById('miShown'); if (s) s.textContent = shown;
    }
    chipsEl.addEventListener('click', function(e){
        var c = e.target.closest('.mi-chip'); if (!c || c.disabled) return;
        state.type = c.getAttribute('data-type'); apply();
    });
    if (searchEl) searchEl.addEventListener('input', function(){ state.q = searchEl.value.trim().toLowerCase(); apply(); });
    if (spareEl) spareEl.addEventListener('change', function(){ state.spare = spareEl.checked; apply(); });
    document.querySelectorAll('.mi-table tr.mi-group-head').forEach(function(h){
        h.addEventListener('click', function(){
            var v = h.getAttribute('data-vendor');
            if (collapsed[v]) delete collapsed[v]; else collapsed[v] = true;
            saveCollapsed(); apply();
        });
    });
    apply();

    // [⋯] 메뉴: 항목은 기존 행 버튼과 같은 함수·같은 data-*(inv-id/code/total)로 호출 → 요청 동일
    var menu = document.getElementById('miRowMenu'), cur = null;
    function closeMenu() { if (menu) menu.hidden = true; cur = null; }
    window.miCloseRowMenu = closeMenu;
    document.querySelectorAll('.mi-more').forEach(function(b){
        b.addEventListener('click', function(e){
            e.stopPropagation();
            if (cur === b) { closeMenu(); return; }
            cur = b;
            menu.querySelectorAll('.mi-menu-item').forEach(function(it){
                it.dataset.invId = b.dataset.invId; it.dataset.code = b.dataset.code; it.dataset.total = b.dataset.total;
                if (it.getAttribute('data-act') === 'return') it.hidden = b.dataset.canReturn !== '1';
            });
            menu.hidden = false;
            var rc = b.getBoundingClientRect(), mw = menu.offsetWidth || 130, mh = menu.offsetHeight || 100;
            var left = Math.max(8, Math.min(rc.right - mw, window.innerWidth - mw - 8));
            var top = (rc.bottom + mh + 8 > window.innerHeight) ? Math.max(8, rc.top - mh - 4) : rc.bottom + 4;
            menu.style.left = left + 'px'; menu.style.top = top + 'px';
            var first = menu.querySelector('.mi-menu-item:not([hidden])'); if (first) first.focus();
        });
    });
    if (menu) menu.addEventListener('click', function(e){
        var it = e.target.closest('.mi-menu-item'); if (!it) return;
        var act = it.getAttribute('data-act');
        closeMenu();
        if (act === 'adjust') openAdjustModal(it);
        else if (act === 'return') returnVendor(it);
        else if (act === 'photo') openModulePhotoModal(parseInt(it.dataset.invId, 10), it.dataset.code || '');
    });
    document.addEventListener('click', function(e){ if (menu && !menu.hidden && !menu.contains(e.target)) closeMenu(); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && menu && !menu.hidden) closeMenu(); });
    var sc = document.querySelector('.mi-card .mi-scroll');
    if (sc) sc.addEventListener('scroll', closeMenu, { passive: true });
    window.addEventListener('scroll', closeMenu, { passive: true });
    window.addEventListener('resize', closeMenu);
})();
</script>
