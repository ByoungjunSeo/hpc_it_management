<%- include('../partials/header', { title, currentPath, extraCss }) %>

<div class="page-header">
    <h1>부품 현황</h1>
</div>

<%
  const typeLabels = { cpu: 'CPU', memory: '메모리', disk: '디스크/스토리지', network: 'NIC', raid: 'RAID', gpu: 'GPU', cable: '케이블' };
  const activeTab = tab || 'inventory';
%>

<!-- Tabs -->
<div class="tabs" style="display:flex; gap:0; margin-bottom:20px; border-bottom:2px solid var(--border, #ddd);">
    <a href="/module-inventory?tab=inventory<%= selectedType ? '&type=' + selectedType : '' %><%= selectedOwner ? '&inv_owner=' + selectedOwner : '' %>"
       class="tab-link<%= activeTab === 'inventory' ? ' active' : '' %>" style="padding:10px 24px; font-weight:<%= activeTab === 'inventory' ? 'bold' : 'normal' %>; border-bottom:<%= activeTab === 'inventory' ? '2px solid var(--primary, #2563eb)' : '2px solid transparent' %>; margin-bottom:-2px; text-decoration:none; color:<%= activeTab === 'inventory' ? 'var(--primary, #2563eb)' : 'var(--text-secondary, #666)' %>;">
        부품 재고
    </a>
    <a href="/module-inventory?tab=installed<%= filters.module_type ? '&module_type=' + filters.module_type : '' %><%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>"
       class="tab-link<%= activeTab === 'installed' ? ' active' : '' %>" style="padding:10px 24px; font-weight:<%= activeTab === 'installed' ? 'bold' : 'normal' %>; border-bottom:<%= activeTab === 'installed' ? '2px solid var(--primary, #2563eb)' : '2px solid transparent' %>; margin-bottom:-2px; text-decoration:none; color:<%= activeTab === 'installed' ? 'var(--primary, #2563eb)' : 'var(--text-secondary, #666)' %>;">
        설치 현황
    </a>
    <a href="/module-inventory?tab=history"
       class="tab-link<%= activeTab === 'history' ? ' active' : '' %>" style="padding:10px 24px; font-weight:<%= activeTab === 'history' ? 'bold' : 'normal' %>; border-bottom:<%= activeTab === 'history' ? '2px solid var(--primary, #2563eb)' : '2px solid transparent' %>; margin-bottom:-2px; text-decoration:none; color:<%= activeTab === 'history' ? 'var(--primary, #2563eb)' : 'var(--text-secondary, #666)' %>;">
        입출고 이력
    </a>
</div>

<%# BUG-3 수정(B-4d-9): 모달 CSS가 inventory 탭 분기 안에만 있어 installed 탭의
    transferModal이 스타일 없이 인라인으로 풀림 → 탭 공통 위치로 이동 %>
<style>
.modal-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.5); z-index: 1000;
    display: none; align-items: center; justify-content: center;
}
.modal-overlay.active {
    display: flex;
}
.modal-content {
    background: var(--bg, #fff); border-radius: 8px; padding: 24px;
    max-width: 900px; width: 90%; max-height: 80vh; overflow-y: auto;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
}
.modal-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border, #ddd);
}
.modal-header h3 { margin: 0; }
.modal-close {
    background: none; border: none; font-size: 28px; cursor: pointer;
    color: var(--text-light, #999); padding: 4px 8px; line-height: 1;
}
.modal-close:hover { color: var(--danger, #e00); }
</style>

<% if (activeTab === 'inventory') { %>
<!-- ===== Tab 1: 부품 재고 ===== -->

<div class="stats-grid">
    <% statsByType.forEach(s => { %>
    <div class="stat-card">
        <div class="stat-value"><%= s.total || 0 %></div>
        <div class="stat-label"><%= typeLabels[s.module_type] || s.module_type %> (총)</div>
        <%# B-T1.5: tui-fallback=테마 없을 때 원본 표기, tui-stat-gauge=테마 있을 때만
            표시(hidden 해제)되는 세그먼트 게이지. 테마 <link> 제거 시 자동 원복 %>
        <div class="mt-1 tui-fallback" style="font-size:13px;">
            <span style="color:#6b7280;">장비실: <%= s.storage || 0 %></span> /
            <span style="color:var(--primary);">사용: <%= s.in_use || 0 %></span> /
            <span style="color:var(--success);">여유: <%= s.spare || 0 %></span>
        </div>
        <div class="tui-stat-gauge" hidden>
            <%
              const gTotal = s.total || 0;
              const gUsed = s.in_use || 0;
              const gPct = gTotal > 0 ? Math.round(gUsed / gTotal * 100) : 0;
              const gLvl = gPct >= 90 ? 'crit' : gPct >= 70 ? 'warn' : '';
            %>
            <div class="tui-gauge-track"><div class="tui-gauge-fill <%= gLvl %>" style="width:<%= gPct %>%"></div></div>
            <div class="tui-stat-gauge-nums">장비실 <%= s.storage || 0 %> · 사용 <%= gUsed %> · 여유 <%= s.spare || 0 %></div>
        </div>
    </div>
    <% }) %>
</div>

<div class="card">
    <form class="filters" method="GET" action="/module-inventory" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
        <input type="hidden" name="tab" value="inventory">
        <div class="form-group" style="margin:0;">
            <label>유형 필터</label>
            <select name="type" class="form-control" onchange="this.form.submit()">
                <option value="">전체</option>
                <% appConfig.moduleTypes.forEach(m => { %>
                <option value="<%= m.value %>" <%= selectedType === m.value ? 'selected' : '' %>><%= m.label %></option>
                <% }) %>
            </select>
        </div>
        <div class="form-group" style="margin:0;">
            <label>소유 구분</label>
            <select name="inv_owner" class="form-control" onchange="this.form.submit()">
                <option value="">전체</option>
                <option value="company" <%= selectedOwner === 'company' ? 'selected' : '' %>>자사</option>
                <option value="vendor" <%= selectedOwner === 'vendor' ? 'selected' : '' %>>업체</option>
            </select>
        </div>
        <div class="form-group" style="margin:0;">
            <label>업체명</label>
            <select name="inv_vendor_id" class="form-control" onchange="this.form.submit()">
                <option value="">전체</option>
                <% vendors.forEach(v => { %>
                <option value="<%= v.id %>" <%= selectedVendorId === String(v.id) ? 'selected' : '' %>><%= v.vendor_name %></option>
                <% }) %>
            </select>
        </div>
        <div class="form-group" style="display:flex; align-items:center; gap:6px; margin:0; padding-bottom:4px;">
            <input type="checkbox" name="spare_only" value="1" id="spareOnlyChk" <%= spareOnly ? 'checked' : '' %> onchange="this.form.submit()">
            <label for="spareOnlyChk" style="margin:0; cursor:pointer;">여유분만 보기</label>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>유형</th>
                    <th>소유</th>
                    <th>코드</th>
                    <th>자산번호</th>
                    <th>제조사</th>
                    <th>모델</th>
                    <th>용량/사양</th>
                    <th>스펙</th>
                    <th>총수량</th>
                    <th>장비실</th>
                    <th>사용중</th>
                    <th>여유</th>
                    <th>입출고</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% if (items.length === 0) { %>
                <tr><td colspan="14" class="text-center text-muted">부품 데이터가 없습니다.</td></tr>
                <% } %>
                <% items.forEach(item => { %>
                <tr class="<%= item.spare_quantity > 0 ? '' : 'text-muted' %>" style="<%= item.spare_quantity > 0 ? 'background:#f0fdf4;' : '' %>">
                    <td><span class="badge badge-secondary"><%= typeLabels[item.module_type] || item.module_type %></span></td>
                    <td>
                        <% if (item.owner === 'vendor') { %>
                            <span class="badge badge-warning"><%= (vendors.find(v => v.id === item.owner_vendor_id) || {}).vendor_name || '업체' %></span>
                        <% } else { %>
                            <span class="badge badge-success">자사</span>
                        <% } %>
                    </td>
                    <td style="white-space:nowrap;">
                        <a href="#" class="comp-code-link" data-code="<%= item.item_code %>" style="font-weight:bold; cursor:pointer;">
                            <code><%= item.item_code || '-' %></code>
                        </a>
                    </td>
                    <td class="editable-cell inv-editable" data-inv-id="<%= item.id %>" data-field="asset_number" title="클릭하여 수정"><%= item.asset_number || '-' %></td>
                    <td class="editable-cell inv-editable" data-inv-id="<%= item.id %>" data-field="manufacturer" title="클릭하여 수정"><%= item.manufacturer || '-' %></td>
                    <td class="editable-cell inv-editable" data-inv-id="<%= item.id %>" data-field="model" title="클릭하여 수정"><%= item.model || '-' %></td>
                    <td class="editable-cell inv-editable" data-inv-id="<%= item.id %>" data-field="capacity" title="클릭하여 수정"><%= item.capacity || '-' %></td>
                    <td class="editable-cell inv-editable" data-inv-id="<%= item.id %>" data-field="specification" title="클릭하여 수정" style="font-size:12px;"><%= item.specification || '-' %></td>
                    <td><strong><%= item.total_quantity %></strong></td>
                    <td class="storage-editable" data-inv-id="<%= item.id %>" data-code="<%= item.item_code %>" style="cursor:pointer;" title="클릭하여 수정"><%= item.storage_quantity || 0 %></td>
                    <td><%= item.in_use_quantity %></td>
                    <td><strong style="color: <%= item.spare_quantity > 0 ? 'var(--success)' : 'var(--text-light)' %>"><%= item.spare_quantity %></strong></td>
                    <td>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline adjust-btn" data-inv-id="<%= item.id %>" data-code="<%= item.item_code %>" data-total="<%= item.total_quantity %>" onclick="openAdjustModal(this)">+/-</button>
                            <% if (item.owner === 'vendor' && item.total_quantity > 0) { %>
                            <button class="btn btn-sm btn-warning return-vendor-btn" data-inv-id="<%= item.id %>" data-code="<%= item.item_code %>" data-total="<%= item.total_quantity %>" onclick="returnVendor(this)">반납</button>
                            <% } %>
                        </div>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline" onclick="openModulePhotoModal(<%= item.id %>, '<%= (item.item_code || '').replace(/'/g, "\\'") %>')" title="사진">&#128247;</button>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <p class="text-muted mt-1">총 <%= items.length %>종</p>
</div>

<!-- Adjust Quantity Modal -->
<div id="adjustModal" class="modal-overlay">
    <div class="modal-content" style="max-width:480px;">
        <div class="modal-header">
            <h3 id="adjustTitle">수량 조정</h3>
            <button class="modal-close" onclick="closeModal('adjustModal')">&times;</button>
        </div>
        <div style="margin-bottom:16px;">
            <div style="display:flex; gap:8px; margin-bottom:12px;">
                <button type="button" class="btn btn-sm" id="adjTypeIncoming" onclick="setAdjustType('incoming')" style="flex:1; background:#22c55e; color:white;">입고 (+)</button>
                <button type="button" class="btn btn-sm" id="adjTypeOutgoing" onclick="setAdjustType('outgoing')" style="flex:1; background:#94a3b8; color:white;">출고 (-)</button>
            </div>
            <div class="form-group" style="margin-bottom:10px;">
                <label>수량</label>
                <input type="number" id="adjQuantity" class="form-control" min="1" value="1" style="font-size:18px; text-align:center;">
            </div>
            <div class="form-group" style="margin-bottom:10px;">
                <label>자산번호 (선택)</label>
                <input type="text" id="adjAssetNumber" class="form-control" placeholder="입고 시 자산번호">
            </div>
            <div class="form-group" style="margin-bottom:10px;">
                <label>비고</label>
                <input type="text" id="adjNotes" class="form-control" placeholder="사유, 메모">
            </div>
            <div id="adjResult" style="font-size:13px; min-height:20px; margin-bottom:8px;"></div>
            <button type="button" class="btn btn-primary" onclick="submitAdjust()" style="width:100%;">적용</button>
        </div>
    </div>
</div>

<!-- Usage Detail Modal -->
<div id="usageModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="modalTitle">부품 상세</h3>
            <button class="modal-close" onclick="closeModal('usageModal')">&times;</button>
        </div>
        <div id="modalSpec" style="margin-bottom:12px;"></div>
        <!-- Modal Tabs -->
        <div class="modal-tabs" style="display:flex; gap:0; margin-bottom:16px; border-bottom:2px solid var(--border, #ddd);">
            <button type="button" class="modal-tab active" data-tab="usage" onclick="switchModalTab('usage')" style="padding:8px 20px; border:none; background:none; cursor:pointer; font-weight:bold; border-bottom:2px solid var(--primary, #2563eb); margin-bottom:-2px; color:var(--primary, #2563eb);">사용 현황</button>
            <button type="button" class="modal-tab" data-tab="history" onclick="switchModalTab('history')" style="padding:8px 20px; border:none; background:none; cursor:pointer; font-weight:normal; border-bottom:2px solid transparent; margin-bottom:-2px; color:var(--text-secondary, #666);">이력</button>
        </div>
        <div id="modalBody">
            <p class="text-muted">로딩 중...</p>
        </div>
        <div id="modalHistoryBody" style="display:none;">
            <p class="text-muted">로딩 중...</p>
        </div>
    </div>
</div>

<!-- Module Photo Modal -->
<div id="modulePhotoModal" class="modal-overlay">
    <div class="modal-content" style="max-width:700px;">
        <div class="modal-header">
            <h3 id="modulePhotoTitle">부품 사진</h3>
            <div style="display:flex; gap:8px; align-items:center;">
                <label class="btn btn-sm btn-primary" style="margin:0; cursor:pointer;">
                    + 사진 추가
                    <input type="file" multiple accept="image/*" style="display:none;" onchange="handleModulePhotoUpload(this)">
                </label>
                <button class="modal-close" onclick="closeModal('modulePhotoModal')">&times;</button>
            </div>
        </div>
        <div id="modulePhotoGallery" style="min-height:60px;">
            <p class="text-muted">로딩 중...</p>
        </div>
    </div>
</div>

<!-- Module Photo Lightbox -->
<div id="modulePhotoLightbox" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:10000; cursor:pointer; align-items:center; justify-content:center;" onclick="closeModulePhotoLightbox()">
    <button onclick="closeModulePhotoLightbox()" style="position:absolute; top:20px; right:20px; background:none; border:none; color:white; font-size:32px; cursor:pointer; z-index:10001;">&times;</button>
    <img id="moduleLbImg" src="" alt="" style="max-width:90vw; max-height:90vh; object-fit:contain; border-radius:8px;">
    <div id="moduleLbCaption" style="position:absolute; bottom:20px; left:50%; transform:translateX(-50%); color:white; font-size:14px; background:rgba(0,0,0,0.5); padding:6px 16px; border-radius:4px;"></div>
</div>

<script>
var _modulePhotoId = null;
var _modulePhotoCode = '';

function openModulePhotoModal(invId, code) {
  _modulePhotoId = invId;
  _modulePhotoCode = code;
  document.getElementById('modulePhotoTitle').textContent = code + ' 사진';
  document.getElementById('modulePhotoGallery').innerHTML = '<p class="text-muted">로딩 중...</p>';
  openModal('modulePhotoModal');
  loadModulePhotos(invId);
}

function loadModulePhotos(invId) {
  fetch('/api/photos/module/' + invId)
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var gallery = document.getElementById('modulePhotoGallery');
      if (!data.success || !data.photos || data.photos.length === 0) {
        gallery.innerHTML = '<p class="text-muted">등록된 사진이 없습니다.</p>';
        return;
      }
      gallery.innerHTML = '';
      var lastDate = '';
      var groupDiv = null;
      data.photos.forEach(function(photo) {
        var photoDate = (photo.uploaded_at || '').substring(0, 10);
        if (photoDate !== lastDate) {
          lastDate = photoDate;
          var header = document.createElement('div');
          header.style.cssText = 'font-size:12px; font-weight:600; color:#475569; margin-top:' + (groupDiv ? '10px' : '0') + '; margin-bottom:6px; padding:4px 0; border-bottom:1px solid #e2e8f0;';
          header.textContent = photoDate || '날짜 없음';
          gallery.appendChild(header);
          groupDiv = document.createElement('div');
          groupDiv.style.cssText = 'display:flex; flex-wrap:wrap; gap:8px; margin-bottom:4px;';
          gallery.appendChild(groupDiv);
        }
        var div = document.createElement('div');
        div.style.cssText = 'position:relative; width:160px;';
        div.setAttribute('data-photo-id', photo.id);
        var safeName = (photo.original_name || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
        var timeStr = (photo.uploaded_at || '').substring(11, 16);
        var byStr = photo.uploaded_by ? photo.uploaded_by + ' &middot; ' : '';
        div.innerHTML =
          '<img src="' + photo.file_path + '" alt="' + safeName + '"' +
          ' style="width:160px; height:120px; object-fit:cover; border-radius:6px; cursor:pointer; border:1px solid #e2e8f0;"' +
          ' onclick="openModulePhotoLightbox(\'' + photo.file_path + '\', \'' + safeName + '\')">' +
          '<div style="font-size:11px; color:#64748b; margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">' + (photo.original_name || '') + '</div>' +
          '<div style="font-size:10px; color:#94a3b8;">' + byStr + timeStr + '</div>' +
          '<button onclick="deleteModulePhoto(' + photo.id + ')"' +
          ' style="position:absolute; top:4px; right:4px; background:rgba(0,0,0,0.6); color:white; border:none; border-radius:50%; width:24px; height:24px; cursor:pointer; font-size:14px; line-height:1; display:flex; align-items:center; justify-content:center;"' +
          ' title="삭제">&times;</button>';
        groupDiv.appendChild(div);
      });
    })
    .catch(function(err) {
      document.getElementById('modulePhotoGallery').innerHTML = '<p style="color:red;">오류: ' + err.message + '</p>';
    });
}

function handleModulePhotoUpload(input) {
  if (!input.files || input.files.length === 0 || !_modulePhotoId) return;
  var formData = new FormData();
  for (var i = 0; i < input.files.length; i++) {
    formData.append('photos', input.files[i]);
  }
  var gallery = document.getElementById('modulePhotoGallery');
  var emptyMsg = gallery.querySelector('.text-muted');
  if (emptyMsg) emptyMsg.textContent = '업로드 중...';

  fetch('/api/photos/module/' + _modulePhotoId, { method: 'POST', body: formData })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        loadModulePhotos(_modulePhotoId);
      } else {
        alert('업로드 실패: ' + (data.error || ''));
      }
    })
    .catch(function(err) { alert('업로드 오류: ' + err.message); });
  input.value = '';
}

function deleteModulePhoto(photoId) {
  if (!confirm('이 사진을 삭제하시겠습니까?')) return;
  fetch('/api/photos/' + photoId, { method: 'DELETE' })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        loadModulePhotos(_modulePhotoId);
      } else {
        alert('삭제 실패: ' + (data.error || ''));
      }
    })
    .catch(function(err) { alert('삭제 오류: ' + err.message); });
}

function openModulePhotoLightbox(src, caption) {
  var lb = document.getElementById('modulePhotoLightbox');
  document.getElementById('moduleLbImg').src = src;
  document.getElementById('moduleLbCaption').textContent = caption || '';
  lb.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function closeModulePhotoLightbox() {
  var lb = document.getElementById('modulePhotoLightbox');
  if (lb) {
    lb.style.display = 'none';
    document.body.style.overflow = '';
  }
}
</script>

<style>
<%# 모달 CSS는 BUG-3 수정으로 탭 공통 블록(파일 상단)으로 이동 %>
.spec-info { display: flex; gap: 16px; flex-wrap: wrap; font-size: 13px; color: var(--text-light); }
.spec-info span { background: var(--bg-alt, #f5f5f5); padding: 2px 8px; border-radius: 4px; }
</style>

<script>
var currentModalCode = '';
var _adjInvId = null;
var _adjType = 'incoming';

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { closeModal('usageModal'); closeModal('adjustModal'); closeModal('modulePhotoModal'); closeModulePhotoLightbox(); }
});

function setAdjustType(type) {
    _adjType = type;
    var inc = document.getElementById('adjTypeIncoming');
    var out = document.getElementById('adjTypeOutgoing');
    if (type === 'incoming') {
        inc.style.background = '#22c55e'; out.style.background = '#94a3b8';
    } else {
        out.style.background = '#ef4444'; inc.style.background = '#94a3b8';
    }
}

function openAdjustModal(btn) {
    _adjInvId = btn.dataset.invId;
    var code = btn.dataset.code;
    var total = btn.dataset.total;
    document.getElementById('adjustTitle').textContent = code + ' 수량 조정 (현재: ' + total + '개)';
    document.getElementById('adjQuantity').value = 1;
    document.getElementById('adjAssetNumber').value = '';
    document.getElementById('adjNotes').value = '';
    document.getElementById('adjResult').textContent = '';
    setAdjustType('incoming');
    openModal('adjustModal');
}

function submitAdjust() {
    var qty = parseInt(document.getElementById('adjQuantity').value) || 0;
    if (qty <= 0) { alert('수량을 입력해주세요.'); return; }
    var change = _adjType === 'incoming' ? qty : -qty;
    var resultEl = document.getElementById('adjResult');
    resultEl.textContent = '처리 중...';
    resultEl.style.color = '#3b82f6';

    fetch('/module-inventory/api/inventory/' + _adjInvId + '/adjust', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            quantity_change: change,
            event_type: _adjType,
            asset_number: document.getElementById('adjAssetNumber').value.trim() || null,
            notes: document.getElementById('adjNotes').value.trim() || null
        })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            resultEl.style.color = '#22c55e';
            resultEl.textContent = '완료: ' + data.before_total + ' → ' + data.after_total + '개';
            setTimeout(function() { location.reload(); }, 800);
        } else {
            resultEl.style.color = '#ef4444';
            resultEl.textContent = '실패: ' + (data.error || '');
        }
    })
    .catch(function(err) {
        resultEl.style.color = '#ef4444';
        resultEl.textContent = '오류: ' + err.message;
    });
}

function returnVendor(btn) {
    var invId = btn.dataset.invId;
    var code = btn.dataset.code;
    var total = btn.dataset.total;
    if (!confirm(code + ' (업체 부품, ' + total + '개) 전량 반납 처리하시겠습니까?\n\n- 재고 수량이 0으로 변경됩니다.\n- 서버에 설치된 해당 업체 모듈이 삭제됩니다.')) return;

    fetch('/module-inventory/api/inventory/' + invId + '/return-vendor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            alert('반납 완료: ' + data.item_code + '\n삭제 모듈: ' + data.deleted_modules + '건\n영향 자산: ' + data.affected_assets + '건');
            location.reload();
        } else {
            alert('반납 실패: ' + (data.error || ''));
        }
    })
    .catch(function(err) {
        alert('오류: ' + err.message);
    });
}

function switchModalTab(tabName) {
    var tabs = document.querySelectorAll('.modal-tab');
    tabs.forEach(function(t) {
        var isActive = t.getAttribute('data-tab') === tabName;
        t.style.fontWeight = isActive ? 'bold' : 'normal';
        t.style.borderBottom = isActive ? '2px solid var(--primary, #2563eb)' : '2px solid transparent';
        t.style.color = isActive ? 'var(--primary, #2563eb)' : 'var(--text-secondary, #666)';
        if (isActive) t.classList.add('active'); else t.classList.remove('active');
    });
    document.getElementById('modalBody').style.display = tabName === 'usage' ? '' : 'none';
    document.getElementById('modalHistoryBody').style.display = tabName === 'history' ? '' : 'none';

    if (tabName === 'history' && currentModalCode) {
        loadHistory(currentModalCode);
    }
}

function loadHistory(code) {
    var histBody = document.getElementById('modalHistoryBody');
    histBody.innerHTML = '<p class="text-muted">로딩 중...</p>';

    fetch('/module-inventory/api/history/' + encodeURIComponent(code))
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (!data.logs || data.logs.length === 0) {
                histBody.innerHTML = '<p class="text-muted">이력이 없습니다.</p>';
                return;
            }

            var eventLabels = { incoming: '입고', outgoing: '출고', installed: '설치', removed: '제거', transfer: '이동', adjust: '조정' };
            var eventColors = { incoming: 'success', outgoing: 'warning', installed: 'info', removed: 'danger', transfer: 'secondary', adjust: 'secondary' };

            // Asset number summary from incoming logs
            var assetSummary = {};
            data.logs.forEach(function(log) {
                if (log.event_type === 'incoming' && log.asset_number) {
                    if (!assetSummary[log.asset_number]) assetSummary[log.asset_number] = 0;
                    assetSummary[log.asset_number] += (log.quantity_change || 0);
                }
            });

            var html = '';

            // Show asset number summary if any
            var assetKeys = Object.keys(assetSummary);
            if (assetKeys.length > 0) {
                html += '<div style="margin-bottom:12px; padding:8px 12px; background:var(--bg-alt, #f5f5f5); border-radius:6px;">';
                html += '<strong style="font-size:13px;">자산번호별 수량:</strong> ';
                assetKeys.forEach(function(an, i) {
                    if (i > 0) html += ', ';
                    html += '<span class="badge badge-info" style="margin:2px;">' + an + ': ' + assetSummary[an] + '개</span>';
                });
                html += '</div>';
            }

            html += '<div class="table-wrapper"><table><thead><tr>';
            html += '<th>일시</th><th>유형</th><th>수량변동</th><th>총수량</th><th>여유</th><th>서버</th><th>자산번호</th><th>사용자</th><th>비고</th>';
            html += '</tr></thead><tbody>';

            data.logs.forEach(function(log) {
                var dt = log.created_at ? log.created_at.replace('T', ' ').substring(0, 16) : '-';
                var evLabel = eventLabels[log.event_type] || log.event_type;
                var evColor = eventColors[log.event_type] || 'secondary';
                var qtyStr = log.quantity_change > 0 ? '+' + log.quantity_change : (log.quantity_change || '-');
                var assetInfo = log.asset_label || log.to_asset_label || log.from_asset_label || '-';
                if (log.from_asset_label && log.to_asset_label) {
                    assetInfo = log.from_asset_label + ' → ' + log.to_asset_label;
                }

                html += '<tr>';
                html += '<td style="font-size:12px; white-space:nowrap;">' + dt + '</td>';
                html += '<td><span class="badge badge-' + evColor + '">' + evLabel + '</span></td>';
                html += '<td style="font-weight:bold;">' + qtyStr + '</td>';
                html += '<td>' + (log.after_total != null ? log.after_total : '-') + '</td>';
                html += '<td>' + (log.after_spare != null ? log.after_spare : '-') + '</td>';
                html += '<td>' + assetInfo + '</td>';
                html += '<td>' + (log.asset_number || '-') + '</td>';
                html += '<td>' + (log.username || '-') + '</td>';
                html += '<td style="font-size:12px;">' + (log.notes || '-') + '</td>';
                html += '</tr>';
            });

            html += '</tbody></table></div>';
            html += '<p class="text-muted mt-1">총 ' + data.logs.length + '건</p>';
            histBody.innerHTML = html;
        })
        .catch(function(err) {
            histBody.innerHTML = '<p style="color:red;">오류: ' + err.message + '</p>';
        });
}

document.querySelectorAll('.comp-code-link').forEach(function(link) {
    link.addEventListener('click', function(e) {
