                <input type="text" id="transferReason" class="form-control" placeholder="이동 사유">
            </div>
            <div id="transferResult" style="font-size:13px; min-height:20px; margin-bottom:8px;"></div>
            <button type="button" class="btn btn-primary" onclick="submitTransfer()" style="width:100%;">이동</button>
        </div>
    </div>
