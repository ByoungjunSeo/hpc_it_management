<!-- Transfer Modal -->
<div id="transferModal" class="modal-overlay">
    <div class="modal-content" style="max-width:500px;">
        <div class="modal-header">
            <h3 id="transferTitle">모듈 이동</h3>
            <button class="modal-close" onclick="closeModal('transferModal')">&times;</button>
        </div>
        <div>
            <p id="transferInfo" style="font-size:13px; color:var(--text-secondary); margin-bottom:12px;"></p>
            <div class="form-group" style="margin-bottom:10px;">
                <label>이동 대상 서버 *</label>
                <select id="transferTarget" class="form-control">
                    <option value="">로딩 중...</option>
                </select>
            </div>
            <div class="form-group" style="margin-bottom:10px;">
                <label>사유 (선택)</label>
                <input type="text" id="transferReason" class="form-control" placeholder="이동 사유">
            </div>
            <div id="transferResult" style="font-size:13px; min-height:20px; margin-bottom:8px;"></div>
            <button type="button" class="btn btn-primary" onclick="submitTransfer()" style="width:100%;">이동</button>
        </div>
    </div>
</div>

<script>
var _transferModuleId = null;
var _transferAssetsLoaded = false;

function openTransferModal(btn) {
    _transferModuleId = btn.dataset.moduleId;
    var label = btn.dataset.moduleLabel;
    var from = btn.dataset.from;
    document.getElementById('transferTitle').textContent = '모듈 이동';
    document.getElementById('transferInfo').textContent = label + ' (' + from + ' 에서 이동)';
    document.getElementById('transferReason').value = '';
    document.getElementById('transferResult').textContent = '';
    openModal('transferModal');

    if (!_transferAssetsLoaded) {
        fetch('/module-inventory/api/assets')
            .then(function(r) { return r.json(); })
            .then(function(assets) {
                var sel = document.getElementById('transferTarget');
                sel.innerHTML = '<option value="">선택</option>';
                assets.forEach(function(a) {
                    var opt = document.createElement('option');
                    opt.value = a.id;
                    opt.textContent = a.label;
                    sel.appendChild(opt);
                });
                _transferAssetsLoaded = true;
            });
    }
}

function submitTransfer() {
    var toAssetId = document.getElementById('transferTarget').value;
    if (!toAssetId) { alert('이동 대상 서버를 선택해주세요.'); return; }
    var resultEl = document.getElementById('transferResult');
    resultEl.textContent = '처리 중...';
    resultEl.style.color = '#3b82f6';

    fetch('/module-inventory/modules/' + _transferModuleId + '/transfer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            to_asset_id: toAssetId,
            reason: document.getElementById('transferReason').value.trim() || null
        })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            resultEl.style.color = '#22c55e';
            resultEl.textContent = '완료: ' + data.from + ' → ' + data.to;
            setTimeout(function() { location.reload(); }, 800);
        } else {
            resultEl.style.color = '#ef4444';
            resultEl.textContent = '실패: ' + (data.error || '');
        }
    })
    .catch(function(err) {
        resultEl.style.color = '#ef4444';
        resultEl.textContent = '오류: ' + err.message;
    });
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeModal('transferModal');
});

(function() {
    var cells = document.querySelectorAll('.editable-cell');
    cells.forEach(function(cell) {
        cell.addEventListener('click', function() {
            if (cell.classList.contains('editing')) return;
            startInlineEdit(cell);
        });
    });

    function startInlineEdit(cell) {
        var moduleId = cell.getAttribute('data-module-id');
        var field = cell.getAttribute('data-field');
        var currentValue = cell.textContent.trim();
        if (currentValue === '-') currentValue = '';

        cell.classList.add('editing');
        var input = document.createElement('input');
        input.type = 'text';
        input.className = 'inline-edit-input';
        input.value = currentValue;
        cell.textContent = '';
        cell.appendChild(input);
        input.focus();
        input.select();

        function save() {
            var newValue = input.value.trim();
            if (newValue === currentValue) {
                cancel();
                return;
            }
            cell.classList.add('inline-edit-saving');

            fetch('/module-inventory/modules/' + moduleId + '/inline-update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ field: field, value: newValue })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                cell.classList.remove('editing', 'inline-edit-saving');
                if (data.success) {
                    cell.textContent = newValue || '-';
                } else {
                    cell.textContent = currentValue || '-';
                    alert('수정 실패: ' + (data.error || '알 수 없는 오류'));
                }
            })
            .catch(function(err) {
                cell.classList.remove('editing', 'inline-edit-saving');
                cell.textContent = currentValue || '-';
                alert('수정 오류: ' + err.message);
            });
        }

        function cancel() {
            cell.classList.remove('editing');
            cell.textContent = currentValue || '-';
        }

        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                save();
            } else if (e.key === 'Escape') {
                e.preventDefault();
                cancel();
            } else if (e.key === 'Tab') {
                e.preventDefault();
                save();
                var nextCell = cell.nextElementSibling;
                while (nextCell && !nextCell.classList.contains('editable-cell')) {
                    nextCell = nextCell.nextElementSibling;
                }
                if (nextCell) {
                    setTimeout(function() { nextCell.click(); }, 50);
                }
            }
        });

        input.addEventListener('blur', function() {
            setTimeout(function() {
                if (cell.classList.contains('editing') && !cell.classList.contains('inline-edit-saving')) {
                    save();
                }
            }, 100);
        });
    }
})();
</script>

