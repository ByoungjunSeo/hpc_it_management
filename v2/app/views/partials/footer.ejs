    </main>
    <footer class="footer">
        <p>HPC/AIDC IT Asset Management System</p>
    </footer>
    <script src="/js/main.js"></script>
    <script>
    (function() {
        var input = document.getElementById('globalSearch');
        var results = document.getElementById('globalSearchResults');
        if (!input || !results) return;
        var timer = null;
        var flat = [];      // 렌더 순서대로의 결과 객체(키보드 네비용)
        var selIdx = -1;    // B-4b 1-2: 하이라이트 항목 인덱스

        // B-4b 1-1: 결과 항목 본문 클릭 동작 — /rooms에서 locateUrl 있으면 이동 없이 강조, 그 외는 이동/상세.
        function activate(d) {
            if (!d) return;
            results.classList.remove('show');
            if (d.locateUrl && location.pathname.indexOf('/rooms') === 0 && typeof window.locateAsset === 'function') {
                window.locateAsset(d.id);           // 분할 패널 유지, 페이지 이동 없음
            } else if (d.locateUrl) {
                location.href = d.locateUrl;        // 다른 페이지 → /rooms?focus=id
            } else {
                location.href = d.url;              // 미배치 등 → 상세
            }
        }
        function setSel(i) {
            var items = results.querySelectorAll('.gsr-item');
            if (!items.length) return;
            if (i < 0) i = items.length - 1;
            if (i >= items.length) i = 0;
            selIdx = i;
            items.forEach(function(el, k){ el.classList.toggle('gsr-active', k === selIdx); });
            items[selIdx].scrollIntoView({ block: 'nearest' });
        }

        input.addEventListener('input', function() {
            clearTimeout(timer);
            var q = this.value.trim();
            if (q.length < 2) { results.classList.remove('show'); flat = []; selIdx = -1; return; }
            timer = setTimeout(function() {
                fetch('/api/search?q=' + encodeURIComponent(q))
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        flat = []; selIdx = -1;
                        if (data.length === 0) {
                            results.innerHTML = '<div class="gsr-empty">검색 결과가 없습니다.</div>';
                        } else {
                            var badgeMap = { asset: '장비', ip: 'IP', module: '모듈' };
                            function modSummary(d) {
                                if (!d.matchedModules || !d.matchedModules.lines || !d.matchedModules.lines.length) return '';
                                var parts = d.matchedModules.lines.map(function(m) {
                                    var own = (m.owner === 'vendor') ? ' <span class="gsr-mod-vendor">' + escH(m.owner_vendor_name || '업체') + '</span>' : '';
                                    return escH((m.module_type || '').toUpperCase() + ' ' + (m.model || m.capacity || '') + ' ×' + m.count) + own;
                                });
                                var extra = d.matchedModules.extra ? (' 외 ' + d.matchedModules.extra + '종') : '';
                                return '<div class="gsr-mod">' + parts.join(', ') + extra + '</div>';
                            }
                            function renderItem(d) {
                                var idx = flat.length; flat.push(d);
                                var badge = '<span class="gsr-badge ' + d.type + '">' + (badgeMap[d.type] || d.type) + '</span>';
                                var loc = d.location ? (' &middot; ' + escH(d.location)) : '';
                                var cur = d.currentLocation ? ('<div class="gsr-subtitle gsr-current">현재 위치: ' + escH(d.currentLocation) + '</div>') : '';
                                var actions = '<a class="gsr-link" href="' + escH(d.url) + '">상세</a>' +
                                    (d.locateUrl ? ('<a class="gsr-link gsr-locate" href="' + escH(d.locateUrl) + '">랙 위치</a>') : '');
                                return '<div class="gsr-item" data-idx="' + idx + '">' +
                                    '<div class="gsr-title">' + badge + escH(d.title) + '</div>' +
                                    '<div class="gsr-subtitle">' + escH(d.subtitle || '') + loc + '</div>' +
                                    cur + modSummary(d) +
                                    '<div class="gsr-actions">' + actions + '</div></div>';
                            }
                            function section(title, items) { return items.length ? ('<div class="gsr-section">' + escH(title) + '</div>' + items.map(renderItem).join('')) : ''; }
                            var gA = data.filter(function(d){return d.matchType==='asset';});
                            var gI = data.filter(function(d){return d.matchType==='ip';});
                            var gM = data.filter(function(d){return d.matchType==='module';});
                            results.innerHTML = section('장비', gA) + section('IP', gI) + section('모듈 장착 장비 (' + gM.length + ')', gM);
                            // 본문 클릭 → activate (액션 링크는 stopPropagation으로 독립 동작)
                            results.querySelectorAll('.gsr-item').forEach(function(el){
                                el.addEventListener('click', function(e){ if (e.target.closest('.gsr-link')) return; activate(flat[parseInt(el.dataset.idx, 10)]); });
                                el.addEventListener('mouseenter', function(){ setSel(parseInt(el.dataset.idx, 10)); });
                            });
                        }
                        results.classList.add('show');
                    });
            }, 250);
        });

        input.addEventListener('focus', function() {
            if (results.innerHTML && this.value.trim().length >= 2) results.classList.add('show');
        });

        document.addEventListener('click', function(e) {
            if (!input.contains(e.target) && !results.contains(e.target)) {
                results.classList.remove('show');
            }
        });

        // B-4b 1-2: ↑/↓ 이동, Enter 활성화, Esc 닫기
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') { results.classList.remove('show'); input.blur(); return; }
            if (!results.classList.contains('show')) return;
            if (e.key === 'ArrowDown') { e.preventDefault(); setSel(selIdx + 1); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); setSel(selIdx - 1); }
            else if (e.key === 'Enter') {
                if (selIdx >= 0 && flat[selIdx]) { e.preventDefault(); activate(flat[selIdx]); }
            }
        });

        function escH(s) { if (!s) return ''; var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
    })();
    </script>
    <script>
    // Auto-add returnTo hidden field to all inline POST forms (delete, return, etc.)
    document.querySelectorAll('form[method="POST"]').forEach(function(form) {
        if (!form.querySelector('input[name="returnTo"]')) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'returnTo';
            input.value = location.pathname + location.search;
            form.appendChild(input);
        }
    });

    // Auto-add ?returnTo= to navigation links so users return to where they came from
    (function() {
        var cur = location.pathname + location.search;
        // Propagate existing returnTo or use current page as returnTo
        var params = new URLSearchParams(location.search);
        var existingReturnTo = params.get('returnTo');

        // 1) Add returnTo to /edit and /new links
        document.querySelectorAll('a[href*="/edit"], a[href*="/new"]').forEach(function(a) {
            var href = a.getAttribute('href');
            if (!href || href.indexOf('returnTo') !== -1) return;
            // Use existing returnTo (propagate) or current page
            var rt = existingReturnTo || cur;
            a.setAttribute('href', href + (href.indexOf('?') === -1 ? '?' : '&') + 'returnTo=' + encodeURIComponent(rt));
        });

        // 2) "목록"/"취소" buttons: use returnTo if present, else keep original href
        if (existingReturnTo) {
            document.querySelectorAll('a.btn-secondary').forEach(function(a) {
                var text = a.textContent.trim();
                if (text === '목록' || text === '취소') {
                    a.setAttribute('href', existingReturnTo);
                }
            });
        }

        // 3) On detail pages: add returnTo to asset/equipment detail links
        //    so clicking through to detail and then "목록" returns to the right list
        var detailPages = ['/storage', '/offices', '/rooms', '/module-inventory',
                           '/inventory', '/lendings', '/discovery', '/audit-log'];
        var isListPage = detailPages.some(function(p) {
            return cur === p || cur.indexOf(p + '?') === 0;
        });
        if (isListPage) {
            document.querySelectorAll('a[href^="/assets/"], a[href*="/inventory/equipment/"]').forEach(function(a) {
                var href = a.getAttribute('href');
                if (!href || href.indexOf('returnTo') !== -1) return;
                // Skip list-level links
                if (href === '/assets' || href === '/assets/' || href === '/inventory') return;
                a.setAttribute('href', href + (href.indexOf('?') === -1 ? '?' : '&') + 'returnTo=' + encodeURIComponent(cur));
            });
        }
    })();
    </script>
    <% if (typeof extraJs !== 'undefined' && extraJs) { %>
    <script src="/js/<%= extraJs %>"></script>
    <% } %>
</body>
</html>
