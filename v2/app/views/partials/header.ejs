<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>IT 자산 관리</title>
    <link rel="stylesheet" href="/css/main.css?v=<%= Date.now() %>">
    <% if (typeof extraCss !== 'undefined' && extraCss) { %>
    <link rel="stylesheet" href="/css/<%= extraCss %>?v=<%= Date.now() %>">
    <% } %>
    <link rel="stylesheet" href="/css/tui-theme.css?v=<%= Date.now() %>"><%# B-T1 TUI 테마 — 이 줄 삭제 시 완전 원복 %>
</head>
<body>
    <nav class="navbar">
        <div class="nav-brand">
            <a href="/">IT 자산 관리</a>
        </div>
        <ul class="nav-links">
            <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">대시보드</a></li>
            <%# v2.1 복원 대상 (AI채팅 — v1 정찰: Ollama 모델/데이터 접근 범위 확인 후 복원.
                복원 시: <li><a href="/chat">AI 채팅</a></li> + currentPath /chat active 클래스) %>
            <li><a href="/inventory" class="<%= (currentPath === '/inventory' || currentPath.startsWith('/inventory/') || currentPath.startsWith('/inventory?')) ? 'active' : '' %>">입출고</a></li>
            <li class="nav-dropdown<%= currentPath.startsWith('/assets') || currentPath.startsWith('/module-inventory') || currentPath.startsWith('/inventory-audit') || currentPath.startsWith('/lendings') ? ' dropdown-active' : '' %>">
                <a href="#" class="nav-dropdown-toggle">자산 ▾</a>
                <ul class="nav-dropdown-menu">
                    <li><a href="/assets" class="<%= currentPath.startsWith('/assets') ? 'active' : '' %>">자산현황</a></li>
                    <li><a href="/module-inventory" class="<%= currentPath.startsWith('/module-inventory') ? 'active' : '' %>">부품현황</a></li>
                    <li><a href="/inventory-audit" class="<%= currentPath.startsWith('/inventory-audit') ? 'active' : '' %>">재고 점검</a></li>
                    <li><a href="/lendings" class="<%= currentPath.startsWith('/lendings') ? 'active' : '' %>">대여관리</a></li><%# BL-13: v1부터 메뉴 미노출로 고립됐던 화면의 진입점 신설 %>
                </ul>
            </li>
            <li class="nav-dropdown<%= currentPath.startsWith('/rooms') || currentPath.startsWith('/racks') || currentPath.startsWith('/offices') || currentPath.startsWith('/storage') ? ' dropdown-active' : '' %>">
                <a href="#" class="nav-dropdown-toggle">시설 ▾</a>
                <ul class="nav-dropdown-menu">
                    <li><a href="/rooms" class="<%= currentPath.startsWith('/rooms') || currentPath.startsWith('/racks') ? 'active' : '' %>">서버실</a></li>
                    <li><a href="/offices" class="<%= currentPath.startsWith('/offices') ? 'active' : '' %>">사무실</a></li>
                    <li><a href="/storage" class="<%= currentPath.startsWith('/storage') ? 'active' : '' %>">장비실</a></li>
                </ul>
            </li>
            <li class="nav-dropdown<%= currentPath.startsWith('/ip-management') || currentPath.startsWith('/discovery') ? ' dropdown-active' : '' %>">
                <a href="#" class="nav-dropdown-toggle">인프라 ▾</a>
                <ul class="nav-dropdown-menu">
                    <li><a href="/ip-management" class="<%= currentPath.startsWith('/ip-management') ? 'active' : '' %>">IP 관리</a></li>
                    <li><a href="/discovery" class="<%= currentPath.startsWith('/discovery') ? 'active' : '' %>">자산 매칭</a></li>
                </ul>
            </li>
            <%# B-T2: GPU모니터링 제거로 단일 항목이 된 모니터링 드롭다운은 평탄화 %>
            <li><a href="/audit-log" class="<%= currentPath.startsWith('/audit-log') ? 'active' : '' %>">이력관리</a></li>
            <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
            <li><a href="/admin/users" class="<%= currentPath.startsWith('/admin') ? 'active' : '' %>">계정관리</a></li>
            <%# T4: 백업 관리(scripts/backup.sh 호출형 재설계 — 생성/목록/다운로드/삭제 + 복원 가이드) %>
            <li><a href="/backups" class="<%= currentPath.startsWith('/backups') ? 'active' : '' %>">백업 관리</a></li>
            <% } %>
        </ul>
        <div class="nav-search">
            <input type="text" id="globalSearch" class="global-search-input" placeholder="통합 검색 (장비, IP, 자산/관리번호...)" autocomplete="off">
            <div class="global-search-results" id="globalSearchResults"></div>
        </div>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="nav-user" style="display:flex; align-items:center; gap:8px; margin-left:12px; white-space:nowrap;">
            <span style="font-size:13px; color:var(--text-secondary);">
                <strong><%= currentUser.displayName || currentUser.username %></strong>
                <span class="badge badge-<%= currentUser.role === 'admin' ? 'danger' : currentUser.role === 'maintenance' ? 'warning' : 'info' %>" style="font-size:10px; padding:1px 6px;">
                    <%= currentUser.role === 'admin' ? '관리자' : currentUser.role === 'maintenance' ? '유지보수' : '조회' %>
                </span>
            </span>
            <a href="/logout" class="btn btn-sm btn-outline" style="font-size:11px; padding:2px 8px;">로그아웃</a>
        </div>
        <% } %>
    </nav>
    <% if (typeof flash !== 'undefined' && flash) { %>
    <% if (flash.success) { %>
    <div class="alert alert-success"><%- flash.success %></div>
    <% } %>
    <% if (flash.error) { %>
    <div class="alert alert-error"><%= flash.error %></div>
    <% } %>
    <% } %>
    <main class="container">
