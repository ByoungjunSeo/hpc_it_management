var _pendingBladeSlot = '';  // blade_slot to pre-select after rack change

function onInvRackChange() {
    var sel = document.getElementById('invRackSelect');
    var manualGroup = document.getElementById('invRackManualGroup');
    var hidden = document.getElementById('invRackHidden');
    var unitGroup = document.getElementById('invUnitGroup');
    var switchSlotGroup = document.getElementById('invSwitchSlotGroup');
    var switchSlotSelect = document.getElementById('invSwitchSlotSelect');

    if (sel.value === '__manual__') {
        manualGroup.style.display = '';
        document.getElementById('invRackManualInput').focus();
        hidden.value = document.getElementById('invRackManualInput').value;
        document.getElementById('invRackPreview').style.display = 'none';
        unitGroup.style.display = '';
        switchSlotGroup.style.display = 'none';
    } else {
        manualGroup.style.display = 'none';
        hidden.value = sel.value;

        // Check if selected rack is immersion type with switch slots
        var selOpt = sel.options[sel.selectedIndex];
        var rackType = selOpt ? selOpt.getAttribute('data-rack-type') : '';
        var switchSlots = parseInt(selOpt ? selOpt.getAttribute('data-switch-slots') : 0) || 0;

        if (rackType === 'immersion' && switchSlots > 0) {
            // Show both Unit (for servers) and switch slot selector
            unitGroup.style.display = '';
            switchSlotGroup.style.display = '';
            // Populate switch slot dropdown
            switchSlotSelect.innerHTML = '<option value="">사용 안 함</option>';
            for (var i = 1; i <= switchSlots; i++) {
                var opt = document.createElement('option');
                opt.value = 'SW' + i;
                opt.textContent = 'SW' + i;
                switchSlotSelect.appendChild(opt);
            }
            // Fetch occupied switch slots (exclude current asset)
            var rackId = selOpt.getAttribute('data-rack-id');
            if (rackId) {
                var excludeId = _invCurrentAssetId || '';
                fetch('/racks/' + rackId + '/switch-slots?exclude=' + excludeId)
                    .then(function(r) { return r.ok ? r.json() : { occupied: [] }; })
                    .then(function(data) {
                        var opts = switchSlotSelect.options;
                        for (var j = 1; j < opts.length; j++) {
                            var slotVal = opts[j].value;
                            var occ = data.occupied.find(function(o) { return o.slot === slotVal; });
                            if (occ) {
                                opts[j].textContent = slotVal + ' (사용중: ' + (occ.name || '') + ')';
                                opts[j].disabled = true;
                            }
                        }
                        // Pre-select pending blade slot if set
                        if (_pendingBladeSlot) {
                            for (var j = 0; j < switchSlotSelect.options.length; j++) {
                                if (switchSlotSelect.options[j].value === _pendingBladeSlot) {
                                    switchSlotSelect.options[j].disabled = false;
                                    switchSlotSelect.options[j].textContent = _pendingBladeSlot + ' (현재)';
                                    switchSlotSelect.selectedIndex = j;
                                    break;
                                }
                            }
                            _pendingBladeSlot = '';
                        }
                    });
            }
        } else {
            switchSlotGroup.style.display = 'none';
            switchSlotSelect.value = '';
        }
        loadInvRackPreview();
    }
}

// When switch slot is selected, clear unit; when unit is filled, clear switch slot
