function onHwTypeChange(sel) {
    var row = sel.closest('.inv-hw-row');
    var codeInput = row.querySelector('input[name="hw_codes[]"]');
    var ownerSel = row.querySelector('select[name="hw_ownerships[]"]');
    var isVendor = ownerSel && ownerSel.value === 'vendor';
    if (codeInput) {
        if (isVendor) {
            codeInput.removeAttribute('list');
        } else {
            codeInput.setAttribute('list', 'hw-list-' + sel.value);
        }
        codeInput.value = '';
    }
    // Show/hide role cell for PSU
    var roleCell = row.querySelector('.hw-role-cell');
    if (roleCell) {
        roleCell.style.display = (sel.value === 'psu') ? '' : 'none';
        if (sel.value !== 'psu') {
            var roleSel = roleCell.querySelector('select');
            if (roleSel) roleSel.value = '';
        }
    }
    updateRoleColumnVisibility();
}

function showRoleColumn() {
    var header = document.querySelector('.hw-role-header');
    if (header) header.style.display = '';
}

function updateRoleColumnVisibility() {
    var rows = document.querySelectorAll('.inv-hw-row');
    var hasPsu = false;
    rows.forEach(function(r) {
        var typeSel = r.querySelector('select[name="hw_types[]"]');
        if (typeSel && typeSel.value === 'psu') hasPsu = true;
