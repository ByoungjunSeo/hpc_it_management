// === 랙 미리보기 ===
var _invRackOccupancy = {}; // uMap[u] = { full, left, right }
var _invTotalU = 42;
var _invCurrentAssetId = null; // 현재 선택된 자산 ID (자기 자신 제외용)

function escapeInvHtml(str) {
    var d = document.createElement('div'); d.textContent = str; return d.innerHTML;
}

function getInvShelfUSize() {
    var input = document.getElementById('invShelfUSize');
    return Math.max(1, parseInt(input ? input.value : 1) || 1);
}

function getInvPlaceUSize() {
    var input = document.getElementById('invPlaceUSize');
    var base = Math.max(1, parseInt(input ? input.value : 1) || 1);
    var shelf = document.getElementById('invShelfCheck');
    return base + (shelf && shelf.checked ? getInvShelfUSize() : 0);
}

function getInvBaseUSize() {
    var input = document.getElementById('invPlaceUSize');
    return Math.max(1, parseInt(input ? input.value : 1) || 1);
}

function isInvShelfChecked() {
    var shelf = document.getElementById('invShelfCheck');
    return shelf && shelf.checked;
}

function onInvShelfToggle() {
    var checked = isInvShelfChecked();
    document.getElementById('invShelfUSizeWrap').style.display = checked ? '' : 'none';
    onInvPlaceUSizeChange();
}

function onInvPlaceUSizeChange() {
    _currentAssetUSize = getInvPlaceUSize();
}

function loadInvRackPreview() {
    var sel = document.getElementById('invRackSelect');
    var opt = sel.options[sel.selectedIndex];
    var rackId = opt ? opt.getAttribute('data-rack-id') : '';
    var preview = document.getElementById('invRackPreview');
    if (!rackId || sel.value === '' || sel.value === '__manual__') {
        preview.style.display = 'none';
        return;
    }
    fetch('/racks/' + rackId + '/slots')
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(data) {
            if (!data) { preview.style.display = 'none'; return; }
            renderInvRackPreview(data);
            preview.style.display = '';
        })
        .catch(function() { preview.style.display = 'none'; });
}

function renderInvRackPreview(data) {
    _invTotalU = data.totalU || 42;
    var totalSlots = _invTotalU * 3;
    var container = document.getElementById('invRackPreviewContainer');
    var info = document.getElementById('invRackPreviewInfo');
    info.textContent = data.rack.name + ' (' + _invTotalU + 'U)';

    // Build slot-level occupancy map: _invRackOccupancy[slot] = { full, left, right }
    // 현재 선택된 자산은 점유에서 제외 (기존 위치 재선택 허용)
    _invRackOccupancy = {};
    data.assets.forEach(function(a) {
        if (_invCurrentAssetId && a.id === _invCurrentAssetId) return; // 자기 자신 제외
        var slotStart = a.rack_unit_start;
        var slotSize = a.rack_unit_size || 3;
        var side = a.blade_slot || 'full';
        var uStart = Math.floor((slotStart - 1) / 3) + 1;
        var uSize = Math.max(1, Math.ceil(slotSize / 3));
        var assetInfo = { name: a.name, mgmt: a.management_number, slotStart: slotStart, slotSize: slotSize, uStart: uStart, uSize: uSize, side: side, id: a.id };
        for (var s = slotStart; s < slotStart + slotSize; s++) {
            if (!_invRackOccupancy[s]) _invRackOccupancy[s] = { full: null, left: null, right: null };
            if (side === 'full') _invRackOccupancy[s].full = assetInfo;
            else _invRackOccupancy[s][side] = assetInfo;
        }
    });

    var occColors = { full: '#e2e8f0', left: '#dbeafe', right: '#fce7f3' };
    var occTextColors = { full: '#475569', left: '#1e40af', right: '#9d174d' };
    var holeLabels = ['하', '중', '상'];

    var html = '<table style="width:100%; border-collapse:collapse; font-size:11px; table-layout:fixed;">';
    html += '<colgroup><col style="width:40px"><col style="width:20px"><col style="width:50%"><col style="width:50%"></colgroup>';

    // Render from top (U42 H3) to bottom (U1 H1)
    for (var u = _invTotalU; u >= 1; u--) {
        for (var h = 3; h >= 1; h--) {
            var slot = (u - 1) * 3 + h;
            var m = _invRackOccupancy[slot] || { full: null, left: null, right: null };
            var hasFull = !!m.full;
            var hasLeft = !!m.left;
            var hasRight = !!m.right;

            var cellH = 'height:18px; padding:1px 4px; border:1px solid #e2e8f0; font-size:10px; vertical-align:middle;';
            // FIX-A(BUG-7)/BUG-8: 배경은 CSS(.inv-rack-empty)가 담당 — 인라인 색 지정 제거로
            // 다크 테마에서도 원배경 유지, 선택/원복은 클래스 토글.
            var emptyCell = cellH + ' cursor:pointer;';

            html += '<tr data-slot="' + slot + '" data-u="' + u + '" data-h="' + h + '">';

            // U label - only on first hole (h=3, top of U since we render top-down)
            if (h === 3) {
                html += '<td rowspan="3" style="padding:1px 4px; text-align:right; font-weight:600; color:#64748b; border:1px solid #e2e8f0; background:#f8fafc; font-size:11px; white-space:nowrap; vertical-align:middle;">U' + u + '</td>';
            }

            // Hole indicator
            html += '<td style="padding:0 3px; text-align:center; color:#94a3b8; border:1px solid #f1f5f9; background:#f8fafc; font-size:9px;">' + holeLabels[h - 1] + '</td>';

            if (hasFull) {
                var a = m.full;
                var isStart = a.slotStart === slot;
                html += '<td colspan="2" style="' + cellH + ' background:' + occColors.full + ';">';
                if (isStart) {
                    html += '<span style="color:' + occTextColors.full + '; font-weight:500;">' + escapeInvHtml(a.name) + '</span>';
                    if (a.mgmt) html += ' <span style="color:#94a3b8; font-size:9px;">' + escapeInvHtml(a.mgmt) + '</span>';
                    if (a.uSize > 1) html += ' <span style="color:#94a3b8; font-size:9px;">(' + a.uSize + 'U)</span>';
                }
                html += '</td>';
            } else if (hasLeft || hasRight) {
                if (hasLeft) {
                    var a = m.left;
                    var isStart = a.slotStart === slot;
                    html += '<td style="' + cellH + ' background:' + occColors.left + ';">';
                    if (isStart) html += '<span style="color:' + occTextColors.left + '; font-weight:500; font-size:10px;">' + escapeInvHtml(a.name) + '</span>';
                    html += '</td>';
                } else {
                    html += '<td class="inv-rack-empty" style="' + emptyCell + '" onclick="onInvSlotClick(' + slot + ')"></td>';
                }
                if (hasRight) {
                    var a = m.right;
                    var isStart = a.slotStart === slot;
                    html += '<td style="' + cellH + ' background:' + occColors.right + ';">';
                    if (isStart) html += '<span style="color:' + occTextColors.right + '; font-weight:500; font-size:10px;">' + escapeInvHtml(a.name) + '</span>';
                    html += '</td>';
                } else {
                    html += '<td class="inv-rack-empty" style="' + emptyCell + '" onclick="onInvSlotClick(' + slot + ')"></td>';
                }
            } else {
                html += '<td colspan="2" class="inv-rack-empty" style="' + emptyCell + '" onclick="onInvSlotClick(' + slot + ')"></td>';
            }
            html += '</tr>';
        }
    }
    html += '</table>';
    container.innerHTML = html;
}

function isInvSlotOccupied(slot) {
    var m = _invRackOccupancy[slot];
    return m && (m.full || m.left || m.right);
}

function slotToU(slot) { return Math.floor((slot - 1) / 3) + 1; }
function slotToH(slot) { return ((slot - 1) % 3) + 1; }
function uhToSlot(u, h) { return (u - 1) * 3 + h; }

// Slot-level click: place equipment starting at this slot
function onInvSlotClick(slot) {
    var baseUSize = getInvBaseUSize();
    var hasShelf = isInvShelfChecked();
    var shelfUSize = hasShelf ? getInvShelfUSize() : 0;
    var totalSlots = (baseUSize + shelfUSize) * 3;
    var slotEnd = slot + totalSlots - 1;
    var totalSlotMax = _invTotalU * 3;

    // Bounds check
    if (slotEnd > totalSlotMax) {
        alert('슬롯 범위 초과: ' + formatSlotRange(slot, slotEnd) + ' (최대 U' + _invTotalU + ')');
        return;
    }

    // Overlap check
    var conflicts = [];
    for (var s = slot; s <= slotEnd; s++) {
        if (isInvSlotOccupied(s)) {
            var m = _invRackOccupancy[s];
            var name = (m.full || m.left || m.right).name;
            if (conflicts.indexOf(name) === -1) conflicts.push(name);
        }
    }
    if (conflicts.length > 0) {
        alert(formatSlotRange(slot, slotEnd) + ' 범위에 이미 장비가 있습니다:\n' + conflicts.join(', '));
        return;
    }

    // Set Unit field
    var unitInput = document.querySelector('[name="unit"]');
    if (unitInput) {
        if (hasShelf) {
            var shelfSlots = shelfUSize * 3;
            var shelfEnd = slot + shelfSlots - 1;
            var equipStart = slot + shelfSlots;
            unitInput.value = formatSlotRange(slot, slotEnd) + ' (선반 ' + formatSlotRange(slot, shelfEnd) + ', 장비 ' + formatSlotRange(equipStart, slotEnd) + ')';
        } else {
            unitInput.value = formatSlotRange(slot, slotEnd);
        }
    }

    // Store shelf_size (in slots) for server-side
    var shelfHidden = document.getElementById('invShelfSizeHidden');
    if (shelfHidden) shelfHidden.value = hasShelf ? shelfUSize * 3 : 0;

    highlightInvSlots(slot, totalSlots, hasShelf ? shelfUSize * 3 : 0);
}

// Format slot range as human-readable U/H text
function formatSlotRange(slotStart, slotEnd) {
    var u1 = slotToU(slotStart), h1 = slotToH(slotStart);
    var u2 = slotToU(slotEnd), h2 = slotToH(slotEnd);
    var startStr = 'U' + u1 + (h1 !== 1 ? 'H' + h1 : '');
    var endStr = 'U' + u2 + (h2 !== 3 ? 'H' + h2 : '');
    if (slotStart === slotEnd) return startStr;
    return startStr + '-' + endStr;
}

function highlightInvSlots(slotStart, count, shelfSlots) {
    clearInvSlotHighlight();
    var shelfEnd = slotStart + shelfSlots; // exclusive
    for (var s = slotStart; s < slotStart + count; s++) {
        var row = document.querySelector('#invRackPreviewContainer tr[data-slot="' + s + '"]');
        if (!row) continue;
        var isShelf = shelfSlots > 0 && (s < shelfEnd);
        // Skip the U label (rowspan) and hole label cells
        var cells = row.querySelectorAll('td');
        var startIdx = (slotToH(s) === 3) ? 2 : 1; // h=3 has U label td
        for (var c = startIdx; c < cells.length; c++) {
            if (!isInvSlotOccupied(s)) {
                // BUG-8: 인라인 배경/outline 직접 지정 → 클래스 토글(CSS). 다크 테마 잔상 방지
                if (isShelf) {
                    cells[c].classList.add('inv-sel-shelf');
                    if (s === slotStart) cells[c].innerHTML = '<span class="inv-sel-tag shelf">선반</span>';
                } else {
                    cells[c].classList.add('inv-sel-device');
                    if (s === shelfEnd) cells[c].innerHTML = '<span class="inv-sel-tag device">장비</span>';
                }
            }
        }
    }
}

function clearInvSlotHighlight() {
    var rows = document.querySelectorAll('#invRackPreviewContainer tr[data-slot]');
    rows.forEach(function(row) {
        var s = parseInt(row.getAttribute('data-slot'));
        if (!isInvSlotOccupied(s)) {
            var cells = row.querySelectorAll('td');
            var startIdx = (slotToH(s) === 3) ? 2 : 1;
            for (var c = startIdx; c < cells.length; c++) {
                // BUG-8: 클래스 제거로 원배경 복귀 (JS가 배경 직접 안 건드림)
                cells[c].classList.remove('inv-sel-shelf', 'inv-sel-device');
                cells[c].innerHTML = '';
            }
        }
    });
}

// === 가용 IP 조회 ===
function openInvIpModal() {
    var modal = document.getElementById('invIpModal');
    modal.style.display = 'flex';
    document.getElementById('invIpList').innerHTML = '<div style="text-align:center; padding:20px; color:#94a3b8;">서브넷을 선택하세요</div>';
    // B-6e Part4: 서브넷 목록 동적 로드 (subnets 테이블 기반)
    var sel = document.getElementById('invIpSubnetSelect');
    fetch('/assets/api/subnets')
        .then(function(r) { return r.ok ? r.json() : { subnets: [] }; })
        .then(function(data) {
            var opts = '<option value="">서브넷 선택</option>';
            (data.subnets || []).forEach(function(s) {
                opts += '<option value="' + s.cidr + '">' + s.name + ' (' + s.cidr + ') · 가용 ' + s.available + '</option>';
            });
            sel.innerHTML = opts;
            if (!data.subnets || data.subnets.length === 0) {
                document.getElementById('invIpList').innerHTML = '<div style="text-align:center; padding:20px; color:#94a3b8;">등록된 서브넷이 없습니다. IP 관리에서 먼저 등록하세요.</div>';
            }
        })
        .catch(function() {
            document.getElementById('invIpList').innerHTML = '<div style="text-align:center; padding:20px; color:#ef4444;">서브넷 목록 조회 실패</div>';
        });
}

function closeInvIpModal() {
    document.getElementById('invIpModal').style.display = 'none';
}

// Close modal on background click
document.getElementById('invIpModal').addEventListener('click', function(e) {
    if (e.target === this) closeInvIpModal();
});

function loadInvAvailableIps() {
    var subnet = document.getElementById('invIpSubnetSelect').value;
    if (!subnet) {
        document.getElementById('invIpList').innerHTML = '<div style="text-align:center; padding:20px; color:#94a3b8;">서브넷을 선택하세요</div>';
        return;
    }
    var listEl = document.getElementById('invIpList');
    var loadingEl = document.getElementById('invIpLoading');
    listEl.innerHTML = '';
    loadingEl.style.display = '';
    fetch('/assets/api/available-ips?subnet=' + encodeURIComponent(subnet))
        .then(function(r) { return r.ok ? r.json() : { ips: [] }; })
        .then(function(data) {
            loadingEl.style.display = 'none';
            if (!data.ips || data.ips.length === 0) {
                listEl.innerHTML = '<div style="text-align:center; padding:20px; color:#ef4444;">가용 IP가 없습니다</div>';
                return;
            }
            var html = '<div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:4px;">';
            data.ips.forEach(function(ip) {
                html += '<button type="button" class="ip-pick-btn" onclick="selectInvAvailableIp(\'' + ip + '\')" style="padding:6px 8px; font-size:12px; border:1px solid #e2e8f0; border-radius:4px; background:#fff; cursor:pointer; text-align:center; transition:background 0.15s;">' + ip + '</button>';
            });
            html += '</div>';
            listEl.innerHTML = html;
        })
        .catch(function() {
            loadingEl.style.display = 'none';
            listEl.innerHTML = '<div style="text-align:center; padding:20px; color:#ef4444;">조회 실패</div>';
        });
}

function selectInvAvailableIp(ip) {
    // Find the last IP row's input and fill it, or add a new row
    var rows = document.querySelectorAll('.inv-ip-row');
    var filled = false;
    if (rows.length > 0) {
        var lastRow = rows[rows.length - 1];
        var ipInput = lastRow.querySelector('input[name="ip_values[]"]');
        if (ipInput && !ipInput.value) {
            ipInput.value = ip;
            filled = true;
        }
    }
    if (!filled) {
        addInvIpRow('management');
        var newRows = document.querySelectorAll('.inv-ip-row');
        var newLast = newRows[newRows.length - 1];
        var ipInput = newLast.querySelector('input[name="ip_values[]"]');
        if (ipInput) ipInput.value = ip;
    }
    closeInvIpModal();
}

// Load rack preview and switch slot on page load if rack is already selected
(function() {
    var sel = document.getElementById('invRackSelect');
    if (sel && sel.value && sel.value !== '' && sel.value !== '__manual__') {
        var opt = sel.options[sel.selectedIndex];
        if (opt && opt.getAttribute('data-rack-id')) {
            // Set pending blade slot for pre-selection (edit mode)
            var editBladeSlot = '<%= typeof linkedAssetBladeSlot !== "undefined" ? linkedAssetBladeSlot : "" %>';
            var editAssetId = '<%= typeof linkedAssetId !== "undefined" && linkedAssetId ? linkedAssetId : "" %>';
            if (editBladeSlot && /^SW\d+$/i.test(editBladeSlot)) {
                _pendingBladeSlot = editBladeSlot;
            }
            if (editAssetId) {
                _invCurrentAssetId = editAssetId;
            }
            onInvRackChange();
        }
    }
})();
</script>

