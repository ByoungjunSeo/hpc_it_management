function onHwOwnerChange(sel) {
    var row = sel.closest('.inv-hw-row');
    var codeInput = row.querySelector('input[name="hw_codes[]"]');
    var typeSel = row.querySelector('select[name="hw_types[]"]');
    if (!codeInput) return;
    if (sel.value === 'vendor') {
        codeInput.removeAttribute('list');
        codeInput.placeholder = '모델명 직접 입력';
    } else {
        var hwType = typeSel ? typeSel.value : 'cpu';
