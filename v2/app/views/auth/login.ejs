<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>로그인 - IT 자산 관리</title>
    <link rel="stylesheet" href="/css/main.css">
    <style>
        body { display: flex; align-items: center; justify-content: center; min-height: 100vh; background: var(--bg-secondary); }
        .login-card { background: var(--bg-primary); border-radius: 12px; padding: 40px; width: 100%; max-width: 400px; box-shadow: 0 4px 24px rgba(0,0,0,0.12); }
        .login-card h1 { text-align: center; margin-bottom: 8px; font-size: 24px; }
        .login-card .subtitle { text-align: center; color: var(--text-secondary); margin-bottom: 24px; }
        .login-card .form-group { margin-bottom: 16px; }
        .login-card label { display: block; margin-bottom: 6px; font-weight: 600; }
        .login-card input { width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; box-sizing: border-box; }
        .login-card .btn { width: 100%; padding: 12px; font-size: 16px; margin-top: 8px; }
    </style>
</head>
<body>
    <div class="login-card">
        <h1>IT 자산 관리</h1>
        <p class="subtitle">HPC/AIDC 자산관리 시스템</p>
        <% if (typeof flash !== 'undefined' && flash) { %>
        <% if (flash.error) { %>
        <div class="alert alert-error"><%= flash.error %></div>
        <% } %>
        <% if (flash.success) { %>
        <div class="alert alert-success"><%= flash.success %></div>
        <% } %>
        <% } %>
        <form method="POST" action="/login">
            <div class="form-group">
                <label for="username">아이디</label>
                <input type="text" id="username" name="username" required autofocus placeholder="사용자 아이디">
            </div>
            <div class="form-group">
                <label for="password">비밀번호</label>
                <input type="password" id="password" name="password" required placeholder="비밀번호">
            </div>
            <button type="submit" class="btn btn-primary">로그인</button>
        </form>
    </div>
</body>
</html>
