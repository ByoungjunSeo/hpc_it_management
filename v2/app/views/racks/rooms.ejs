<%- include('../partials/header', { title, currentPath, extraCss }) %>

<div class="page-header">
    <h1>서버실 관리</h1>
    <button class="btn btn-primary" onclick="openModal('addRoomModal')">+ 서버실 추가</button>
</div>

<!-- Legend -->
<div class="card mini-rack-legend">
    <div class="legend-item"><span class="legend-color server"></span> 자사 서버</div>
    <div class="legend-item"><span class="legend-color vendor"></span> 업체 장비</div>
    <div class="legend-item"><span class="legend-color switch"></span> 스위치</div>
    <div class="legend-item"><span class="legend-color kvm"></span> KVM</div>
    <div class="legend-item"><span class="legend-color pdu"></span> PDU</div>
    <div class="legend-item"><span class="legend-color ups"></span> UPS</div>
    <div class="legend-item"><span class="legend-color storage"></span> 스토리지</div>
    <div class="legend-item"><span class="legend-color other"></span> 기타</div>
    <div class="legend-item"><span class="legend-color empty"></span> 빈 공간</div>
    <div class="legend-item"><span class="legend-color inactive-legend"></span> 비활성</div>
    <div class="legend-item"><span class="legend-color maintenance-legend"></span> 정비중</div>
    <div class="legend-item"><span class="legend-color immersion-legend"></span> &#x1F4A7; 액침탱크</div>
    <span style="margin-left:auto;display:flex;align-items:center;gap:10px;font-size:11px;color:var(--text-light);">
        <span style="display:flex;align-items:center;gap:3px;"><span style="width:6px;height:6px;border-radius:50%;background:#22c55e;display:inline-block;"></span>ON</span>
        <span style="display:flex;align-items:center;gap:3px;"><span style="width:6px;height:6px;border-radius:50%;background:#ef4444;display:inline-block;"></span>OFF</span>
        <span style="display:flex;align-items:center;gap:3px;"><span style="width:6px;height:6px;border-radius:50%;background:#1e293b;display:inline-block;"></span>BMC 미등록</span>
        <span style="display:flex;align-items:center;gap:3px;"><span style="width:6px;height:6px;border-radius:50%;background:#eab308;display:inline-block;"></span>연결실패</span>
    </span>
</div>

<% if (rooms.length === 0) { %>
<div class="card text-center">
    <p class="text-muted">등록된 서버실이 없습니다. 서버실을 추가해주세요.</p>
</div>
<% } %>

<% rooms.forEach(room => { %>
<div class="room-section">
    <div class="room-section-header">
        <h2><a href="/rooms/<%= room.id %>"><%= room.name %></a></h2>
        <span class="text-muted"><%= room.location || '' %></span>
        <button class="btn btn-sm btn-warning power-check-btn" data-room-id="<%= room.id %>" data-rack-ids="<%= room.racks.map(r=>r.id).join(',') %>" onclick="checkRoomPower(this)" style="margin-left:8px;">&#x26A1; 전원 확인</button>
        <a href="/rooms/<%= room.id %>/assets" class="btn btn-sm btn-outline">자산 목록</a>
        <a href="/rooms/<%= room.id %>/modules" class="btn btn-sm btn-outline">모듈 현황</a>
        <button class="btn btn-sm btn-outline" onclick="openEditRoom(<%= room.id %>, '<%= (room.name || '').replace(/'/g, "\\'") %>', '<%= (room.location || '').replace(/'/g, "\\'") %>', '<%= (room.description || '').replace(/'/g, "\\'") %>', '<%= room.location_type || 'server_room' %>')">수정</button>
        <form method="POST" action="/rooms/<%= room.id %>/delete" style="display:inline" onsubmit="return confirmDelete('서버실과 포함된 모든 랙/장비가 삭제됩니다.')">
            <button type="submit" class="btn btn-sm btn-danger">삭제</button>
        </form>
    </div>

    <% if (room.stats) { %>
    <div class="room-stats-bar">
        <div class="room-stat">
            <span class="room-stat-value"><%= room.stats.rackCount %></span>
            <span class="room-stat-label">랙</span>
        </div>
        <div class="room-stat">
            <span class="room-stat-value"><%= room.stats.totalAssets %></span>
            <span class="room-stat-label">장비</span>
        </div>
        <div class="room-stat room-stat-util">
            <div class="room-util-bar">
                <div class="room-util-fill" style="width:<%= room.stats.utilization %>%"></div>
            </div>
            <span class="room-stat-label"><%= room.stats.usedU %>/<%= room.stats.totalU %>U (<%= room.stats.utilization %>%)</span>
        </div>
        <% if (room.stats.typeCounts) { %>
        <div class="room-stat room-stat-types">
            <% var typeLabels = { server:'서버', switch:'스위치', storage:'스토리지', pdu:'PDU', ups:'UPS', kvm:'KVM', other:'기타' }; %>
            <% Object.keys(room.stats.typeCounts).forEach(function(t) { %>
            <span class="room-type-chip <%= t %>"><%= typeLabels[t] || t %> <%= room.stats.typeCounts[t] %></span>
            <% }) %>
        </div>
        <% } %>
    </div>
    <% } %>

    <% if (room.racks.length === 0) { %>
    <p class="text-muted" style="padding: 12px 0;">등록된 랙이 없습니다.</p>
    <% } else { %>
    <div class="wide-rack-row">
        <% room.racks.forEach(function(rack, rackIdx) { %>
        <%
            const totalUnits = rack.totalUnits || rack.total_units || 42;
            const uMapData = rack.uMap || {};
            // Blade-aware usedU: count unique U positions occupied
            var _occU = {};
            rack.assetList.forEach(a => { if (a.rack_unit_start && !a.parent_asset_id && a.status === 'active') { var su = Math.floor((a.rack_unit_start-1)/3)+1; var sz = Math.ceil((a.rack_unit_size||3)/3); for(var _u=su;_u<su+sz;_u++) _occU[_u]=true; }});
            let usedU = Object.keys(_occU).length;
            function statusCls(info) {
                if (!info || !info.status) return '';
                if (info.status === 'inactive') return ' inactive';
                if (info.status === 'maintenance') return ' maintenance';
                if (info.status === 'decommissioned') return ' inactive';
                return '';
            }
            function wCls(info) {
                if (!info) return 'server';
                if (info.asset_type === 'switch') return 'switch';
                if (info.asset_type === 'kvm') return 'kvm';
                if (info.asset_type === 'pdu') return 'pdu';
                if (info.asset_type === 'ups') return 'ups';
                if (info.asset_type === 'storage') return 'storage';
                if (info.asset_type === 'other') return 'other';
                if (info.ownership === 'vendor') return 'vendor';
                return 'server';
            }
        %>
        <div class="wide-rack wide-rack-draggable" draggable="true"
             data-rack-id="<%= rack.id %>" data-rack-type="<%= rack.rack_type || 'standard' %>" data-order="<%= rackIdx %>">
            <div class="wide-rack-header">
                <span class="drag-handle">&#x2630;</span>
                <% if (rack.rack_type === 'immersion') { %>&#x1F4A7; <% } %><%= rack.name %>
                <% if (rack.rack_type === 'immersion') { %><span class="rack-type-badge immersion">액침</span><% } %>
                <span class="wide-rack-summary"><%= usedU %>/<%= totalUnits %>U</span>
            </div>
            <%
                let mSkipL = 0, mSkipR = 0;
            %>
            <table class="mini-rack-table">
                <% for (let u = totalUnits; u >= 1; u--) { %>
                <%
                    const entry = uMapData[u];
                    const hasFull = entry && entry.full;
                    const hasBlade = !hasFull && entry && (entry.left || entry.right);
                    const isEmpty = !hasFull && !hasBlade;
                    let mEmitL = true, mEmitR = true;
                    if (mSkipL > 0) { mEmitL = false; mSkipL--; }
                    if (mSkipR > 0) { mEmitR = false; mSkipR--; }
                %>
                <tr data-u="<%= u %>">
                    <td class="mini-u-num">U<%= u %></td>
<% if (hasFull && mEmitL) {
    const f = entry.full;
    mSkipL = f.sizeU - 1;
    mSkipR = f.sizeU - 1;
%>
                    <td class="mini-u-asset <%= wCls(f) %><%= statusCls(f) %> clickable-unit" colspan="2" rowspan="<%= f.sizeU %>"
                        data-asset-id="<%= f.asset_id %>" data-asset-type="<%= f.asset_type %>"
                        title="<%= (f.name || f.asset_type) + (f.management_number ? ' (' + f.management_number + ')' : '') + (f.status === 'inactive' ? ' [비활성]' : f.status === 'maintenance' ? ' [정비중]' : '') %>">
                        <span class="mini-asset-name"><%= f.name || f.asset_type %><% if (f.management_number) { %> (<%= f.management_number %>)<% } %></span>
                        <span class="power-dot-mini" data-asset-id="<%= f.asset_id %>"></span>
                    </td>
<% } else if (hasBlade) {
    if (mEmitL) {
        if (entry.left) {
            mSkipL = entry.left.sizeU - 1;
%>
                    <td class="mini-u-asset mini-blade <%= wCls(entry.left) %><%= statusCls(entry.left) %> clickable-unit" rowspan="<%= entry.left.sizeU %>"
                        data-asset-id="<%= entry.left.asset_id %>" data-asset-type="<%= entry.left.asset_type %>"
                        title="<%= (entry.left.name || '') + (entry.left.management_number ? ' (' + entry.left.management_number + ')' : '') + (entry.left.status === 'inactive' ? ' [비활성]' : entry.left.status === 'maintenance' ? ' [정비중]' : '') %>">
                        <span class="mini-asset-name"><%= entry.left.name || '' %><% if (entry.left.management_number) { %> (<%= entry.left.management_number %>)<% } %></span>
                        <span class="power-dot-mini" data-asset-id="<%= entry.left.asset_id %>"></span>
                    </td>
<%      } else { %>
                    <td class="mini-u-asset mini-blade mini-empty"></td>
<%      }
    }
    if (mEmitR) {
        if (entry.right) {
            mSkipR = entry.right.sizeU - 1;
%>
                    <td class="mini-u-asset mini-blade <%= wCls(entry.right) %><%= statusCls(entry.right) %> clickable-unit" rowspan="<%= entry.right.sizeU %>"
                        data-asset-id="<%= entry.right.asset_id %>" data-asset-type="<%= entry.right.asset_type %>"
                        title="<%= (entry.right.name || '') + (entry.right.management_number ? ' (' + entry.right.management_number + ')' : '') + (entry.right.status === 'inactive' ? ' [비활성]' : entry.right.status === 'maintenance' ? ' [정비중]' : '') %>">
                        <span class="mini-asset-name"><%= entry.right.name || '' %><% if (entry.right.management_number) { %> (<%= entry.right.management_number %>)<% } %></span>
                        <span class="power-dot-mini" data-asset-id="<%= entry.right.asset_id %>"></span>
                    </td>
<%      } else { %>
                    <td class="mini-u-asset mini-blade mini-empty"></td>
<%      }
    }
} else if (isEmpty) {
    if (mEmitL && mEmitR) { %>
                    <td class="mini-u-asset mini-empty" colspan="2"></td>
<%  } else {
        if (mEmitL) { %>
                    <td class="mini-u-asset mini-blade mini-empty"></td>
<%      }
        if (mEmitR) { %>
                    <td class="mini-u-asset mini-blade mini-empty"></td>
<%      }
    }
} %>
                </tr>
                <% } %>
            </table>
            <a href="/racks/<%= rack.id %>" class="wide-rack-link">상세 보기</a>
        </div>
        <% }) %>
    </div>
    <% } %>
</div>
<% }) %>

<!-- Add Room Modal -->
<div class="modal-overlay" id="addRoomModal">
    <div class="modal">
        <div class="modal-header">
            <h3>서버실 추가</h3>
            <button class="modal-close" onclick="closeModal('addRoomModal')">&times;</button>
        </div>
        <form method="POST" action="/rooms">
            <div class="form-group">
                <label>서버실 이름 *</label>
                <input type="text" name="name" class="form-control" required placeholder="예: AIDC, HPC">
            </div>
            <div class="form-group">
                <label>위치</label>
                <input type="text" name="location" class="form-control" placeholder="예: 3층 A동">
            </div>
            <div class="form-group">
                <label>설명</label>
                <textarea name="description" class="form-control"></textarea>
            </div>
            <input type="hidden" name="location_type" value="server_room">
            <div class="btn-group">
                <button type="submit" class="btn btn-primary">추가</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal('addRoomModal')">취소</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Room Modal -->
<div class="modal-overlay" id="editRoomModal">
    <div class="modal">
        <div class="modal-header">
            <h3>서버실 수정</h3>
            <button class="modal-close" onclick="closeModal('editRoomModal')">&times;</button>
        </div>
        <form method="POST" id="editRoomForm" action="">
            <div class="form-group">
                <label>서버실 이름 *</label>
                <input type="text" name="name" id="editRoomName" class="form-control" required>
            </div>
            <div class="form-group">
                <label>위치</label>
                <input type="text" name="location" id="editRoomLocation" class="form-control">
            </div>
            <div class="form-group">
                <label>설명</label>
                <textarea name="description" id="editRoomDesc" class="form-control"></textarea>
            </div>
            <div class="form-group">
                <label>위치 유형</label>
                <select name="location_type" id="editRoomType" class="form-control">
                    <% appConfig.locationTypes.forEach(t => { %>
                    <option value="<%= t.value %>"><%= t.label %></option>
                    <% }) %>
                </select>
            </div>
            <div class="btn-group">
                <button type="submit" class="btn btn-primary">수정</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal('editRoomModal')">취소</button>
            </div>
        </form>
    </div>
</div>

<!-- Asset Detail Popup -->
<div class="modal-overlay" id="assetDetailPopup">
    <div class="modal" style="max-width:700px;max-height:85vh;display:flex;flex-direction:column;">
        <div class="modal-header">
            <h3 id="adpTitle">장비 정보</h3>
            <button class="modal-close" onclick="closeModal('assetDetailPopup')">&times;</button>
        </div>
        <div class="adp-tabs" style="display:flex;border-bottom:1px solid var(--border);padding:0 16px;gap:0;">
            <button class="adp-tab active" data-tab="basic" onclick="switchAdpTab('basic')">기본정보</button>
            <button class="adp-tab" data-tab="ip" onclick="switchAdpTab('ip')">IP정보</button>
            <button class="adp-tab" data-tab="access" onclick="switchAdpTab('access')">접속정보</button>
            <button class="adp-tab" data-tab="ops" onclick="switchAdpTab('ops')">운영정보</button>
            <button class="adp-tab" data-tab="modules" onclick="switchAdpTab('modules')">컴퓨팅 모듈</button>
            <button class="adp-tab" data-tab="power" onclick="switchAdpTab('power')" id="adpPowerTab" style="display:none;">전원</button>
        </div>
        <div id="adpContent" style="padding:16px;overflow-y:auto;flex:1;">
            <p class="text-muted">로딩중...</p>
        </div>
        <div style="padding:8px 16px;border-top:1px solid var(--border);display:flex;gap:8px;">
            <a id="adpDetailLink" href="#" class="btn btn-primary btn-sm">상세 페이지</a>
            <a id="adpEditLink" href="#" class="btn btn-outline btn-sm">수정</a>
            <button class="btn btn-secondary btn-sm" onclick="closeModal('assetDetailPopup')" style="margin-left:auto;">닫기</button>
        </div>
    </div>
</div>

<script>
// --- Wide rack drag-and-drop (horizontal swap) ---
(function() {
    var dragSrcEl = null;

    document.querySelectorAll('.wide-rack-draggable').forEach(function(el) {
        el.addEventListener('dragstart', function(e) {
            dragSrcEl = this;
            this.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', this.dataset.rackId);
        });
        el.addEventListener('dragend', function() {
            this.classList.remove('dragging');
            document.querySelectorAll('.wide-rack-draggable').forEach(function(z) {
                z.classList.remove('drag-over');
            });
        });
        el.addEventListener('dragover', function(e) {
            if (this === dragSrcEl) return;
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            this.classList.add('drag-over');
        });
        el.addEventListener('dragleave', function() {
            this.classList.remove('drag-over');
        });
        el.addEventListener('drop', function(e) {
            e.preventDefault();
            this.classList.remove('drag-over');
            if (!dragSrcEl || this === dragSrcEl) return;
            // Swap DOM positions
            var parent = dragSrcEl.parentNode;
            var srcNext = dragSrcEl.nextElementSibling;
            if (srcNext === this) {
                parent.insertBefore(this, dragSrcEl);
            } else {
                var tgtNext = this.nextElementSibling;
                parent.insertBefore(dragSrcEl, this);
                if (tgtNext) {
                    // srcNext could be null if src was last
                    parent.insertBefore(this, srcNext);
                } else {
                    parent.appendChild(this);
                }
            }
            // Save new col_position for all racks in this row
            var racks = parent.querySelectorAll('.wide-rack-draggable');
            racks.forEach(function(r, idx) {
                var col = idx + 1;
                r.dataset.order = idx;
                fetch('/racks/' + r.dataset.rackId + '/position', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ row_position: 1, col_position: col })
                });
            });
        });
    });
})();

// --- Asset popup ---
var adpCache = {};
var adpCurrentTab = 'basic';

document.querySelectorAll('.clickable-unit').forEach(function(el) {
    el.addEventListener('click', function(e) {
        e.stopPropagation();
        var assetId = this.dataset.assetId;
        if (assetId) openAssetPopup(parseInt(assetId));
    });
});

function openAssetPopup(assetId) {
    document.getElementById('adpTitle').textContent = '로딩중...';
    document.getElementById('adpContent').innerHTML = '<p class="text-muted">로딩중...</p>';
    document.getElementById('adpDetailLink').href = '/assets/' + assetId;
    document.getElementById('adpEditLink').href = '/assets/' + assetId + '/edit';
    adpCurrentTab = 'basic';
    document.querySelectorAll('.adp-tab').forEach(function(t) { t.classList.toggle('active', t.dataset.tab === 'basic'); });
    openModal('assetDetailPopup');

    fetch('/assets/' + assetId + '/json')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            adpCache[assetId] = data;
            renderAdp(data);
        })
        .catch(function() {
            document.getElementById('adpContent').innerHTML = '<p style="color:#ef4444;">데이터를 불러올 수 없습니다.</p>';
        });
}

function renderAdp(data) {
    var a = data.asset;
    document.getElementById('adpTitle').textContent = a.model_name || a.asset_type || '장비 정보';
    // Show/hide power tab based on asset type and BMC availability
    var powerTab = document.getElementById('adpPowerTab');
    var powerTypes = ['server', 'storage', 'switch', 'kvm', 'other'];
    var hasBmc = data.assetIps && data.assetIps.some(function(ip) { return ip.ip_type === 'bmc'; });
    if (powerTab) {
        powerTab.style.display = (powerTypes.indexOf(a.asset_type) !== -1 && hasBmc) ? '' : 'none';
    }
    renderAdpTab(data, adpCurrentTab);
}

function switchAdpTab(tab) {
    adpCurrentTab = tab;
    document.querySelectorAll('.adp-tab').forEach(function(t) { t.classList.toggle('active', t.dataset.tab === tab); });
    var assetId = parseInt(document.getElementById('adpDetailLink').href.split('/assets/')[1]);
    if (adpCache[assetId]) renderAdpTab(adpCache[assetId], tab);
}

function renderAdpTab(data, tab) {
    var a = data.asset;
    var html = '';

    if (tab === 'basic') {
        html = '<table class="adp-table">' +
            tr('자산번호', a.asset_number) +
            tr('관리번호', a.management_number) +
            tr('유형', typeLabel(a.asset_type)) +
            tr('소유', a.ownership === 'company' ? '자사' : '업체' + (a.vendor_name ? ' (' + esc(a.vendor_name) + ')' : '')) +
            tr('제조사', a.manufacturer) +
            tr('모델명', a.model_name) +
            tr('시리얼', a.serial_number) +
            tr('상태', statusLabel(a.status)) +
            tr('서버실', a.room_name) +
            tr('랙', a.rack_name) +
            tr('U위치', a.rack_unit_start ? 'U' + (Math.floor((a.rack_unit_start - 1) / 3) + 1) + ((a.rack_unit_size || 3) > 3 ? ' ~ U' + (Math.floor((a.rack_unit_start + (a.rack_unit_size || 3) - 2) / 3) + 1) : '') : '-') +
            '</table>';
    } else if (tab === 'ip') {
        if (data.assetIps && data.assetIps.length > 0) {
            html = '<table class="adp-table"><tr><th>유형</th><th>인터페이스</th><th>속도</th><th>IP 주소</th><th>설명</th></tr>';
            data.assetIps.forEach(function(ip) {
                html += '<tr><td>' + esc(ipTypeLabel(ip)) + '</td><td>' + esc(ip.interface_type || '-') + '</td><td>' + esc(ip.speed || '-') + '</td><td><strong>' + esc(ip.ip_address) + '</strong></td><td>' + esc((ip.ip_type !== 'other' && ip.description) ? ip.description : '') + '</td></tr>';
            });
            html += '</table>';
        } else if (a.ip_address) {
            html = '<table class="adp-table">' + tr('IP 주소', a.ip_address) + tr('SSH 포트', a.ssh_port) + '</table>';
        } else {
            html = '<p class="text-muted">등록된 IP 정보가 없습니다.</p>';
        }
    } else if (tab === 'access') {
        if (data.credentials && data.credentials.length > 0) {
            html = '<table class="adp-table"><tr><th>유형</th><th>사용자</th><th>비밀번호</th><th>설명</th></tr>';
            data.credentials.forEach(function(c) {
                html += '<tr><td>' + esc(credTypeLabel(c.credential_type)) + '</td><td>' + esc(c.username) + '</td><td><code class="pw-hide" onclick="this.classList.toggle(\'pw-show\')">' + esc(c.password || '') + '</code></td><td>' + esc(c.description || '') + '</td></tr>';
            });
            html += '</table>';
        } else if (a.ssh_user) {
            html = '<table class="adp-table">' +
                tr('SSH 사용자', a.ssh_user) +
                tr('SSH 포트', a.ssh_port) +
                '<tr><td>SSH 비밀번호</td><td><code class="pw-hide" onclick="this.classList.toggle(\'pw-show\')">' + esc(a.ssh_password || '-') + '</code></td></tr>' +
                '</table>';
        } else {
            html = '<p class="text-muted">등록된 접속 정보가 없습니다.</p>';
        }
    } else if (tab === 'ops') {
        html = '<table class="adp-table">' +
            tr('담당자', a.assigned_user) +
            tr('용도', a.purpose) +
            tr('구매일', a.purchase_date) +
            tr('보증만료', a.warranty_end) +
            tr('비고', a.notes) +
            '</table>';
    } else if (tab === 'modules') {
        if (data.modules && data.modules.length > 0) {
            var types = { cpu: 'CPU', memory: '메모리', disk: '디스크', network: 'NIC', raid: 'RAID', gpu: 'GPU' };
            html = '<table class="adp-table"><tr><th>유형</th><th>모델</th><th>제조사</th><th>용량</th><th>수량</th><th>슬롯</th></tr>';
            data.modules.forEach(function(m) {
                html += '<tr><td><span class="badge">' + (types[m.module_type] || m.module_type) + '</span></td><td>' + esc(m.model || '') + '</td><td>' + esc(m.manufacturer || '') + '</td><td>' + esc(m.capacity || '') + '</td><td>' + (m.count || 1) + '</td><td>' + esc(m.slot_info || '') + '</td></tr>';
            });
            html += '</table>';
        } else {
            html = '<p class="text-muted">등록된 컴퓨팅 모듈이 없습니다.</p>';
        }
    } else if (tab === 'power') {
        var assetId = a.id;
        html = '<div id="adpPowerContent">' +
            '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">' +
            '<label style="font-weight:600;font-size:13px;margin:0;">현재 전원 상태</label>' +
            '<span id="adpPowerBadge" style="font-size:11px;padding:2px 10px;border-radius:10px;background:#94a3b8;color:white;">확인 중...</span>' +
            '</div>' +
            '<div style="display:flex;gap:8px;margin-bottom:12px;">' +
            '<button class="btn btn-sm" style="background:#22c55e;color:white;flex:1;padding:8px;" onclick="adpDoPowerControl(' + assetId + ',\'on\')">&#x23FB; 켜기</button>' +
            '<button class="btn btn-sm" style="background:#ef4444;color:white;flex:1;padding:8px;" onclick="adpDoPowerControl(' + assetId + ',\'off\')">&#x23FB; 끄기</button>' +
            '<button class="btn btn-sm" style="background:#f59e0b;color:white;flex:1;padding:8px;" onclick="adpDoPowerControl(' + assetId + ',\'reset\')">&#x21BB; 재시작</button>' +
            '</div>' +
            '<div id="adpPowerMsg" style="font-size:12px;color:#64748b;min-height:20px;"></div>' +
            '</div>';
        // Auto-check power status
        setTimeout(function() { adpCheckPower(assetId); }, 100);
    }

    document.getElementById('adpContent').innerHTML = html;
}

function tr(label, val) {
    return '<tr><td><strong>' + label + '</strong></td><td>' + esc(val || '-') + '</td></tr>';
}
function esc(s) { if (!s) return ''; var d = document.createElement('div'); d.textContent = String(s); return d.innerHTML; }
function typeLabel(t) { var m = { server:'서버', switch:'스위치', kvm:'KVM', pdu:'PDU', ups:'UPS', storage:'스토리지', immersion_tank:'액침탱크', cdu:'CDU', chiller:'칠러', other:'기타' }; return m[t] || t || '-'; }
function statusLabel(s) { var m = { active:'운영중', inactive:'비활성', maintenance:'점검중', decommissioned:'폐기' }; return m[s] || s || '-'; }
function ipTypeLabel(ip) { var m = { management:'Management', bmc:'BMC', ib:'InfiniBand', data:'Data', os:'OS', other:'기타' }; return (ip.ip_type === 'other' && ip.description) ? ip.description : (m[ip.ip_type] || ip.ip_type || '-'); }
function credTypeLabel(t) { var m = { root:'Root', user:'User', admin:'Admin', bmc:'BMC', etc:'기타' }; return m[t] || t || '-'; }

function openEditRoom(id, name, location, desc, type) {
    document.getElementById('editRoomForm').action = '/rooms/' + id + '/edit';
    document.getElementById('editRoomName').value = name;
    document.getElementById('editRoomLocation').value = location;
    document.getElementById('editRoomDesc').value = desc;
    document.getElementById('editRoomType').value = type;
    openModal('editRoomModal');
}

// --- Power status check per room ---
function checkRoomPower(btn) {
    var rackIds = (btn.dataset.rackIds || '').split(',').filter(Boolean);
    if (rackIds.length === 0) return;
    btn.disabled = true;
    btn.innerHTML = '&#x26A1; 확인 중...';

    // Show loading on all power dots in this room section
    var section = btn.closest('.room-section');
    section.querySelectorAll('.power-dot-mini').forEach(function(d) {
        d.className = 'power-dot-mini loading';
    });

    var allResults = {};
    var done = 0;
    rackIds.forEach(function(rackId) {
        fetch('/racks/' + rackId + '/power-status')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                Object.assign(allResults, data);
            })
            .catch(function() {})
            .finally(function() {
                done++;
                if (done >= rackIds.length) {
                    applyPowerResults(section, allResults);
                    btn.innerHTML = '&#x26A1; 확인 완료';
                }
            });
    });
}

function applyPowerResults(section, results) {
    section.querySelectorAll('.power-dot-mini').forEach(function(dot) {
        var id = dot.dataset.assetId;
        if (!id) { dot.className = 'power-dot-mini'; return; }
        var info = results[id];
        if (!info) { dot.className = 'power-dot-mini'; return; }
        dot.className = 'power-dot-mini pwr-' + info.status;
        dot.title = info.message + (info.bmc_ip ? ' (' + info.bmc_ip + ')' : '');
    });
}

// --- Power control in asset popup ---
function adpCheckPower(assetId) {
    // Find the rack ID for this asset from the DOM
    var rackId = adpFindRackId(assetId);
    if (!rackId) return;
    fetch('/racks/' + rackId + '/power-status')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var info = data[assetId];
            var badge = document.getElementById('adpPowerBadge');
            if (!badge) return;
            if (!info) {
                badge.textContent = 'BMC 미등록';
                badge.style.background = '#1e293b';
                return;
            }
            adpUpdatePowerBadge(badge, info.status);
        })
        .catch(function() {
            var badge = document.getElementById('adpPowerBadge');
            if (badge) { badge.textContent = '확인 실패'; badge.style.background = '#eab308'; }
        });
}

function adpFindRackId(assetId) {
    // Find the clickable-unit with this assetId and trace up to .wide-rack
    var el = document.querySelector('.clickable-unit[data-asset-id="' + assetId + '"]');
    if (el) {
        var rack = el.closest('.wide-rack');
        if (rack) return rack.dataset.rackId;
    }
    // Fallback: check cached data for rack_id
    if (adpCache[assetId] && adpCache[assetId].asset) return adpCache[assetId].asset.rack_id;
    return null;
}

function adpUpdatePowerBadge(badge, status) {
    var labels = { on: '전원 켜짐', off: '전원 꺼짐', error: '연결 실패', no_bmc: 'BMC 미등록', unknown: '알 수 없음' };
    var colors = { on: '#22c55e', off: '#ef4444', error: '#eab308', no_bmc: '#1e293b', unknown: '#94a3b8' };
    badge.textContent = labels[status] || status;
    badge.style.background = colors[status] || '#94a3b8';
}

function adpDoPowerControl(assetId, action) {
    var data = adpCache[assetId];
    var assetName = data ? (data.asset.management_number || data.asset.model_name || '') : '';
    var actionLabels = { on: '켜기', off: '끄기', reset: '재시작', cycle: '전원 순환' };

    if (action === 'off' || action === 'reset' || action === 'cycle') {
        if (!confirm((assetName || 'Asset') + ' 전원을 ' + (actionLabels[action] || action) + ' 하시겠습니까?')) return;
    }

    var msgEl = document.getElementById('adpPowerMsg');
    if (msgEl) { msgEl.textContent = '처리 중...'; msgEl.style.color = '#3b82f6'; }

    var rackId = adpFindRackId(assetId);
    if (!rackId) {
        if (msgEl) { msgEl.textContent = '랙 정보를 찾을 수 없습니다.'; msgEl.style.color = '#ef4444'; }
        return;
    }

    fetch('/racks/' + rackId + '/power-control', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ assetId: assetId, action: action })
    })
    .then(function(r) { return r.json(); })
    .then(function(result) {
        if (msgEl) {
            msgEl.textContent = result.message || (result.success ? '완료' : '실패');
            msgEl.style.color = result.success ? '#22c55e' : '#ef4444';
        }
        // Update badge in popup
        if (result.status) {
            var badge = document.getElementById('adpPowerBadge');
            if (badge) adpUpdatePowerBadge(badge, result.status);
        }
        // Update mini rack power dots
        if (result.status) {
            document.querySelectorAll('.power-dot-mini[data-asset-id="' + assetId + '"]').forEach(function(dot) {
                dot.className = 'power-dot-mini pwr-' + result.status;
                var labels = { on: '전원 켜짐', off: '전원 꺼짐' };
                dot.title = labels[result.status] || result.status;
            });
        }
    })
    .catch(function() {
        if (msgEl) { msgEl.textContent = '서버 통신 오류'; msgEl.style.color = '#ef4444'; }
    });
}
</script>

