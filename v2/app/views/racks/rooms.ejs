}
function srEditCredTab() {
    var id = srCurrentAssetId(); var data = adpCache[id]; if (!data) return;
    srCredDeleted = [];
    var creds = data.credentials || [];
    var rowsHtml = creds.map(srCredRow).join('');
    var html = '<table class="adp-table adp-edit-form"><tr><th>유형</th><th>사용자명</th><th>비밀번호</th><th>설명</th><th></th></tr>' +
        '<tbody id="srCredRows">' + rowsHtml + '</tbody></table>' +
        '<div class="adp-edit-bar"><button type="button" class="btn btn-xs btn-outline" onclick="document.getElementById(\'srCredRows\').insertAdjacentHTML(\'beforeend\', srCredRow())">+ 행 추가</button></div>' +
        srEditFooter('srSaveCreds()', 'access');
    document.getElementById('adpContent').innerHTML = html;
    srBeginEdit(id, 'access');
}
function srSaveCreds() {
    var ed = srEdit; if (!ed) return;
    var id = ed.id; var data = adpCache[id]; if (!data) return;   // B-6b: 편집 시작 대상 고정
    var creds = [];
    document.querySelectorAll('#srCredRows .sr-cred-row').forEach(function(tr){
        creds.push({ id: tr.dataset.id ? parseInt(tr.dataset.id,10) : null, credential_type: tr.querySelector('.sr-cred-type').value, username: tr.querySelector('.sr-cred-user').value.trim(), password: tr.querySelector('.sr-cred-pw').value, description: tr.querySelector('.sr-cred-desc').value.trim() });
    });
