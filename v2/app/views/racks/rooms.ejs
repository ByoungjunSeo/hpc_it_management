<%- include('../partials/header', { title, currentPath, extraCss }) %>

<div class="page-header">
    <h1>서버실 관리</h1>
    <button class="btn btn-primary" onclick="openModal('addRoomModal')">+ 서버실 추가</button>
</div>

<!-- Legend -->
<div class="card mini-rack-legend">
    <div class="legend-item"><span class="legend-color server"></span> 자사 서버</div>
    <div class="legend-item"><span class="legend-color vendor"></span> 업체 장비</div>
    <div class="legend-item"><span class="legend-color switch"></span> 스위치</div>
    <div class="legend-item"><span class="legend-color kvm"></span> KVM</div>
    <div class="legend-item"><span class="legend-color pdu"></span> PDU</div>
    <div class="legend-item"><span class="legend-color ups"></span> UPS</div>
    <div class="legend-item"><span class="legend-color storage"></span> 스토리지</div>
    <div class="legend-item"><span class="legend-color other"></span> 기타</div>
    <div class="legend-item"><span class="legend-color empty"></span> 빈 공간</div>
    <div class="legend-item"><span class="legend-color inactive-legend"></span> 비활성</div>
    <div class="legend-item"><span class="legend-color maintenance-legend"></span> 정비중</div>
    <div class="legend-item"><span class="legend-color immersion-legend"></span> &#x1F4A7; 액침탱크</div>
    <span style="margin-left:auto;display:flex;align-items:center;gap:10px;font-size:11px;color:var(--text-light);">
        <span style="display:flex;align-items:center;gap:3px;"><span style="width:6px;height:6px;border-radius:50%;background:#22c55e;display:inline-block;"></span>ON</span>
        <span style="display:flex;align-items:center;gap:3px;"><span style="width:6px;height:6px;border-radius:50%;background:#ef4444;display:inline-block;"></span>OFF</span>
        <span style="display:flex;align-items:center;gap:3px;"><span style="width:6px;height:6px;border-radius:50%;background:#1e293b;display:inline-block;"></span>BMC 미등록</span>
        <span style="display:flex;align-items:center;gap:3px;"><span style="width:6px;height:6px;border-radius:50%;background:#eab308;display:inline-block;"></span>연결실패</span>
    </span>
</div>

<!-- UX-3/UX-4: 서버실 검색 + 장비 목록 패널 토글 -->
<div class="sr-toolbar">
    <div class="sr-search">
        <input type="text" id="srSearchInput" class="form-control" autocomplete="off" placeholder="자산 검색 — 관리번호·자산번호·모델·시리얼·IP·담당자·용도">
        <div id="srSearchResults" class="sr-search-results"></div>
    </div>
    <div id="srMatchNav" class="sr-match-nav" style="display:none;">
        <button type="button" class="btn btn-sm btn-outline" onclick="srMatchMove(-1)">◀</button>
        <span id="srMatchLabel"></span>
        <button type="button" class="btn btn-sm btn-outline" onclick="srMatchMove(1)">▶</button>
    </div>
    <button type="button" id="srPanelToggleBtn" class="btn btn-sm btn-outline" onclick="srTogglePanel()" style="margin-left:auto;">&#9776; 장비 목록 보이기</button>
</div>
<div id="srToast" class="sr-toast" style="display:none;"></div>

<% if (rooms.length === 0) { %>
<div class="card text-center">
    <p class="text-muted">등록된 서버실이 없습니다. 서버실을 추가해주세요.</p>
</div>
<% } %>

<% rooms.forEach(room => { %>
<div class="room-section">
    <div class="room-section-header">
        <h2><a href="/rooms/<%= room.id %>"><%= room.name %></a></h2>
        <span class="text-muted"><%= room.location || '' %></span>
        <button class="btn btn-sm btn-warning power-check-btn" data-room-id="<%= room.id %>" data-rack-ids="<%= room.racks.map(r=>r.id).join(',') %>" onclick="checkRoomPower(this)" style="margin-left:8px;">&#x26A1; 전원 확인</button>
        <a href="/rooms/<%= room.id %>/assets" class="btn btn-sm btn-outline">자산 목록</a>
        <a href="/rooms/<%= room.id %>/modules" class="btn btn-sm btn-outline">모듈 현황</a>
        <button class="btn btn-sm btn-outline" onclick="openEditRoom(<%= room.id %>, '<%= (room.name || '').replace(/'/g, "\\'") %>', '<%= (room.location || '').replace(/'/g, "\\'") %>', '<%= (room.description || '').replace(/'/g, "\\'") %>', '<%= room.location_type || 'server_room' %>')">수정</button>
        <form method="POST" action="/rooms/<%= room.id %>/delete" style="display:inline" onsubmit="return confirmDelete('서버실과 포함된 모든 랙/장비가 삭제됩니다.')">
            <button type="submit" class="btn btn-sm btn-danger">삭제</button>
        </form>
    </div>

    <% if (room.stats) { %>
    <div class="room-stats-bar">
        <div class="room-stat">
            <span class="room-stat-value"><%= room.stats.rackCount %></span>
            <span class="room-stat-label">랙</span>
        </div>
        <div class="room-stat">
            <span class="room-stat-value"><%= room.stats.totalAssets %></span>
            <span class="room-stat-label">장비</span>
        </div>
        <div class="room-stat room-stat-util">
            <div class="room-util-bar">
                <div class="room-util-fill<%= room.stats.utilization >= 90 ? ' critical' : room.stats.utilization >= 70 ? ' warning' : '' %>" style="width:<%= room.stats.utilization %>%"></div>
            </div>
            <span class="room-stat-label"><%= room.stats.usedU %>/<%= room.stats.totalU %>U (<%= room.stats.utilization %>%)</span>
        </div>
        <% if (room.stats.typeCounts) { %>
        <div class="room-stat room-stat-types">
            <% var typeLabels = { server:'서버', switch:'스위치', storage:'스토리지', pdu:'PDU', ups:'UPS', kvm:'KVM', other:'기타' }; %>
            <% Object.keys(room.stats.typeCounts).forEach(function(t) { %>
            <span class="room-type-chip <%= t %>"><%= typeLabels[t] || t %> <%= room.stats.typeCounts[t] %></span>
            <% }) %>
        </div>
        <% } %>
    </div>
    <% } %>

    <% if (room.racks.length === 0) { %>
    <p class="text-muted" style="padding: 12px 0;">등록된 랙이 없습니다.</p>
    <% } else { %>
    <div class="wide-rack-row">
        <% room.racks.forEach(function(rack, rackIdx) { %>
        <%
            const totalUnits = rack.totalUnits || rack.total_units || 42;
            const uMapData = rack.uMap || {};
            // Blade-aware usedU: count unique U positions occupied
            var _occU = {};
            rack.assetList.forEach(a => { if (a.rack_unit_start && !a.parent_asset_id && a.status === 'active') { var su = Math.floor((a.rack_unit_start-1)/3)+1; var sz = Math.ceil((a.rack_unit_size||3)/3); for(var _u=su;_u<su+sz;_u++) _occU[_u]=true; }});
            let usedU = Object.keys(_occU).length;
            function statusCls(info) {
                if (!info || !info.status) return '';
                if (info.status === 'inactive') return ' inactive';
                if (info.status === 'maintenance') return ' maintenance';
                if (info.status === 'decommissioned') return ' inactive';
                return '';
            }
            function wCls(info) {
                if (!info) return 'server';
                if (info.asset_type === 'switch') return 'switch';
                if (info.asset_type === 'kvm') return 'kvm';
                if (info.asset_type === 'pdu') return 'pdu';
                if (info.asset_type === 'ups') return 'ups';
                if (info.asset_type === 'storage') return 'storage';
                if (info.asset_type === 'other') return 'other';
                if (info.ownership === 'vendor') return 'vendor';
                return 'server';
            }
        %>
        <div class="wide-rack wide-rack-draggable" draggable="true"
             data-rack-id="<%= rack.id %>" data-rack-type="<%= rack.rack_type || 'standard' %>" data-order="<%= rackIdx %>">
            <div class="wide-rack-header">
                <span class="drag-handle">&#x2630;</span>
                <% if (rack.rack_type === 'immersion') { %>&#x1F4A7; <% } else if (rack.rack_type === 'dlc') { %>&#x2744; <% } %><%= rack.name %>
                <% if (rack.rack_type === 'immersion') { %><span class="rack-type-badge immersion">액침</span><% } else if (rack.rack_type === 'dlc') { %><span class="rack-type-badge dlc">DLC</span><% } %>
                <span class="wide-rack-summary"><%= usedU %>/<%= totalUnits %>U</span>
            </div>
            <%
                let mSkipL = 0, mSkipR = 0;
            %>
            <table class="mini-rack-table">
                <% for (let u = totalUnits; u >= 1; u--) { %>
                <%
                    const entry = uMapData[u];
                    const hasFull = entry && entry.full;
                    const hasBlade = !hasFull && entry && (entry.left || entry.right);
                    const isEmpty = !hasFull && !hasBlade;
                    let mEmitL = true, mEmitR = true;
                    if (mSkipL > 0) { mEmitL = false; mSkipL--; }
                    if (mSkipR > 0) { mEmitR = false; mSkipR--; }
                %>
                <tr data-u="<%= u %>">
                    <td class="mini-u-num">U<%= u %></td>
<% if (hasFull && mEmitL) {
    const f = entry.full;
    mSkipL = f.sizeU - 1;
    mSkipR = f.sizeU - 1;
%>
                    <td class="mini-u-asset <%= wCls(f) %><%= statusCls(f) %> clickable-unit" colspan="2" rowspan="<%= f.sizeU %>"
                        data-asset-id="<%= f.asset_id %>" data-asset-type="<%= f.asset_type %>"
                        title="<%= (f.name || f.asset_type) + (f.management_number ? ' (' + f.management_number + ')' : '') + (f.status === 'inactive' ? ' [비활성]' : f.status === 'maintenance' ? ' [정비중]' : '') %>">
                        <span class="mini-asset-name"><%= f.name || f.asset_type %><% if (f.management_number) { %> (<%= f.management_number %>)<% } %></span>
                        <span class="power-dot-mini" data-asset-id="<%= f.asset_id %>"></span>
                    </td>
<% } else if (hasBlade) {
    if (mEmitL) {
        if (entry.left) {
            mSkipL = entry.left.sizeU - 1;
%>
                    <td class="mini-u-asset mini-blade <%= wCls(entry.left) %><%= statusCls(entry.left) %> clickable-unit" rowspan="<%= entry.left.sizeU %>"
                        data-asset-id="<%= entry.left.asset_id %>" data-asset-type="<%= entry.left.asset_type %>"
                        title="<%= (entry.left.name || '') + (entry.left.management_number ? ' (' + entry.left.management_number + ')' : '') + (entry.left.status === 'inactive' ? ' [비활성]' : entry.left.status === 'maintenance' ? ' [정비중]' : '') %>">
                        <span class="mini-asset-name"><%= entry.left.name || '' %><% if (entry.left.management_number) { %> (<%= entry.left.management_number %>)<% } %></span>
                        <span class="power-dot-mini" data-asset-id="<%= entry.left.asset_id %>"></span>
                    </td>
<%      } else { %>
                    <td class="mini-u-asset mini-blade mini-empty"></td>
<%      }
    }
    if (mEmitR) {
        if (entry.right) {
            mSkipR = entry.right.sizeU - 1;
%>
                    <td class="mini-u-asset mini-blade <%= wCls(entry.right) %><%= statusCls(entry.right) %> clickable-unit" rowspan="<%= entry.right.sizeU %>"
                        data-asset-id="<%= entry.right.asset_id %>" data-asset-type="<%= entry.right.asset_type %>"
                        title="<%= (entry.right.name || '') + (entry.right.management_number ? ' (' + entry.right.management_number + ')' : '') + (entry.right.status === 'inactive' ? ' [비활성]' : entry.right.status === 'maintenance' ? ' [정비중]' : '') %>">
                        <span class="mini-asset-name"><%= entry.right.name || '' %><% if (entry.right.management_number) { %> (<%= entry.right.management_number %>)<% } %></span>
                        <span class="power-dot-mini" data-asset-id="<%= entry.right.asset_id %>"></span>
                    </td>
<%      } else { %>
                    <td class="mini-u-asset mini-blade mini-empty"></td>
<%      }
    }
} else if (isEmpty) {
    if (mEmitL && mEmitR) { %>
                    <td class="mini-u-asset mini-empty" colspan="2"></td>
<%  } else {
        if (mEmitL) { %>
                    <td class="mini-u-asset mini-blade mini-empty"></td>
<%      }
        if (mEmitR) { %>
                    <td class="mini-u-asset mini-blade mini-empty"></td>
<%      }
    }
} %>
                </tr>
                <% } %>
            </table>
            <a href="/racks/<%= rack.id %>" class="wide-rack-link">상세 보기</a>
        </div>
        <% }) %>
    </div>
    <% } %>
</div>
<% }) %>

<!-- Add Room Modal -->
<div class="modal-overlay" id="addRoomModal">
    <div class="modal">
        <div class="modal-header">
            <h3>서버실 추가</h3>
            <button class="modal-close" onclick="closeModal('addRoomModal')">&times;</button>
        </div>
        <form method="POST" action="/rooms">
            <div class="form-group">
                <label>서버실 이름 *</label>
                <input type="text" name="name" class="form-control" required placeholder="예: AIDC, HPC">
            </div>
            <div class="form-group">
                <label>위치</label>
                <input type="text" name="location" class="form-control" placeholder="예: 3층 A동">
            </div>
            <div class="form-group">
                <label>설명</label>
                <textarea name="description" class="form-control"></textarea>
            </div>
            <input type="hidden" name="location_type" value="server_room">
            <div class="btn-group">
                <button type="submit" class="btn btn-primary">추가</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal('addRoomModal')">취소</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Room Modal -->
<div class="modal-overlay" id="editRoomModal">
    <div class="modal">
        <div class="modal-header">
            <h3>서버실 수정</h3>
            <button class="modal-close" onclick="closeModal('editRoomModal')">&times;</button>
        </div>
        <form method="POST" id="editRoomForm" action="">
            <div class="form-group">
                <label>서버실 이름 *</label>
                <input type="text" name="name" id="editRoomName" class="form-control" required>
            </div>
            <div class="form-group">
                <label>위치</label>
                <input type="text" name="location" id="editRoomLocation" class="form-control">
            </div>
            <div class="form-group">
                <label>설명</label>
                <textarea name="description" id="editRoomDesc" class="form-control"></textarea>
            </div>
            <div class="form-group">
                <label>위치 유형</label>
                <select name="location_type" id="editRoomType" class="form-control">
                    <% appConfig.locationTypes.forEach(t => { %>
                    <option value="<%= t.value %>"><%= t.label %></option>
                    <% }) %>
                </select>
            </div>
            <div class="btn-group">
                <button type="submit" class="btn btn-primary">수정</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal('editRoomModal')">취소</button>
            </div>
        </form>
    </div>
</div>

<!-- UX-4/B-1c: 장비 목록 슬라이드 패널 (기본 열림 — 조기 스크립트가 선호·화면폭으로 보정) -->
<div id="srPanel" class="sr-panel open">
    <div class="sr-panel-head">
        <strong>장비 목록</strong>
        <select id="srPanelRoom" class="form-control sr-panel-room" onchange="srPanelReload()"></select>
        <button type="button" class="btn btn-xs btn-outline sr-panel-hide" onclick="srSetPanel(false, true)">숨기기</button>
        <button type="button" class="sr-panel-close" onclick="srSetPanel(false, true)" aria-label="닫기">&times;</button>
    </div>
    <div class="sr-panel-chips" id="srPanelChips"></div>
    <input type="text" id="srPanelFilter" class="form-control sr-panel-filter" autocomplete="off" placeholder="필터 — 관리번호·모델·IP·모듈(예: H100)" oninput="srPanelFilterInput()">
    <div class="sr-panel-list" id="srPanelList"><p class="text-muted" style="padding:12px;">서버실을 선택하세요.</p></div>
</div>
<script>
// B-1c 깜박임 방지: 패널이 파싱된 직후(첫 페인트 전) 선호값·화면폭으로 .open/.split 선적용.
//   방식 근거: 패널 마크업에 open 기본 부여 → 흔한 경우(열림) 슬라이드 없이 즉시 표시,
//   hidden/좁은화면이면 여기서 즉시 open 제거 → 역슬라이드/본문 reflow 깜박임 없음.
(function(){
    var pref = null;
    try {
        pref = localStorage.getItem('rooms.panel.pref');
        if (pref === null) { var old = localStorage.getItem('srPanelOpen'); if (old !== null) { pref = (old === '1') ? 'shown' : 'hidden'; localStorage.setItem('rooms.panel.pref', pref); localStorage.removeItem('srPanelOpen'); } }
    } catch (e) { pref = null; }
    var open = (window.innerWidth >= 1100) && (pref !== 'hidden');  // 오버레이(<1100)는 선호 무관 기본 닫힘
    var panel = document.getElementById('srPanel');
    if (open) { document.body.classList.add('rooms-panel-split'); }
    else if (panel) { panel.classList.remove('open'); }
})();
</script>

<!-- Asset Detail Popup -->
<div class="modal-overlay" id="assetDetailPopup">
    <div class="modal" style="max-width:700px;max-height:85vh;display:flex;flex-direction:column;">
        <div class="modal-header">
            <h3 id="adpTitle">장비 정보</h3>
            <button class="modal-close" onclick="closeModal('assetDetailPopup')">&times;</button>
        </div>
        <div class="adp-tabs" style="display:flex;border-bottom:1px solid var(--border);padding:0 16px;gap:0;">
            <button class="adp-tab active" data-tab="basic" onclick="switchAdpTab('basic')">기본정보</button>
            <button class="adp-tab" data-tab="ip" onclick="switchAdpTab('ip')">IP정보</button>
            <button class="adp-tab" data-tab="access" onclick="switchAdpTab('access')">접속정보</button>
            <button class="adp-tab" data-tab="ops" onclick="switchAdpTab('ops')">운영정보</button>
            <button class="adp-tab" data-tab="modules" onclick="switchAdpTab('modules')">컴퓨팅 모듈</button>
            <button class="adp-tab" data-tab="power" onclick="switchAdpTab('power')" id="adpPowerTab" style="display:none;">전원</button>
        </div>
        <div id="adpContent" style="padding:16px;overflow-y:auto;flex:1;">
            <p class="text-muted">로딩중...</p>
        </div>
        <div style="padding:8px 16px;border-top:1px solid var(--border);display:flex;gap:8px;">
            <a id="adpDetailLink" href="#" class="btn btn-primary btn-sm">상세 페이지</a>
            <a id="adpEditLink" href="#" class="btn btn-outline btn-sm">수정</a>
            <button class="btn btn-secondary btn-sm" onclick="closeModal('assetDetailPopup')" style="margin-left:auto;">닫기</button>
        </div>
    </div>
</div>

<script>
// --- Wide rack drag-and-drop (horizontal swap) ---
(function() {
    var dragSrcEl = null;

    document.querySelectorAll('.wide-rack-draggable').forEach(function(el) {
        el.addEventListener('dragstart', function(e) {
            dragSrcEl = this;
            this.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', this.dataset.rackId);
        });
        el.addEventListener('dragend', function() {
            this.classList.remove('dragging');
            document.querySelectorAll('.wide-rack-draggable').forEach(function(z) {
                z.classList.remove('drag-over');
            });
        });
        el.addEventListener('dragover', function(e) {
            if (this === dragSrcEl) return;
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            this.classList.add('drag-over');
        });
        el.addEventListener('dragleave', function() {
            this.classList.remove('drag-over');
        });
        el.addEventListener('drop', function(e) {
            e.preventDefault();
            this.classList.remove('drag-over');
            if (!dragSrcEl || this === dragSrcEl) return;
            // Swap DOM positions
            var parent = dragSrcEl.parentNode;
            var srcNext = dragSrcEl.nextElementSibling;
            if (srcNext === this) {
                parent.insertBefore(this, dragSrcEl);
            } else {
                var tgtNext = this.nextElementSibling;
                parent.insertBefore(dragSrcEl, this);
                if (tgtNext) {
                    // srcNext could be null if src was last
                    parent.insertBefore(this, srcNext);
                } else {
                    parent.appendChild(this);
                }
            }
            // Save new col_position for all racks in this row
            var racks = parent.querySelectorAll('.wide-rack-draggable');
            racks.forEach(function(r, idx) {
                var col = idx + 1;
                r.dataset.order = idx;
                fetch('/racks/' + r.dataset.rackId + '/position', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ row_position: 1, col_position: col })
                });
            });
        });
    });
})();

// --- Asset popup ---
var adpCache = {};
var adpCurrentTab = 'basic';

document.querySelectorAll('.clickable-unit').forEach(function(el) {
    el.addEventListener('click', function(e) {
        e.stopPropagation();
        var assetId = this.dataset.assetId;
        if (assetId) openAssetPopup(parseInt(assetId));
    });
});

function openAssetPopup(assetId) {
    document.getElementById('adpTitle').textContent = '로딩중...';
    document.getElementById('adpContent').innerHTML = '<p class="text-muted">로딩중...</p>';
    document.getElementById('adpDetailLink').href = '/assets/' + assetId;
    document.getElementById('adpEditLink').href = '/assets/' + assetId + '/edit?returnTo=' + encodeURIComponent(location.pathname + location.search);
    adpCurrentTab = 'basic';
    document.querySelectorAll('.adp-tab').forEach(function(t) { t.classList.toggle('active', t.dataset.tab === 'basic'); });
    openModal('assetDetailPopup');

    fetch('/assets/' + assetId + '/json')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            adpCache[assetId] = data;
            renderAdp(data);
        })
        .catch(function() {
            document.getElementById('adpContent').innerHTML = '<p style="color:#ef4444;">데이터를 불러올 수 없습니다.</p>';
        });
}

function renderAdp(data) {
    var a = data.asset;
    document.getElementById('adpTitle').textContent = a.model_name || a.asset_type || '장비 정보';
    // Show/hide power tab based on asset type and BMC availability
    var powerTab = document.getElementById('adpPowerTab');
    var powerTypes = ['server', 'storage', 'switch', 'kvm', 'other'];
    var hasBmc = data.assetIps && data.assetIps.some(function(ip) { return ip.ip_type === 'bmc'; });
    if (powerTab) {
        powerTab.style.display = (powerTypes.indexOf(a.asset_type) !== -1 && hasBmc) ? '' : 'none';
    }
    renderAdpTab(data, adpCurrentTab);
}

function switchAdpTab(tab) {
    adpCurrentTab = tab;
    document.querySelectorAll('.adp-tab').forEach(function(t) { t.classList.toggle('active', t.dataset.tab === tab); });
    var assetId = parseInt(document.getElementById('adpDetailLink').href.split('/assets/')[1]);
    if (adpCache[assetId]) renderAdpTab(adpCache[assetId], tab);
}

function renderAdpTab(data, tab) {
    var a = data.asset;
    var html = '';

    if (tab === 'basic') {
        html = '<table class="adp-table">' +
            tr('자산번호', a.asset_number) +
            tr('관리번호', a.management_number) +
            tr('유형', typeLabel(a.asset_type)) +
            tr('소유', a.ownership === 'company' ? '자사' : '업체' + (a.vendor_name ? ' (' + esc(a.vendor_name) + ')' : '')) +
            tr('제조사', a.manufacturer) +
            tr('모델명', a.model_name) +
            tr('시리얼', a.serial_number) +
            tr('상태', statusLabel(a.status)) +
            tr('서버실', a.room_name) +
            tr('랙', a.rack_name) +
            tr('U위치', a.rack_unit_start ? 'U' + (Math.floor((a.rack_unit_start - 1) / 3) + 1) + ((a.rack_unit_size || 3) > 3 ? ' ~ U' + (Math.floor((a.rack_unit_start + (a.rack_unit_size || 3) - 2) / 3) + 1) : '') : '-') +
            '</table>';
        if (srCanEdit()) html += srEditBar('basic');   // UX-2: 빠른 편집 토글
    } else if (tab === 'ip') {
        if (data.assetIps && data.assetIps.length > 0) {
            html = '<table class="adp-table"><tr><th>유형</th><th>인터페이스</th><th>속도</th><th>IP 주소</th><th>설명</th></tr>';
            data.assetIps.forEach(function(ip) {
                html += '<tr><td>' + esc(ipTypeLabel(ip)) + '</td><td>' + esc(ip.interface_type || '-') + '</td><td>' + esc(ip.speed || '-') + '</td><td><strong>' + esc(ip.ip_address) + '</strong></td><td>' + esc((ip.ip_type !== 'other' && ip.description) ? ip.description : '') + '</td></tr>';
            });
            html += '</table>';
        } else if (a.ip_address) {
            html = '<table class="adp-table">' + tr('IP 주소', a.ip_address) + tr('SSH 포트', a.ssh_port) + '</table>';
        } else {
            html = '<p class="text-muted">등록된 IP 정보가 없습니다.</p>';
        }
        if (srCanEdit()) html += srEditBar('ip');   // B-2b
    } else if (tab === 'access') {
        if (data.credentials && data.credentials.length > 0) {
            html = '<table class="adp-table"><tr><th>유형</th><th>사용자</th><th>비밀번호</th><th>설명</th></tr>';
            data.credentials.forEach(function(c) {
                // BL-11 후속: 비번 값 미포함(has_password). CSS 가림(pw-hide) 대신 [보기] API 조회.
                var pwCell = c.has_password
                    ? '<span class="cred-cell" data-asset="' + a.id + '" data-cred="' + c.id + '" data-shown="0"><code class="cred-mask">●●●●●●</code> <button type="button" class="btn btn-sm btn-outline cred-reveal" onclick="revealCredential(this)">보기</button> <button type="button" class="btn btn-sm btn-outline cred-copy" onclick="copyCredential(this)" hidden>복사</button></span>'
                    : '<span style="color:#94a3b8;">-</span>';
                html += '<tr><td>' + esc(credTypeLabel(c.credential_type)) + '</td><td>' + esc(c.username) + '</td><td>' + pwCell + '</td><td>' + esc(c.description || '') + '</td></tr>';
            });
            html += '</table>';
        } else if (a.ssh_user) {
            // 레거시 ssh_user 표시(마이그레이션 후 ssh_password는 응답에서 제거됨)
            html = '<table class="adp-table">' +
                tr('SSH 사용자', a.ssh_user) +
                tr('SSH 포트', a.ssh_port) +
                '</table>';
        } else {
            html = '<p class="text-muted">등록된 접속 정보가 없습니다.</p>';
        }
        if (srCanEdit()) html += srEditBar('access');   // B-2b
    } else if (tab === 'ops') {
        html = '<table class="adp-table">' +
            tr('담당자', a.assigned_user) +
            tr('용도', a.purpose) +
            tr('구매일', a.purchase_date) +
            tr('보증만료', a.warranty_end) +
            tr('비고', a.notes) +
            '</table>';
        if (srCanEdit()) html += srEditBar('ops');   // UX-2: 빠른 편집 토글
    } else if (tab === 'modules') {
        if (data.modules && data.modules.length > 0) {
            var types = { cpu: 'CPU', memory: '메모리', disk: '디스크', network: 'NIC', raid: 'RAID', gpu: 'GPU' };
            html = '<table class="adp-table"><tr><th>유형</th><th>모델</th><th>제조사</th><th>용량</th><th>수량</th><th>슬롯</th><th>소유</th></tr>';
            data.modules.forEach(function(m) {
                // UX-1(F1): 모듈 소유 표시 — 상세(detail.ejs)와 동일. vendor=업체명 배지, 그 외(NULL 포함)=자사.
                var ownerBadge = (m.owner === 'vendor')
                    ? '<span class="badge badge-warning">' + esc(m.owner_vendor_name || '업체') + '</span>'
                    : '<span class="badge badge-success">자사</span>';
                html += '<tr><td><span class="badge">' + (types[m.module_type] || m.module_type) + '</span></td><td>' + esc(m.model || '') + '</td><td>' + esc(m.manufacturer || '') + '</td><td>' + esc(m.capacity || '') + '</td><td>' + (m.count || 1) + '</td><td>' + esc(m.slot_info || '') + '</td><td>' + ownerBadge + '</td></tr>';
            });
            html += '</table>';
        } else {
            html = '<p class="text-muted">등록된 컴퓨팅 모듈이 없습니다.</p>';
        }
    } else if (tab === 'power') {
        var assetId = a.id;
        html = '<div id="adpPowerContent">' +
            '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">' +
            '<label style="font-weight:600;font-size:13px;margin:0;">현재 전원 상태</label>' +
            '<span id="adpPowerBadge" style="font-size:11px;padding:2px 10px;border-radius:10px;background:#94a3b8;color:white;">확인 중...</span>' +
            '</div>' +
            '<div style="display:flex;gap:8px;margin-bottom:12px;">' +
            '<button class="btn btn-sm" style="background:#22c55e;color:white;flex:1;padding:8px;" onclick="adpDoPowerControl(' + assetId + ',\'on\')">&#x23FB; 켜기</button>' +
            '<button class="btn btn-sm" style="background:#ef4444;color:white;flex:1;padding:8px;" onclick="adpDoPowerControl(' + assetId + ',\'off\')">&#x23FB; 끄기</button>' +
            '<button class="btn btn-sm" style="background:#f59e0b;color:white;flex:1;padding:8px;" onclick="adpDoPowerControl(' + assetId + ',\'reset\')">&#x21BB; 재시작</button>' +
            '</div>' +
            '<div id="adpPowerMsg" style="font-size:12px;color:#64748b;min-height:20px;"></div>' +
            '</div>';
        // Auto-check power status
        setTimeout(function() { adpCheckPower(assetId); }, 100);
    }

    document.getElementById('adpContent').innerHTML = html;
}

function tr(label, val) {
    return '<tr><td><strong>' + label + '</strong></td><td>' + esc(val || '-') + '</td></tr>';
}
function esc(s) { if (!s) return ''; var d = document.createElement('div'); d.textContent = String(s); return d.innerHTML; }
function typeLabel(t) { var m = { server:'서버', switch:'스위치', kvm:'KVM', pdu:'PDU', ups:'UPS', storage:'스토리지', immersion_tank:'액침탱크', cdu:'CDU', chiller:'칠러', other:'기타' }; return m[t] || t || '-'; }
function statusLabel(s) { var m = { active:'운영중', inactive:'비활성', maintenance:'점검중', decommissioned:'폐기' }; return m[s] || s || '-'; }
function ipTypeLabel(ip) { var m = { management:'Management', bmc:'BMC', ib:'InfiniBand', data:'Data', os:'OS', other:'기타' }; return (ip.ip_type === 'other' && ip.description) ? ip.description : (m[ip.ip_type] || ip.ip_type || '-'); }
function credTypeLabel(t) { var m = { root:'Root', user:'User', admin:'Admin', bmc:'BMC', etc:'기타' }; return m[t] || t || '-'; }

function openEditRoom(id, name, location, desc, type) {
    document.getElementById('editRoomForm').action = '/rooms/' + id + '/edit';
    document.getElementById('editRoomName').value = name;
    document.getElementById('editRoomLocation').value = location;
    document.getElementById('editRoomDesc').value = desc;
    document.getElementById('editRoomType').value = type;
    openModal('editRoomModal');
}

// --- Power status check per room ---
function checkRoomPower(btn) {
    var rackIds = (btn.dataset.rackIds || '').split(',').filter(Boolean);
    if (rackIds.length === 0) return;
    btn.disabled = true;
    btn.innerHTML = '&#x26A1; 확인 중...';

    // Show loading on all power dots in this room section
    var section = btn.closest('.room-section');
    section.querySelectorAll('.power-dot-mini').forEach(function(d) {
        d.className = 'power-dot-mini loading';
    });

    var allResults = {};
    var done = 0;
    rackIds.forEach(function(rackId) {
        fetch('/racks/' + rackId + '/power-status')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                Object.assign(allResults, data);
            })
            .catch(function() {})
            .finally(function() {
                done++;
                if (done >= rackIds.length) {
                    applyPowerResults(section, allResults);
                    btn.innerHTML = '&#x26A1; 확인 완료';
                }
            });
    });
}

function applyPowerResults(section, results) {
    section.querySelectorAll('.power-dot-mini').forEach(function(dot) {
        var id = dot.dataset.assetId;
        if (!id) { dot.className = 'power-dot-mini'; return; }
        var info = results[id];
        if (!info) { dot.className = 'power-dot-mini'; return; }
        dot.className = 'power-dot-mini pwr-' + info.status;
        dot.title = info.message + (info.bmc_ip ? ' (' + info.bmc_ip + ')' : '');
    });
}

// --- Power control in asset popup ---
function adpCheckPower(assetId) {
    // Find the rack ID for this asset from the DOM
    var rackId = adpFindRackId(assetId);
    if (!rackId) return;
    fetch('/racks/' + rackId + '/power-status')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var info = data[assetId];
            var badge = document.getElementById('adpPowerBadge');
            if (!badge) return;
            if (!info) {
                badge.textContent = 'BMC 미등록';
                badge.style.background = '#1e293b';
                return;
            }
            adpUpdatePowerBadge(badge, info.status);
        })
        .catch(function() {
            var badge = document.getElementById('adpPowerBadge');
            if (badge) { badge.textContent = '확인 실패'; badge.style.background = '#eab308'; }
        });
}

function adpFindRackId(assetId) {
    // Find the clickable-unit with this assetId and trace up to .wide-rack
    var el = document.querySelector('.clickable-unit[data-asset-id="' + assetId + '"]');
    if (el) {
        var rack = el.closest('.wide-rack');
        if (rack) return rack.dataset.rackId;
    }
    // Fallback: check cached data for rack_id
    if (adpCache[assetId] && adpCache[assetId].asset) return adpCache[assetId].asset.rack_id;
    return null;
}

function adpUpdatePowerBadge(badge, status) {
    var labels = { on: '전원 켜짐', off: '전원 꺼짐', error: '연결 실패', no_bmc: 'BMC 미등록', unknown: '알 수 없음' };
    var colors = { on: '#22c55e', off: '#ef4444', error: '#eab308', no_bmc: '#1e293b', unknown: '#94a3b8' };
    badge.textContent = labels[status] || status;
    badge.style.background = colors[status] || '#94a3b8';
}

function adpDoPowerControl(assetId, action) {
    var data = adpCache[assetId];
    var assetName = data ? (data.asset.management_number || data.asset.model_name || '') : '';
    var actionLabels = { on: '켜기', off: '끄기', reset: '재시작', cycle: '전원 순환' };

    if (action === 'off' || action === 'reset' || action === 'cycle') {
        if (!confirm((assetName || 'Asset') + ' 전원을 ' + (actionLabels[action] || action) + ' 하시겠습니까?')) return;
    }

    var msgEl = document.getElementById('adpPowerMsg');
    if (msgEl) { msgEl.textContent = '처리 중...'; msgEl.style.color = '#3b82f6'; }

    var rackId = adpFindRackId(assetId);
    if (!rackId) {
        if (msgEl) { msgEl.textContent = '랙 정보를 찾을 수 없습니다.'; msgEl.style.color = '#ef4444'; }
        return;
    }

    fetch('/racks/' + rackId + '/power-control', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ assetId: assetId, action: action })
    })
    .then(function(r) { return r.json(); })
    .then(function(result) {
        if (msgEl) {
            msgEl.textContent = result.message || (result.success ? '완료' : '실패');
            msgEl.style.color = result.success ? '#22c55e' : '#ef4444';
        }
        // Update badge in popup
        if (result.status) {
            var badge = document.getElementById('adpPowerBadge');
            if (badge) adpUpdatePowerBadge(badge, result.status);
        }
        // Update mini rack power dots
        if (result.status) {
            document.querySelectorAll('.power-dot-mini[data-asset-id="' + assetId + '"]').forEach(function(dot) {
                dot.className = 'power-dot-mini pwr-' + result.status;
                var labels = { on: '전원 켜짐', off: '전원 꺼짐' };
                dot.title = labels[result.status] || result.status;
            });
        }
    })
    .catch(function() {
        if (msgEl) { msgEl.textContent = '서버 통신 오류'; msgEl.style.color = '#ef4444'; }
    });
}
</script>

<script>
// ===== UX-3(F3) 서버실 검색·위치강조 + UX-4(F4) 장비 목록 패널 =====
var SR_ROOMS = <%- JSON.stringify(rooms.map(function(r){ return { id: r.id, name: r.name }; })) %>;
var SR_ROLE = '<%= (typeof currentUser !== "undefined" && currentUser) ? currentUser.role : "" %>';  // UX-2: 편집 UI 게이팅
function srCanEdit() { return SR_ROLE === 'admin' || SR_ROLE === 'maintenance'; }
var srLastResults = [];
var srMatches = [];
var srMatchIdx = -1;
var srHlTimer = null;
var srToastTimer = null;
var SR_TYPE_LABELS = { server:'서버', switch:'스위치', kvm:'KVM', pdu:'PDU', ups:'UPS', storage:'스토리지', immersion_tank:'액침탱크', cdu:'CDU', chiller:'칠러', other:'기타' };
var SR_STATUS_LABELS = { active:'운영중', inactive:'비활성', maintenance:'점검중', decommissioned:'폐기', returned:'반납' };

function srShowToast(msg) {
    var t = document.getElementById('srToast');
    if (!t) return;
    t.textContent = msg;
    t.style.display = '';
    clearTimeout(srToastTimer);
    srToastTimer = setTimeout(function(){ t.style.display = 'none'; }, 4000);
}

// 공용: 자산 id → 서버실 화면에서 랙 셀로 스크롤 + 강조. DOM에 없으면(미배치) 안내.
function locateAsset(assetId) {
    assetId = parseInt(assetId);
    document.querySelectorAll('.sr-highlight').forEach(function(h){ h.classList.remove('sr-highlight'); });
    var cells = document.querySelectorAll('.clickable-unit[data-asset-id="' + assetId + '"]');
    if (cells.length) {
        var rack = cells[0].closest('.wide-rack');
        if (rack) rack.scrollIntoView({ inline: 'center', block: 'center', behavior: 'smooth' });
        cells.forEach(function(c){ c.classList.add('sr-highlight'); });
        clearTimeout(srHlTimer);
        srHlTimer = setTimeout(function(){ document.querySelectorAll('.sr-highlight').forEach(function(h){ h.classList.remove('sr-highlight'); }); }, 4000);
        return true;
    }
    // DOM 미발견 → 블레이드 노드(부모 섀시 셀로 안내) 또는 진짜 미배치(상태 안내)
    fetch('/assets/' + assetId + '/json').then(function(r){ return r.ok ? r.json() : null; }).then(function(d){
        if (!d || !d.asset) { srShowToast('이 서버실 화면에서 위치를 찾을 수 없습니다.'); return; }
        var pid = d.asset.parent_asset_id;
        if (pid) {
            var pcells = document.querySelectorAll('.clickable-unit[data-asset-id="' + pid + '"]');
            if (pcells.length) {
                var prack = pcells[0].closest('.wide-rack');
                if (prack) prack.scrollIntoView({ inline: 'center', block: 'center', behavior: 'smooth' });
                pcells.forEach(function(c){ c.classList.add('sr-highlight'); });
                clearTimeout(srHlTimer);
                srHlTimer = setTimeout(function(){ document.querySelectorAll('.sr-highlight').forEach(function(h){ h.classList.remove('sr-highlight'); }); }, 4000);
                var pname = d.parent ? (d.parent.management_number || d.parent.model_name || ('#' + pid)) : ('#' + pid);
                srShowToast('블레이드 노드 — 부모 섀시(' + pname + ') 위치에 표시했습니다.');
                return;
            }
        }
        var st = SR_STATUS_LABELS[d.asset.status] || d.asset.status || '-';
        srShowToast('랙에 배치되지 않은 자산입니다 (상태: ' + st + ').');
    }).catch(function(){ srShowToast('이 서버실 화면에서 위치를 찾을 수 없습니다.'); });
    return false;
}

// 다중 매칭 이동
var srAllActive = false;
// B-4: [모두 표시] — 현재 결과 중 이 페이지 랙에 있는 장비 전부 동시 강조(토글). 미배치 수 안내.
function srShowAll() {
    if (srAllActive) { document.querySelectorAll('.sr-highlight').forEach(function(h){ h.classList.remove('sr-highlight'); }); srAllActive = false; srShowToast('강조 해제'); return; }
    document.querySelectorAll('.sr-highlight').forEach(function(h){ h.classList.remove('sr-highlight'); });
    var onPage = 0, off = 0, firstRack = null;
    (srLastResults || []).forEach(function(d){
        var cells = document.querySelectorAll('.clickable-unit[data-asset-id="' + d.id + '"]');
        if (cells.length) { onPage++; cells.forEach(function(c){ c.classList.add('sr-highlight'); }); if (!firstRack) firstRack = cells[0].closest('.wide-rack'); }
        else off++;
    });
    if (firstRack) firstRack.scrollIntoView({ inline: 'center', block: 'center', behavior: 'smooth' });
    clearTimeout(srHlTimer);   // 모두표시는 자동 해제하지 않음(재클릭/검색변경 시 해제)
    srAllActive = onPage > 0;
    srShowToast('강조 ' + onPage + '대' + (off ? (' / 랙 미배치 ' + off + '대') : ''));
}
function srMatchMove(delta) {
    if (!srMatches.length) return;
    srMatchIdx = (srMatchIdx + delta + srMatches.length) % srMatches.length;
    document.getElementById('srMatchLabel').textContent = (srMatchIdx + 1) + '/' + srMatches.length;
    locateAsset(srMatches[srMatchIdx]);
}

// 공용: matchedModules 요약 줄(업체 소유 배지 포함). 검색 드롭다운·장비 패널 공용(복제 방지).
function srModLine(mm){
    if (!mm || !mm.lines || !mm.lines.length) return '';
    var parts = mm.lines.map(function(m){
        var own = (m.owner === 'vendor') ? ' <span class="badge badge-warning">' + esc(m.owner_vendor_name || '업체') + '</span>' : '';
        return esc((m.module_type||'').toUpperCase() + ' ' + (m.model || m.capacity || '') + ' ×' + m.count) + own;
    });
    return '<div class="sr-sr-mod">' + parts.join(', ') + (mm.extra ? (' 외 ' + mm.extra + '종') : '') + '</div>';
}

// 검색 드롭다운
(function(){
    var input = document.getElementById('srSearchInput');
    var box = document.getElementById('srSearchResults');
    if (!input) return;
    var timer;
    var flat = [], selIdx = -1;
    // B-4b 1-1: /rooms 검색은 locateUrl 있으면 강조 이동, 없으면 상세 페이지.
    function srActivate(d){
        if (!d) return;
        box.classList.remove('show');
        srMatchIdx = srMatches.indexOf(d.id);
        if (d.locateUrl) locateAsset(d.id);            // 1-4: DOM 미발견 시 locateAsset이 토스트 안내
        else window.location.href = d.url;             // 미배치·사무실 등 → 상세
    }
    function setSel(i){
        var items = box.querySelectorAll('.sr-sr-item');
        if (!items.length) return;
        if (i < 0) i = items.length - 1;
        if (i >= items.length) i = 0;
        selIdx = i;
        items.forEach(function(el, k){ el.classList.toggle('sr-sr-active', k === selIdx); });
        items[selIdx].scrollIntoView({ block: 'nearest' });
    }
    input.addEventListener('input', function(){
        var q = this.value.trim();
        clearTimeout(timer);
        // B-4: 검색어 변경 시 [모두 표시] 강조 해제
        if (srAllActive) { document.querySelectorAll('.sr-highlight').forEach(function(h){ h.classList.remove('sr-highlight'); }); srAllActive = false; }
        flat = []; selIdx = -1;
        if (q.length < 2) { box.innerHTML = ''; box.classList.remove('show'); return; }
        timer = setTimeout(function(){
            fetch('/api/search?q=' + encodeURIComponent(q)).then(function(r){ return r.json(); }).then(function(data){
                srLastResults = data;
                srMatches = data.map(function(d){ return d.id; });
                srMatchIdx = -1; flat = []; selIdx = -1;
                var nav = document.getElementById('srMatchNav');
                if (nav) { nav.style.display = data.length > 1 ? '' : 'none'; document.getElementById('srMatchLabel').textContent = data.length + '건'; }
                if (!data.length) { box.innerHTML = '<div class="sr-sr-empty">검색 결과가 없습니다.</div>'; box.classList.add('show'); return; }
                // B-4: 구역 + 모듈 요약 + [모두 표시]
                function srItem(d){
                    var idx = flat.length; flat.push(d);
                    var sub = esc(d.subtitle || '') + (d.location ? (' · ' + esc(d.location)) : '') + (d.currentLocation ? (' · 현재: ' + esc(d.currentLocation)) : '');
                    return '<div class="sr-sr-item" data-id="' + d.id + '" data-idx="' + idx + '"><div class="sr-sr-title">' + esc(d.title) + '</div><div class="sr-sr-sub">' + sub + '</div>' + srModLine(d.matchedModules) + '</div>';
                }
                function srSec(title, items){ return items.length ? ('<div class="sr-sr-head">' + esc(title) + '</div>' + items.map(srItem).join('')) : ''; }
                var gA = data.filter(function(d){return d.matchType==='asset';}), gI = data.filter(function(d){return d.matchType==='ip';}), gM = data.filter(function(d){return d.matchType==='module';});
                box.innerHTML = '<div class="sr-sr-allbar"><button type="button" class="btn btn-xs btn-outline" onclick="srShowAll()">모두 표시</button></div>' +
                    srSec('장비', gA) + srSec('IP', gI) + srSec('모듈 장착 장비 (' + gM.length + ')', gM);
                box.classList.add('show');
                box.querySelectorAll('.sr-sr-item').forEach(function(el){
                    el.addEventListener('click', function(){ srActivate(flat[parseInt(el.dataset.idx, 10)]); });
                    el.addEventListener('mouseenter', function(){ setSel(parseInt(el.dataset.idx, 10)); });
                });
            }).catch(function(){ box.innerHTML = '<div class="sr-sr-empty">검색 오류</div>'; box.classList.add('show'); });
        }, 250);
    });
    document.addEventListener('click', function(e){ if (!input.contains(e.target) && !box.contains(e.target)) box.classList.remove('show'); });
    // B-4b 1-2: ↑/↓ 이동, Enter 활성화, Esc 닫기
    input.addEventListener('keydown', function(e){
        if (e.key === 'Escape') { box.classList.remove('show'); return; }
        if (!box.classList.contains('show')) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); setSel(selIdx + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setSel(selIdx - 1); }
        else if (e.key === 'Enter') { if (selIdx >= 0 && flat[selIdx]) { e.preventDefault(); srActivate(flat[selIdx]); } }
    });
})();

// ?focus=<id> 진입 시 자동 이동
(function(){
    var p = new URLSearchParams(location.search);
    var f = p.get('focus');
    if (f && parseInt(f)) setTimeout(function(){ locateAsset(parseInt(f)); }, 350);
})();

// ---- UX-4 장비 목록 패널 ----
var srPanelData = [];
var srPanelMode = 'split';
var srJustDragged = false;
// 랙 드래그 종료 직후의 유령 클릭이 패널을 닫지 않도록 가드(드래그 코드 비수정)
document.addEventListener('dragend', function(){ srJustDragged = true; setTimeout(function(){ srJustDragged = false; }, 300); }, true);

// B-1c: 선호값 키 하나로 통합(rooms.panel.pref = 'shown'|'hidden'). 구 키(srPanelOpen)는 이전 후 무시.
var SR_PREF_KEY = 'rooms.panel.pref';
function srGetPref() {
    try {
        var p = localStorage.getItem(SR_PREF_KEY);
        if (p === null) { var old = localStorage.getItem('srPanelOpen'); if (old !== null) { p = (old === '1') ? 'shown' : 'hidden'; localStorage.setItem(SR_PREF_KEY, p); localStorage.removeItem('srPanelOpen'); } }
        return p;
    } catch (e) { return null; }
}
function srSetPref(v) { try { localStorage.setItem(SR_PREF_KEY, v); } catch (e) {} }
function srIsWide() { return window.innerWidth >= 1100; }
function srUpdateToggleLabel(open) {
    var b = document.getElementById('srPanelToggleBtn');
    if (b) b.innerHTML = open ? '✖ 장비 목록 숨기기' : '☰ 장비 목록 보이기';
}
// 패널 상태 설정. persist=true면 사용자 명시 동작으로 선호값 저장(오버레이 자동닫기 등은 persist=false).
function srSetPanel(open, persist) {
    var panel = document.getElementById('srPanel');
    if (!panel) return;
    srPanelMode = srIsWide() ? 'split' : 'overlay';
    panel.classList.toggle('open', open);
    document.body.classList.toggle('rooms-panel-split', open);
    if (persist) srSetPref(open ? 'shown' : 'hidden');
    srUpdateToggleLabel(open);
    if (open) srInitPanelData();
}
// 툴바 버튼: 토글(사용자 명시 → 선호 저장). 분할/오버레이 공통.
function srTogglePanel(force) {
    var panel = document.getElementById('srPanel');
    var open = (typeof force === 'boolean') ? force : !panel.classList.contains('open');
    srSetPanel(open, true);
}
function srInitPanelData() {
    var sel = document.getElementById('srPanelRoom');
    if (sel && !sel.options.length) sel.innerHTML = SR_ROOMS.map(function(r){ return '<option value="' + r.id + '">' + esc(r.name) + '</option>'; }).join('');
    if (SR_ROOMS.length && !srPanelData.length) srPanelReload();
}

// 바깥 클릭 — 오버레이 모드에서만 닫힘(분할 모드는 상시 고정, 오조작 방지). 선호값 불변.
document.addEventListener('click', function(e) {
    var panel = document.getElementById('srPanel');
    if (!panel || !panel.classList.contains('open')) return;
    if (srPanelMode !== 'overlay') return;     // 분할 모드: 바깥 클릭으로 닫지 않음
    if (panel.contains(e.target)) return;
    if (srJustDragged) return;
    if (e.target.closest('.sr-toolbar, #srSearchResults, .modal-overlay, .modal, a, button, input, select, textarea, label')) return;
    srSetPanel(false, false);                  // 오버레이 자동닫기 → 선호 저장 안 함
});
// ESC — 오버레이 모드에서만(분할은 팝업 ESC와 혼동 방지로 무시). 팝업 열려 있으면 양보.
document.addEventListener('keydown', function(e) {
    if (e.key !== 'Escape') return;
    var panel = document.getElementById('srPanel');
    if (!panel || !panel.classList.contains('open')) return;
    if (srPanelMode !== 'overlay') return;
    if (document.querySelector('.modal-overlay.active')) return;
    srSetPanel(false, false);
});
// 창 크기 변경: 분할↔오버레이 전환 시 규칙 재적용(선호 불변).
window.addEventListener('resize', function() {
    var wasWide = (srPanelMode === 'split');
    var nowWide = srIsWide();
    if (wasWide === nowWide) { srPanelMode = nowWide ? 'split' : 'overlay'; return; }
    srPanelMode = nowWide ? 'split' : 'overlay';
    if (nowWide) { srSetPanel(srGetPref() !== 'hidden', false); }   // 넓어짐: 선호 hidden 아니면 열기
    else { srSetPanel(false, false); }                              // 좁아짐: 오버레이 → 닫기(본문 가림 방지)
});
// B-4b 2: 패널 필터 서버 연동 상태
var srPanelServerActive = false;   // 2글자+ 서버 검색 모드
var srPanelServerIds = null;       // 이 서버실 스코프 결과 id Set
var srPanelScoped = [];            // 스코프 검색 결과 원본(패널 미등재 블레이드 노드 합성용)
var srPanelServerMods = {};        // id → matchedModules
var srPanelOther = 0;              // 다른 위치(전역-스코프) 매칭 수
var srPanelFilterTimer = null;
function srPanelReload() {
    var sel = document.getElementById('srPanelRoom');
    var rid = sel && sel.value ? sel.value : (SR_ROOMS[0] && SR_ROOMS[0].id);
    if (!rid) return;
    var list = document.getElementById('srPanelList');
    list.innerHTML = '<p class="text-muted" style="padding:12px;">로딩중…</p>';
    fetch('/rooms/' + rid + '/assets.json').then(function(r){ return r.json(); }).then(function(d){
        srPanelData = (d && d.assets) || [];
        // 2-2: 서버실 변경 시 활성 검색어가 있으면 재조회, 아니면 간이 필터로 렌더
        var q = (document.getElementById('srPanelFilter').value || '').trim();
        if (q.length >= 2) { srPanelServerSearch(q); }
        else { srPanelServerActive = false; srPanelServerIds = null; srPanelRenderChips(); srPanelRender(); }
    }).catch(function(){ list.innerHTML = '<p style="color:#ef4444;padding:12px;">불러올 수 없습니다.</p>'; });
}
// 2-2 입력 핸들러: 1글자 이하는 간이(클라이언트) 필터, 2글자 이상은 디바운스 후 서버 검색.
function srPanelFilterInput() {
    var q = (document.getElementById('srPanelFilter').value || '').trim();
    clearTimeout(srPanelFilterTimer);
    if (q.length < 2) { srPanelServerActive = false; srPanelServerIds = null; srPanelRenderChips(); srPanelRender(); return; }
    srPanelFilterTimer = setTimeout(function(){ srPanelServerSearch(q); }, 250);
}
// 2-1 서버 검색: 스코프(room_id) + 전역을 함께 받아 목록 필터 + "다른 위치 N건" 계산.
function srPanelServerSearch(q) {
    var sel = document.getElementById('srPanelRoom');
    var rid = sel && sel.value ? sel.value : (SR_ROOMS[0] && SR_ROOMS[0].id);
    function okJson(r){ if (!r.ok) throw new Error('http'); return r.json(); }
    Promise.all([
        fetch('/api/search?q=' + encodeURIComponent(q) + '&room_id=' + encodeURIComponent(rid)).then(okJson),
        fetch('/api/search?q=' + encodeURIComponent(q)).then(okJson)
    ]).then(function(arr){
        var scoped = arr[0] || [], global = arr[1] || [];
        srPanelScoped = scoped;
        srPanelServerIds = {}; scoped.forEach(function(d){ srPanelServerIds[d.id] = true; });
        srPanelServerMods = {}; scoped.forEach(function(d){ if (d.matchedModules) srPanelServerMods[d.id] = d.matchedModules; });
        srPanelOther = global.filter(function(d){ return !srPanelServerIds[d.id]; }).length;
        srPanelServerActive = true;
        srPanelRenderChips(); srPanelRender();
    }).catch(function(){
        // 2-4: 오류 → 간이 클라이언트 필터로 폴백 + 안내
        srPanelServerActive = false; srPanelServerIds = null;
        srShowToast('검색 연결 실패 — 간이 필터로 표시합니다.');
        srPanelRenderChips(); srPanelRender();
    });
}
// 서버 결과(다른 위치 N건)로 상단 전역 검색 드롭다운 열기
function srPanelShowGlobal() {
    var q = (document.getElementById('srPanelFilter').value || '').trim();
    var g = document.getElementById('globalSearch');
    if (g) { g.value = q; g.dispatchEvent(new Event('input', { bubbles: true })); g.focus(); }
}
// 현재 표시 대상 base 행(서버 모드=스코프 결과 병합, 간이 모드=텍스트 필터). 유형 칩 적용 전.
function srPanelVisibleRows() {
    if (srPanelServerActive && srPanelServerIds) {
        var byId = {}; srPanelData.forEach(function(a){ byId[a.id] = a; });
        return srPanelScoped.map(function(d){
            var a = byId[d.id];
            if (a) { a.__mm = srPanelServerMods[d.id]; a.__loc = null; return a; }
            // 2-4: 패널 미등재(블레이드 노드 등) → 검색 결과로 합성
            return { id: d.id, asset_type: d.asset_type, management_number: (d.subtitle || '').split(' | ')[0] || null,
                     asset_number: null, model_name: d.title || null, rack_id: null, rack_name: null, u_label: null,
                     rep_ip: null, ownership: null, vendor_name: null, status: null, __loc: d.location || '', __mm: srPanelServerMods[d.id] };
        });
    }
    var q = (document.getElementById('srPanelFilter').value || '').trim().toLowerCase();
    if (!q) return srPanelData.slice();
    return srPanelData.filter(function(a){ return [a.management_number, a.model_name, a.rep_ip, a.asset_number].some(function(v){ return v && String(v).toLowerCase().indexOf(q) !== -1; }); });
}
var srPanelTypeFilter = '';
function srPanelRenderChips() {
    var base = srPanelVisibleRows();   // 2-2: 칩 개수는 필터(서버/간이) 결과 기준
    var counts = {};
    base.forEach(function(a){ counts[a.asset_type] = (counts[a.asset_type] || 0) + 1; });
    var chips = '<span class="sr-chip' + (srPanelTypeFilter === '' ? ' active' : '') + '" onclick="srPanelSetType(\'\')">전체 ' + base.length + '</span>';
    Object.keys(counts).forEach(function(t){
        chips += '<span class="sr-chip' + (srPanelTypeFilter === t ? ' active' : '') + '" onclick="srPanelSetType(\'' + t + '\')">' + esc(SR_TYPE_LABELS[t] || t) + ' ' + counts[t] + '</span>';
    });
    document.getElementById('srPanelChips').innerHTML = chips;
}
function srPanelSetType(t) { srPanelTypeFilter = t; srPanelRenderChips(); srPanelRender(); }
function srPanelRender() {
    var list = document.getElementById('srPanelList');
    var base = srPanelVisibleRows();
    var rows = srPanelTypeFilter ? base.filter(function(a){ return a.asset_type === srPanelTypeFilter; }) : base;   // 2-2: 유형 칩은 서버 결과 위에 추가 적용
    if (!rows.length) {
        if (srPanelServerActive) {
            var qesc = esc((document.getElementById('srPanelFilter').value || '').trim());
            var other = srPanelOther > 0 ? ('<br><a href="#" class="sr-panel-other" onclick="srPanelShowGlobal();return false;">다른 위치 ' + srPanelOther + '건 보기</a>') : '';
            list.innerHTML = '<p class="text-muted" style="padding:12px;">이 서버실에 \'' + qesc + '\' 장비 없음' + other + '</p>';
        } else {
            list.innerHTML = '<p class="text-muted" style="padding:12px;">해당 장비가 없습니다.</p>';
        }
        return;
    }
    list.innerHTML = rows.map(function(a){
        var ownerBadge = (a.ownership === 'vendor')
            ? '<span class="badge badge-warning">' + esc(a.vendor_name || '업체') + '</span>'
            : (a.ownership ? '<span class="badge badge-success">자사</span>' : '');
        var loc = a.__loc ? esc(a.__loc)
                : (a.rack_id ? (esc(a.rack_name || '') + (a.u_label ? (' ' + esc(a.u_label)) : '')) : '<span class="text-muted">랙 미배치</span>');
        var status = a.status ? (' · ' + esc(SR_STATUS_LABELS[a.status] || a.status)) : '';
        return '<div class="sr-row" data-id="' + a.id + '">' +
            '<div class="sr-row-main">' +
              '<span class="sr-row-type">' + esc(SR_TYPE_LABELS[a.asset_type] || a.asset_type) + '</span> ' +
              '<span class="sr-row-mgmt">' + esc(a.management_number || a.asset_number || ('#' + a.id)) + '</span> ' + ownerBadge +
              '<div class="sr-row-sub">' + esc(a.model_name || '') + ' · ' + loc + (a.rep_ip ? (' · ' + esc(a.rep_ip)) : '') + status + '</div>' +
              srModLine(a.__mm) +
            '</div>' +
            '<button type="button" class="btn btn-xs btn-outline sr-row-info" onclick="openAssetPopup(' + a.id + ');event.stopPropagation();">정보</button>' +
            '</div>';
    }).join('');
    list.querySelectorAll('.sr-row').forEach(function(el){
        el.addEventListener('click', function(){ locateAsset(parseInt(this.dataset.id)); });
    });
}
// ===== UX-2: 팝업 인라인 빠른 수정 =====
function srCurrentAssetId() { return parseInt((document.getElementById('adpDetailLink').href.split('/assets/')[1] || '').split(/[\/?#]/)[0]); }
function srEditBar(tab) { return '<div class="adp-edit-bar"><button type="button" class="btn btn-sm btn-outline" onclick="srEditTab(\'' + tab + '\')">&#9998; 편집</button></div>'; }
// 탭별 화이트리스트 필드 정의
var SR_EDIT_FIELDS = {
    basic: [ { k:'manufacturer', label:'제조사' }, { k:'model_name', label:'모델명' }, { k:'serial_number', label:'시리얼' }, { k:'status', label:'상태', type:'status' } ],
    ops:   [ { k:'assigned_user', label:'담당자' }, { k:'purpose', label:'용도' }, { k:'notes', label:'비고', type:'textarea' } ]
};
var SR_IP_TYPES = [['management','Management'],['bmc','BMC'],['ib','InfiniBand'],['data','Data'],['os','OS'],['other','기타']];
var SR_CRED_TYPES = [['root','Root'],['user','User'],['bmc','BMC']];
function srEditTab(tab) {
    if (tab === 'ip') return srEditIpTab();
    if (tab === 'access') return srEditCredTab();
    var id = srCurrentAssetId(); var data = adpCache[id]; if (!data) return;
    var a = data.asset;
    var rows = SR_EDIT_FIELDS[tab].map(function(f){
        var val = a[f.k] == null ? '' : String(a[f.k]);
        var input;
        if (f.type === 'status') {
            // active↔maintenance만. 그 밖의 상태면 편집 불가 안내 + 필드 생략.
            if (a.status !== 'active' && a.status !== 'maintenance') {
                return '<tr><th>' + f.label + '</th><td><span class="text-muted">' + esc(statusLabel(a.status)) + ' — 인라인 변경 불가(수정 페이지 사용)</span></td></tr>';
            }
            input = '<select class="form-control sr-edit-input" data-k="status">' +
                '<option value="active"' + (a.status==='active'?' selected':'') + '>운영중</option>' +
                '<option value="maintenance"' + (a.status==='maintenance'?' selected':'') + '>점검중</option></select>';
        } else if (f.type === 'textarea') {
            input = '<textarea class="form-control sr-edit-input" data-k="' + f.k + '" rows="2">' + esc(val) + '</textarea>';
        } else {
            input = '<input type="text" class="form-control sr-edit-input" data-k="' + f.k + '" value="' + esc(val).replace(/"/g,'&quot;') + '">';
        }
        return '<tr><th>' + f.label + '</th><td>' + input + '</td></tr>';
    }).join('');
    var html = '<table class="adp-table adp-edit-form">' + rows + '</table>' +
        '<div class="adp-edit-bar">' +
        '<button type="button" class="btn btn-sm btn-primary" id="srQuickSaveBtn" onclick="srQuickSave(\'' + tab + '\')">저장</button> ' +
        '<button type="button" class="btn btn-sm btn-secondary" onclick="srQuickCancel(\'' + tab + '\')">취소</button>' +
        '<span id="srQuickMsg" class="sr-edit-msg"></span></div>';
    document.getElementById('adpContent').innerHTML = html;
}
function srQuickCancel(tab) { var id = srCurrentAssetId(); renderAdpTab(adpCache[id], tab); }
function srQuickSave(tab) {
    var id = srCurrentAssetId(); var data = adpCache[id]; if (!data) return;
    var body = { updated_at_token: data.asset.updated_at_token };
    document.querySelectorAll('#adpContent .sr-edit-input').forEach(function(el){ body[el.dataset.k] = el.value; });
    var btn = document.getElementById('srQuickSaveBtn'); var msg = document.getElementById('srQuickMsg');
    if (btn) btn.disabled = true; if (msg) msg.textContent = '저장 중…';
    fetch('/assets/' + id + '/quick', { method:'POST', headers:{ 'Content-Type':'application/json', 'Accept':'application/json' }, body: JSON.stringify(body) })
        .then(function(r){ return r.json().then(function(j){ return { status:r.status, j:j }; }); })
        .then(function(res){
            if (res.status === 409) { if (msg) msg.textContent = ''; alert('다른 사용자가 먼저 수정했습니다. 최신 값으로 다시 불러옵니다.'); if (res.j.asset) adpCache[id].asset = res.j.asset; srQuickCancel(tab); return; }
            if (res.status === 403) { if (btn) btn.disabled=false; if (msg) msg.textContent = '수정 권한이 없습니다.'; return; }
            if (res.status !== 200) { if (btn) btn.disabled=false; if (msg) msg.textContent = (res.j && res.j.error) || '저장 실패'; return; }
            // 성공
            if (res.j.asset) adpCache[id].asset = res.j.asset;
            srRefreshAssetViews(id);
            srQuickCancel(tab);
        })
        .catch(function(){ if (btn) btn.disabled=false; if (msg) msg.textContent = '저장 오류'; });
}
// ---- B-2b: IP 탭 행 편집 ----
function srIpTypeSelect(sel) { return '<select class="form-control sr-ip-type">' + SR_IP_TYPES.map(function(t){ return '<option value="'+t[0]+'"'+(sel===t[0]?' selected':'')+'>'+t[1]+'</option>'; }).join('') + '</select>'; }
function srIpRow(ip) {
    ip = ip || {};
    return '<tr class="sr-ip-row">' +
        '<td>' + srIpTypeSelect(ip.ip_type || 'management') + '</td>' +
        '<td><input type="text" class="form-control sr-ip-iface" value="' + esc(ip.interface_type||'').replace(/"/g,'&quot;') + '" placeholder="iface"></td>' +
        '<td><input type="text" class="form-control sr-ip-speed" value="' + esc(ip.speed||'').replace(/"/g,'&quot;') + '" placeholder="속도"></td>' +
        '<td><input type="text" class="form-control sr-ip-addr" value="' + esc(ip.ip_address||'').replace(/"/g,'&quot;') + '" placeholder="10.100.x.x"></td>' +
        '<td><input type="text" class="form-control sr-ip-desc" value="' + esc(ip.description||'').replace(/"/g,'&quot;') + '"></td>' +
        '<td><button type="button" class="btn btn-xs btn-danger" onclick="this.closest(\'tr\').remove()">삭제</button></td></tr>';
}
function srEditIpTab() {
    var id = srCurrentAssetId(); var data = adpCache[id]; if (!data) return;
    var ips = data.assetIps || [];
    var rowsHtml = ips.map(srIpRow).join('');
    var html = '<table class="adp-table adp-edit-form"><tr><th>유형</th><th>인터페이스</th><th>속도</th><th>IP</th><th>설명</th><th></th></tr>' +
        '<tbody id="srIpRows">' + rowsHtml + '</tbody></table>' +
        '<div class="adp-edit-bar"><button type="button" class="btn btn-xs btn-outline" onclick="document.getElementById(\'srIpRows\').insertAdjacentHTML(\'beforeend\', srIpRow())">+ 행 추가</button></div>' +
        '<div class="adp-edit-bar">' +
        '<button type="button" class="btn btn-sm btn-primary" id="srQuickSaveBtn" onclick="srSaveIps()">저장</button> ' +
        '<button type="button" class="btn btn-sm btn-secondary" onclick="srQuickCancel(\'ip\')">취소</button>' +
        '<span id="srQuickMsg" class="sr-edit-msg"></span></div>';
    document.getElementById('adpContent').innerHTML = html;
}
function srSaveIps() {
    var id = srCurrentAssetId(); var data = adpCache[id]; if (!data) return;
    var ips = [];
    document.querySelectorAll('#srIpRows .sr-ip-row').forEach(function(tr){
        var addr = tr.querySelector('.sr-ip-addr').value.trim();
        if (!addr) return;
        ips.push({ ip_address: addr, ip_type: tr.querySelector('.sr-ip-type').value, interface_type: tr.querySelector('.sr-ip-iface').value.trim(), speed: tr.querySelector('.sr-ip-speed').value.trim(), description: tr.querySelector('.sr-ip-desc').value.trim() });
    });
    var btn = document.getElementById('srQuickSaveBtn'); var msg = document.getElementById('srQuickMsg');
    if (btn) btn.disabled = true; if (msg) msg.textContent = '저장 중…';
    fetch('/assets/' + id + '/quick-ips', { method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, body: JSON.stringify({ ips: ips, updated_at_token: data.asset.updated_at_token }) })
        .then(function(r){ return r.json().then(function(j){ return {status:r.status,j:j}; }); })
        .then(function(res){
            if (res.status === 409) {
                if (res.j.conflicts) {
                    if (msg) msg.textContent = '';
                    document.querySelectorAll('#srIpRows .sr-ip-row').forEach(function(tr){
                        var addr = tr.querySelector('.sr-ip-addr').value.trim();
                        var c = res.j.conflicts.find(function(x){ return x.ip_address === addr; });
                        if (c) { tr.classList.add('sr-conflict'); tr.title = c.reason + (c.management_number ? (' ('+c.management_number+')') : ''); }
                    });
                    if (btn) btn.disabled = false;
                    if (msg) msg.textContent = '충돌: ' + res.j.conflicts.map(function(c){return c.ip_address;}).join(', ');
                } else { if (msg) msg.textContent=''; alert('다른 사용자가 먼저 수정했습니다. 최신값으로 다시 불러옵니다.'); srRefreshFromAvail(id, res.j); srQuickCancel('ip'); }
                return;
            }
            if (res.status === 403) { if (btn) btn.disabled=false; if (msg) msg.textContent='수정 권한이 없습니다.'; return; }
            if (res.status !== 200) { if (btn) btn.disabled=false; if (msg) msg.textContent=(res.j&&res.j.error)||'저장 실패'; return; }
            srRefreshFromAvail(id, res.j);
            if (res.j.warnings && res.j.warnings.length) alert('경고:\n' + res.j.warnings.join('\n'));
            srQuickCancel('ip');
        })
        .catch(function(){ if (btn) btn.disabled=false; if (msg) msg.textContent='저장 오류'; });
}
// ---- B-2b: 접속정보 탭 행 편집 ----
function srCredTypeSelect(sel) { return '<select class="form-control sr-cred-type">' + SR_CRED_TYPES.map(function(t){ return '<option value="'+t[0]+'"'+(sel===t[0]?' selected':'')+'>'+t[1]+'</option>'; }).join('') + '</select>'; }
function srCredRow(c) {
    c = c || {};
    return '<tr class="sr-cred-row" data-id="' + (c.id || '') + '">' +
        '<td>' + srCredTypeSelect(c.credential_type || 'root') + '</td>' +
        '<td><input type="text" class="form-control sr-cred-user" value="' + esc(c.username||'').replace(/"/g,'&quot;') + '" placeholder="사용자명(필수)"></td>' +
        '<td><input type="text" class="form-control sr-cred-pw" value="" placeholder="' + (c.has_password ? '변경 시에만 입력' : '비밀번호') + '" autocomplete="new-password"></td>' +
        '<td><input type="text" class="form-control sr-cred-desc" value="' + esc(c.description||'').replace(/"/g,'&quot;') + '"></td>' +
        '<td><button type="button" class="btn btn-xs btn-danger" onclick="srCredDeleteRow(this)">삭제</button></td></tr>';
}
var srCredDeleted = [];
function srCredDeleteRow(btn) {
    var tr = btn.closest('tr'); var cid = tr.dataset.id;
    if (cid) { if (!confirm('이 접속정보를 삭제하시겠습니까?')) return; srCredDeleted.push(parseInt(cid,10)); }
    tr.remove();
}
function srEditCredTab() {
    var id = srCurrentAssetId(); var data = adpCache[id]; if (!data) return;
    srCredDeleted = [];
    var creds = data.credentials || [];
    var rowsHtml = creds.map(srCredRow).join('');
    var html = '<table class="adp-table adp-edit-form"><tr><th>유형</th><th>사용자명</th><th>비밀번호</th><th>설명</th><th></th></tr>' +
        '<tbody id="srCredRows">' + rowsHtml + '</tbody></table>' +
        '<div class="adp-edit-bar"><button type="button" class="btn btn-xs btn-outline" onclick="document.getElementById(\'srCredRows\').insertAdjacentHTML(\'beforeend\', srCredRow())">+ 행 추가</button></div>' +
        '<div class="adp-edit-bar"><button type="button" class="btn btn-sm btn-primary" id="srQuickSaveBtn" onclick="srSaveCreds()">저장</button> ' +
        '<button type="button" class="btn btn-sm btn-secondary" onclick="srQuickCancel(\'access\')">취소</button>' +
        '<span id="srQuickMsg" class="sr-edit-msg"></span></div>';
    document.getElementById('adpContent').innerHTML = html;
}
function srSaveCreds() {
    var id = srCurrentAssetId(); var data = adpCache[id]; if (!data) return;
    var creds = [];
    document.querySelectorAll('#srCredRows .sr-cred-row').forEach(function(tr){
        creds.push({ id: tr.dataset.id ? parseInt(tr.dataset.id,10) : null, credential_type: tr.querySelector('.sr-cred-type').value, username: tr.querySelector('.sr-cred-user').value.trim(), password: tr.querySelector('.sr-cred-pw').value, description: tr.querySelector('.sr-cred-desc').value.trim() });
    });
    var btn = document.getElementById('srQuickSaveBtn'); var msg = document.getElementById('srQuickMsg');
    if (btn) btn.disabled = true; if (msg) msg.textContent = '저장 중…';
    fetch('/assets/' + id + '/quick-credentials', { method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, body: JSON.stringify({ credentials: creds, deleted_ids: srCredDeleted, updated_at_token: data.asset.updated_at_token }) })
        .then(function(r){ return r.json().then(function(j){ return {status:r.status,j:j}; }); })
        .then(function(res){
            if (res.status === 409) { if (msg) msg.textContent=''; alert('다른 사용자가 먼저 수정했습니다. 최신값으로 다시 불러옵니다.'); srRefreshFromAvail(id, res.j); srQuickCancel('access'); return; }
            if (res.status === 403) { if (btn) btn.disabled=false; if (msg) msg.textContent='수정 권한이 없습니다.'; return; }
            if (res.status !== 200) { if (btn) btn.disabled=false; if (msg) msg.textContent=(res.j&&res.j.error)||'저장 실패'; return; }
            srRefreshFromAvail(id, res.j);
            srQuickCancel('access');
        })
        .catch(function(){ if (btn) btn.disabled=false; if (msg) msg.textContent='저장 오류'; });
}
// 응답의 가용성·IP·자격증명·토큰으로 adpCache 갱신 + 전원/SSH/SOL/BMC 버튼 재계산
function srRefreshFromAvail(id, j) {
    var c = adpCache[id]; if (!c) return;
    if (j.assetIps) c.assetIps = j.assetIps;
    if (j.credentials) c.credentials = j.credentials;
    if (j.updated_at_token) c.asset.updated_at_token = j.updated_at_token;
    if (typeof j.sshAvailable !== 'undefined') c.sshAvailable = j.sshAvailable;
    if (typeof j.solAvailable !== 'undefined') c.solAvailable = j.solAvailable;
    if (typeof j.bmcWebUrl !== 'undefined') c.bmcWebUrl = j.bmcWebUrl;
    if (typeof renderAdp === 'function') renderAdp(c);   // 전원 탭 노출 등 재계산
    // 장비 목록 패널 대표 IP 갱신
    if (srPanelData && srPanelData.length && j.assetIps) {
        var row = srPanelData.find(function(x){ return x.id === id; });
        if (row) { var rep = j.assetIps.find(function(i){return i.ip_type==='os';})||j.assetIps.find(function(i){return i.ip_type==='management';})||j.assetIps.find(function(i){return i.ip_type!=='bmc';})||j.assetIps[0]; row.rep_ip = rep?rep.ip_address:null; srPanelRender(); }
    }
}

// 저장 후 랙 셀 라벨·패널 행 즉시 갱신
function srRefreshAssetViews(id) {
    var a = adpCache[id] && adpCache[id].asset; if (!a) return;
    var label = (a.model_name || typeLabel(a.asset_type)) + (a.management_number ? ' (' + a.management_number + ')' : '');
    document.querySelectorAll('.clickable-unit[data-asset-id="' + id + '"] .mini-asset-name').forEach(function(sp){ sp.textContent = label; });
    // 패널 데이터·행 갱신
    if (srPanelData && srPanelData.length) {
        var row = srPanelData.find(function(x){ return x.id === id; });
        if (row) { row.model_name = a.model_name; row.status = a.status; srPanelRender(); }
    }
}

// B-1c: 조기 인라인 스크립트가 .open/.split을 이미 선적용 → 여기선 라벨·데이터만 초기화(깜박임 방지)
(function(){
    var panel = document.getElementById('srPanel');
    var open = !!(panel && panel.classList.contains('open'));
    srPanelMode = srIsWide() ? 'split' : 'overlay';
    srUpdateToggleLabel(open);
    if (open) srInitPanelData();
})();
</script>

