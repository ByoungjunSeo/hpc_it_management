        .then(function(r){ return r.json().then(function(j){ return {status:r.status,j:j}; }); })
        .then(function(res){
            if (res.status === 409) { if (msg) msg.textContent=''; alert('다른 사용자가 먼저 수정했습니다. 최신값으로 다시 불러옵니다.'); srRefreshFromAvail(id, res.j); srAfterSave(ed, 'access'); return; }
            if (res.status === 403) { if (btn) btn.disabled=false; if (msg) msg.textContent='수정 권한이 없습니다.'; return; }
            if (res.status !== 200) { if (btn) btn.disabled=false; if (msg) msg.textContent=(res.j&&res.j.error)||'저장 실패'; return; }
            srRefreshFromAvail(id, res.j);
            srAfterSave(ed, 'access');
        })
        .catch(function(){ if (btn) btn.disabled=false; if (msg) msg.textContent='저장 오류'; });
}
// 응답의 가용성·IP·자격증명·토큰으로 adpCache 갱신 + 전원/SSH/SOL/BMC 버튼 재계산
function srRefreshFromAvail(id, j) {
    var c = adpCache[id]; if (!c) return;
    if (j.assetIps) c.assetIps = j.assetIps;
    if (j.credentials) c.credentials = j.credentials;
    if (j.updated_at_token) c.asset.updated_at_token = j.updated_at_token;
    if (typeof j.sshAvailable !== 'undefined') c.sshAvailable = j.sshAvailable;
    if (typeof j.solAvailable !== 'undefined') c.solAvailable = j.solAvailable;
    if (typeof j.bmcWebUrl !== 'undefined') c.bmcWebUrl = j.bmcWebUrl;
    srInvalidateParent(id);                                       // B-6 동작 유지(열린 루트면 재조회)
    if (typeof srRenderChrome === 'function') srRenderChrome();   // B-6b: 전원 탭 노출 등 재계산(대상·하위 탭 유지)
    // 장비 목록 패널 대표 IP 갱신
    if (srPanelData && srPanelData.length && j.assetIps) {
        var row = srPanelData.find(function(x){ return x.id === id; });
        if (row) { var rep = j.assetIps.find(function(i){return i.ip_type==='os';})||j.assetIps.find(function(i){return i.ip_type==='management';})||j.assetIps.find(function(i){return i.ip_type!=='bmc';})||j.assetIps[0]; row.rep_ip = rep?rep.ip_address:null; srPanelRender(); }
    }
}

// 저장 후 랙 셀 라벨·패널 행 즉시 갱신
function srRefreshAssetViews(id) {
    var a = adpCache[id] && adpCache[id].asset; if (!a) return;
    var label = (a.model_name || typeLabel(a.asset_type)) + (a.management_number ? ' (' + a.management_number + ')' : '');
    document.querySelectorAll('.clickable-unit[data-asset-id="' + id + '"] .mini-asset-name').forEach(function(sp){ sp.textContent = label; });
    // 패널 데이터·행 갱신
    if (srPanelData && srPanelData.length) {
        var row = srPanelData.find(function(x){ return x.id === id; });
        if (row) { row.model_name = a.model_name; row.status = a.status; srPanelRender(); }
    }
}

// B-1c: 조기 인라인 스크립트가 .open/.split을 이미 선적용 → 여기선 라벨·데이터만 초기화(깜박임 방지)
(function(){
    var panel = document.getElementById('srPanel');
    var open = !!(panel && panel.classList.contains('open'));
    srPanelMode = srIsWide() ? 'split' : 'overlay';
    srUpdateToggleLabel(open);
    if (open) srInitPanelData();
})();
</script>

