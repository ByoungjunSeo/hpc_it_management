var credTypeOptions = '<% appConfig.credentialTypes.forEach(t => { %><option value="<%= t.value %>"><%= t.label %></option><% }) %>';
function addCredRow() {
    var html = '<div class="form-row cred-row">' +
        '<div class="form-group" style="flex:0 0 120px;"><select name="cred_types[]" class="form-control">' + credTypeOptions + '</select></div>' +
        '<div class="form-group"><input type="text" name="cred_usernames[]" class="form-control" placeholder="root"></div>' +
        '<div class="form-group"><input type="text" name="cred_passwords[]" class="form-control" placeholder="password"></div>' +
        '<div class="form-group"><input type="text" name="cred_descriptions[]" class="form-control" placeholder="설명"></div>' +
        '<div class="form-group" style="flex:0 0 60px; align-self: flex-end;"><button type="button" class="btn btn-sm btn-danger" onclick="this.closest(\'.cred-row\').remove()">X</button></div>' +
        '</div>';
    document.getElementById('credRows').insertAdjacentHTML('beforeend', html);
}

// === 랙 미리보기 (슬롯 레벨) ===
var _rackOccupancy = {};
var _rackTotalU = 42;
var _currentEditAssetId = <%= asset ? asset.id : 'null' %>;

function escapeHtml(str) {
    var d = document.createElement('div');
    d.textContent = str || '';
    return d.innerHTML;
}

function slotToU(slot) { return Math.floor((slot - 1) / 3) + 1; }
function slotToH(slot) { return ((slot - 1) % 3) + 1; }

function loadRackPreview() {
    var rackId = document.getElementById('rackSelect').value;
    var preview = document.getElementById('rackPreview');
    if (!rackId || rackId === '__new__') {
        preview.style.display = 'none';
        return;
    }
    fetch('/racks/' + rackId + '/slots')
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(data) {
            if (!data) { preview.style.display = 'none'; return; }
            renderRackPreview(data);
            preview.style.display = '';
        })
        .catch(function() { preview.style.display = 'none'; });
}

function renderRackPreview(data) {
    _rackTotalU = data.totalU || 42;
    var container = document.getElementById('rackPreviewContainer');
    var info = document.getElementById('rackPreviewInfo');
    info.textContent = data.rack.name + ' (' + _rackTotalU + 'U)';

    // Build slot-level occupancy map (현재 편집 중인 자산은 제외)
    _rackOccupancy = {};
    data.assets.forEach(function(a) {
        if (_currentEditAssetId && a.id === _currentEditAssetId) return;
        var slotStart = a.rack_unit_start;
        var slotSize = a.rack_unit_size || 3;
        var side = a.blade_slot || 'full';
        var uStart = Math.floor((slotStart - 1) / 3) + 1;
        var uSize = Math.max(1, Math.ceil(slotSize / 3));
        var assetInfo = { name: a.name, mgmt: a.management_number, slotStart: slotStart, slotSize: slotSize, uStart: uStart, uSize: uSize, side: side, id: a.id };
        for (var s = slotStart; s < slotStart + slotSize; s++) {
            if (!_rackOccupancy[s]) _rackOccupancy[s] = { full: null, left: null, right: null };
            if (side === 'full') _rackOccupancy[s].full = assetInfo;
            else _rackOccupancy[s][side] = assetInfo;
        }
    });

    var occColors = { full: '#e2e8f0', left: '#dbeafe', right: '#fce7f3' };
    var occTextColors = { full: '#475569', left: '#1e40af', right: '#9d174d' };
    var holeLabels = ['하', '중', '상'];

    var html = '<table style="width:100%; border-collapse:collapse; font-size:11px; table-layout:fixed;">';
    html += '<colgroup><col style="width:40px"><col style="width:20px"><col style="width:50%"><col style="width:50%"></colgroup>';

    for (var u = _rackTotalU; u >= 1; u--) {
        for (var h = 3; h >= 1; h--) {
            var slot = (u - 1) * 3 + h;
            var m = _rackOccupancy[slot] || { full: null, left: null, right: null };
            var hasFull = !!m.full;
            var hasLeft = !!m.left;
            var hasRight = !!m.right;

            var cellH = 'height:18px; padding:1px 4px; border:1px solid #e2e8f0; font-size:10px; vertical-align:middle;';
            var emptyCell = cellH + ' cursor:pointer;';

            html += '<tr data-slot="' + slot + '" data-u="' + u + '" data-h="' + h + '">';

            if (h === 3) {
                html += '<td rowspan="3" style="padding:1px 4px; text-align:right; font-weight:600; color:#64748b; border:1px solid #e2e8f0; background:#f8fafc; font-size:11px; white-space:nowrap; vertical-align:middle;">U' + u + '</td>';
            }

            html += '<td style="padding:0 3px; text-align:center; color:#94a3b8; border:1px solid #f1f5f9; background:#f8fafc; font-size:9px;">' + holeLabels[h - 1] + '</td>';

            if (hasFull) {
                var a = m.full;
                var isStart = a.slotStart === slot;
                html += '<td colspan="2" style="' + cellH + ' background:' + occColors.full + ';">';
                if (isStart) {
                    html += '<span style="color:' + occTextColors.full + '; font-weight:500;">' + escapeHtml(a.name) + '</span>';
                    if (a.mgmt) html += ' <span style="color:#94a3b8; font-size:9px;">' + escapeHtml(a.mgmt) + '</span>';
                    if (a.uSize > 1) html += ' <span style="color:#94a3b8; font-size:9px;">(' + a.uSize + 'U)</span>';
                }
                html += '</td>';
            } else if (hasLeft || hasRight) {
                if (hasLeft) {
                    var a = m.left;
                    var isStart = a.slotStart === slot;
                    html += '<td style="' + cellH + ' background:' + occColors.left + ';">';
                    if (isStart) html += '<span style="color:' + occTextColors.left + '; font-weight:500; font-size:10px;">' + escapeHtml(a.name) + '</span>';
                    html += '</td>';
                } else {
                    html += '<td class="asset-rack-empty" style="' + emptyCell + '" onclick="onAssetSlotClick(' + slot + ')"></td>';
                }
                if (hasRight) {
                    var a = m.right;
                    var isStart = a.slotStart === slot;
                    html += '<td style="' + cellH + ' background:' + occColors.right + ';">';
                    if (isStart) html += '<span style="color:' + occTextColors.right + '; font-weight:500; font-size:10px;">' + escapeHtml(a.name) + '</span>';
                    html += '</td>';
                } else {
                    html += '<td class="asset-rack-empty" style="' + emptyCell + '" onclick="onAssetSlotClick(' + slot + ')"></td>';
                }
            } else {
                html += '<td colspan="2" class="asset-rack-empty" style="' + emptyCell + '" onclick="onAssetSlotClick(' + slot + ')"></td>';
            }
            html += '</tr>';
        }
    }
    html += '</table>';
    container.innerHTML = html;

    // Highlight current position if set
    var curSlotStart = parseInt(document.getElementById('rackUnitStart').value);
    var curSlotSize = parseInt(document.getElementById('totalSlots').value) || 3;
    if (curSlotStart) {
        highlightAssetSlots(curSlotStart, curSlotSize);
    }
}

function isSlotOccupied(slot) {
    var m = _rackOccupancy[slot];
    return m && (m.full || m.left || m.right);
}

function onAssetSlotClick(slot) {
    var totalSlots = parseInt(document.getElementById('totalSlots').value) || 3;
    var slotEnd = slot + totalSlots - 1;
    var maxSlot = _rackTotalU * 3;

    if (slotEnd > maxSlot) {
        alert('슬롯 범위 초과 (최대 U' + _rackTotalU + ')');
        return;
    }

    // Overlap check
    var conflicts = [];
    for (var s = slot; s <= slotEnd; s++) {
        if (isSlotOccupied(s)) {
            var m = _rackOccupancy[s];
            var name = (m.full || m.left || m.right).name;
            if (conflicts.indexOf(name) === -1) conflicts.push(name);
        }
    }
    if (conflicts.length > 0) {
        alert('해당 범위에 이미 장비가 있습니다:\n' + conflicts.join(', '));
        return;
    }

    // Calculate U and hole from slot
    var u = slotToU(slot);
    var h = slotToH(slot);

    document.getElementById('uStart').value = u;
    document.getElementById('holeStart').value = h;
    calcSlotStart();

    clearAssetSlotHighlight();
    highlightAssetSlots(slot, totalSlots);
}

function highlightAssetSlots(slotStart, count) {
    clearAssetSlotHighlight();
    for (var s = slotStart; s < slotStart + count; s++) {
        var row = document.querySelector('#rackPreviewContainer tr[data-slot="' + s + '"]');
        if (!row) continue;
        var cells = row.querySelectorAll('td');
        var startIdx = (slotToH(s) === 3) ? 2 : 1;
        for (var c = startIdx; c < cells.length; c++) {
            if (!isSlotOccupied(s)) {
                // BUG-8: 인라인 배경/outline → 클래스 토글(CSS)
                cells[c].classList.add('asset-sel-device');
                if (s === slotStart) cells[c].innerHTML = '<span class="asset-sel-tag">시작</span>';
            }
        }
    }
}

function clearAssetSlotHighlight() {
    var rows = document.querySelectorAll('#rackPreviewContainer tr[data-slot]');
    rows.forEach(function(row) {
        var s = parseInt(row.getAttribute('data-slot'));
        if (!isSlotOccupied(s)) {
            var cells = row.querySelectorAll('td');
            var startIdx = (slotToH(s) === 3) ? 2 : 1;
            for (var c = startIdx; c < cells.length; c++) {
                // BUG-8: 클래스 제거로 원배경 복귀
                cells[c].classList.remove('asset-sel-device');
                cells[c].innerHTML = '';
            }
        }
    });
}

// Update preview when uSize or extraSlots changes
document.getElementById('uSize').addEventListener('input', function() {
    calcSlots();
    var curSlotStart = parseInt(document.getElementById('rackUnitStart').value);
    if (curSlotStart) {
        highlightAssetSlots(curSlotStart, parseInt(document.getElementById('totalSlots').value) || 3);
    }
});
document.getElementById('extraSlots').addEventListener('input', function() {
    calcSlots();
    var curSlotStart = parseInt(document.getElementById('rackUnitStart').value);
    if (curSlotStart) {
        highlightAssetSlots(curSlotStart, parseInt(document.getElementById('totalSlots').value) || 3);
    }
});

// Load rack preview on page load if rack is pre-selected
(function() {
    onAssetTypeChange();
    var rackId = document.getElementById('rackSelect').value;
    if (rackId && rackId !== '__new__') {
        loadRackPreview();
    }
})();

// === 가용 IP 조회 ===
function openIpModal() {
    document.getElementById('ipModal').style.display = '';
    document.getElementById('ipSubnetSelect').value = '';
    document.getElementById('ipModalResults').innerHTML = '<div style="color:#94a3b8;text-align:center;padding:20px;">서브넷을 선택하세요</div>';
}

function closeIpModal() {
    document.getElementById('ipModal').style.display = 'none';
}

function loadAvailableIps() {
    var subnet = document.getElementById('ipSubnetSelect').value;
    var results = document.getElementById('ipModalResults');
    if (!subnet) {
        results.innerHTML = '<div style="color:#94a3b8;text-align:center;padding:20px;">서브넷을 선택하세요</div>';
        return;
    }
    results.innerHTML = '<div style="text-align:center;padding:20px;color:#64748b;">로딩 중...</div>';
    fetch('/assets/api/available-ips?subnet=' + encodeURIComponent(subnet))
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (!data.ips || data.ips.length === 0) {
                results.innerHTML = '<div style="color:#94a3b8;text-align:center;padding:20px;">가용 IP가 없습니다</div>';
                return;
            }
            var html = '<div style="margin-bottom:8px;font-size:12px;color:#64748b;">' + data.ips.length + '개 가용 IP</div>';
            html += '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px;">';
            data.ips.forEach(function(ip) {
                html += '<button type="button" class="ip-pick-btn" style="padding:4px 6px;font-size:11px;border:1px solid #e2e8f0;border-radius:4px;background:white;cursor:pointer;text-align:left;transition:background 0.15s;" onclick="selectAvailableIp(\'' + ip + '\')">' + ip + '</button>';
            });
            html += '</div>';
            results.innerHTML = html;
        })
        .catch(function() {
            results.innerHTML = '<div style="color:#ef4444;text-align:center;padding:20px;">조회 실패</div>';
        });
}

function selectAvailableIp(ip) {
    // Find empty IP row or create new one
    var rows = document.querySelectorAll('#ipRows .ip-row');
    var target = null;
    for (var i = 0; i < rows.length; i++) {
        var input = rows[i].querySelector('input[name="ip_addresses[]"]');
        if (input && !input.value.trim()) { target = rows[i]; break; }
    }
    if (!target) {
        addIpRow();
        rows = document.querySelectorAll('#ipRows .ip-row');
        target = rows[rows.length - 1];
    }
    target.querySelector('input[name="ip_addresses[]"]').value = ip;
    closeIpModal();
}

// Close IP modal on background click
document.getElementById('ipModal').addEventListener('click', function(e) {
    if (e.target === this) closeIpModal();
});
</script>

