</div>

<script>
function deleteModule(moduleId, returnTo) {
    if (!confirm('이 모듈을 삭제하시겠습니까?')) return;
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/module-inventory/modules/' + moduleId + '/delete';
    var input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'returnTo';
    input.value = returnTo;
    form.appendChild(input);
    document.body.appendChild(form);
    form.submit();
}
function toggleVendor() {
    var sel = document.getElementById('ownershipSelect');
    var isVendor = sel.value === 'vendor';
    document.getElementById('vendorRow').style.display = isVendor ? '' : 'none';
    document.getElementById('purchaseDateLabel').textContent = isVendor ? '입고일' : '구매일';
    document.getElementById('warrantyEndLabel').textContent = isVendor ? '반납예정일' : '보증만료';
}
function toggleNewVendor() {
    var sel = document.getElementById('vendorSelect');
    var show = sel.value === '__new__';
    document.getElementById('newVendorGroup').style.display = show ? '' : 'none';
    if (show) document.getElementById('newVendorName').focus();
}
function toggleNewRack() {
    var sel = document.getElementById('rackSelect');
    var show = sel.value === '__new__';
    document.getElementById('newRackGroup').style.display = show ? '' : 'none';
    if (show) document.getElementById('newRackName').focus();
}
function toggleNewRoom() {
    var sel = document.getElementById('roomSelect');
    var show = sel.value === '__new__';
    document.getElementById('newRoomGroup').style.display = show ? '' : 'none';
    if (show) document.getElementById('newRoomName').focus();
}
function filterByLocType() {
    var locType = document.getElementById('locTypeSelect').value;
    // Filter room options by location_type
    var roomOpts = document.querySelectorAll('#roomSelect option[data-loc-type]');
    roomOpts.forEach(function(o) {
        o.style.display = (!locType || o.dataset.locType === locType) ? '' : 'none';
    });
    // Reset room selection if it doesn't match
    var roomSel = document.getElementById('roomSelect');
    var curOpt = roomSel.options[roomSel.selectedIndex];
    if (curOpt && curOpt.dataset.locType && curOpt.dataset.locType !== locType) {
        roomSel.value = '';
    }
    // Show/hide rack section
    var rackSection = document.getElementById('rackSection');
    if (locType && locType !== 'server_room') {
        rackSection.style.display = 'none';
        // Clear rack-related values
        document.getElementById('rackSelect').value = '';
        document.getElementById('rackUnitStart').value = '';
    } else {
        rackSection.style.display = '';
    }
    filterRacks();
}
function onAssetTypeChange() {
    var assetType = document.getElementById('assetTypeSelect').value;
    var rackSection = document.getElementById('rackSection');
    var tankSection = document.getElementById('tankSection');
    var infraLinkSection = document.getElementById('infraLinkSection');
    if (assetType === 'immersion_tank') {
        rackSection.style.display = 'none';
        tankSection.style.display = '';
        infraLinkSection.style.display = 'none';
        document.getElementById('rackSelect').value = '';
        document.getElementById('rackUnitStart').value = '';
    } else if (assetType === 'cdu' || assetType === 'chiller') {
        rackSection.style.display = 'none';
        tankSection.style.display = 'none';
        infraLinkSection.style.display = '';
        document.getElementById('rackSelect').value = '';
        document.getElementById('rackUnitStart').value = '';
    } else {
        tankSection.style.display = 'none';
        infraLinkSection.style.display = 'none';
        filterByLocType();
    }
}
function filterRacks() {
    var roomId = document.getElementById('roomSelect').value;
    var sel = document.getElementById('rackSelect');
    var opts = sel.querySelectorAll('option[data-room]');
    var firstVisible = null;
    var currentVisible = false;
    opts.forEach(function(o) {
        var show = !roomId || o.dataset.room === roomId;
        o.style.display = show ? '' : 'none';
        if (show && !firstVisible) firstVisible = o;
        if (show && o.selected) currentVisible = true;
    });
    if (!currentVisible && firstVisible) {
        sel.value = firstVisible.value;
    } else if (!currentVisible) {
        sel.value = '';
    }
    if (typeof loadRackPreview === 'function') loadRackPreview();
}

function calcSlots() {
    var u = parseInt(document.getElementById('uSize').value) || 1;
    var extra = parseInt(document.getElementById('extraSlots').value) || 0;
    var shelfSlots = 0;
    if (document.getElementById('shelfCheck').checked) {
        // BL-1: 선반은 U+홀 병행 입력 (1홀=1/3U). 체크 상태에서 0이 되지 않게 최소 1홀 보정
        var shelfU = parseInt(document.getElementById('shelfUSize').value) || 0;
        var shelfExtra = parseInt(document.getElementById('shelfExtra').value) || 0;
        shelfSlots = shelfU * 3 + shelfExtra;
        if (shelfSlots < 1) {
            shelfSlots = 1;
            document.getElementById('shelfExtra').value = 1;
        }
    }
    document.getElementById('totalSlots').value = u * 3 + extra + shelfSlots;
}

function onShelfToggle() {
    var checked = document.getElementById('shelfCheck').checked;
    document.getElementById('shelfUSizeWrap').style.display = checked ? '' : 'none';
    calcSlots();
}

function calcSlotStart() {
    var u = parseInt(document.getElementById('uStart').value) || 0;
    var hole = parseInt(document.getElementById('holeStart').value) || 1;
    document.getElementById('rackUnitStart').value = u > 0 ? (u - 1) * 3 + hole : '';
}

// Switch slot handling for immersion racks
function onRackChangeCheckSW() {
    var rackSel = document.getElementById('rackSelect');
    var swGroup = document.getElementById('switchSlotGroup');
    var bladeGroup = document.getElementById('bladeSlotGroup');
    var swSelect = document.getElementById('switchSlotSelect');
    if (!rackSel || !swGroup) return;

    var opt = rackSel.options[rackSel.selectedIndex];
    var rackType = opt ? opt.getAttribute('data-rack-type') : '';
    var switchSlots = parseInt(opt ? opt.getAttribute('data-switch-slots') : 0) || 0;

    if (rackType === 'immersion' && switchSlots > 0) {
        swGroup.style.display = '';
        bladeGroup.style.display = 'none';
        // Populate SW options
        swSelect.innerHTML = '<option value="">사용 안 함 (U 위치 사용)</option>';
        for (var i = 1; i <= switchSlots; i++) {
            var o = document.createElement('option');
            o.value = 'SW' + i;
            o.textContent = 'SW' + i;
            swSelect.appendChild(o);
        }
        // Fetch occupied and pre-select current
        var rackId = rackSel.value;
        var excludeId = _currentEditAssetId || '';
        fetch('/racks/' + rackId + '/switch-slots?exclude=' + excludeId)
            .then(function(r) { return r.ok ? r.json() : { occupied: [] }; })
            .then(function(data) {
                for (var j = 1; j < swSelect.options.length; j++) {
                    var slotVal = swSelect.options[j].value;
                    var occ = data.occupied.find(function(o) { return o.slot === slotVal; });
                    if (occ) {
                        swSelect.options[j].textContent = slotVal + ' (사용중: ' + (occ.name || '') + ')';
                        swSelect.options[j].disabled = true;
                    }
                }
                // Pre-select if current asset has SW blade_slot
                var currentBlade = '<%= asset?.blade_slot || "" %>';
                if (currentBlade && /^SW\d+$/i.test(currentBlade)) {
                    for (var j = 0; j < swSelect.options.length; j++) {
                        if (swSelect.options[j].value === currentBlade) {
                            swSelect.options[j].disabled = false;
                            swSelect.options[j].textContent = currentBlade + ' (현재)';
                            swSelect.selectedIndex = j;
                            break;
                        }
                    }
                }
            });
    } else {
        swGroup.style.display = 'none';
        bladeGroup.style.display = '';
        swSelect.value = '';
    }
}

// Call on page load if rack is already selected
(function() {
    var rackSel = document.getElementById('rackSelect');
    if (rackSel && rackSel.value && rackSel.value !== '' && rackSel.value !== '__new__') {
        onRackChangeCheckSW();
    }
})();

var ipTypeOptions = '<% appConfig.ipTypes.filter(t => t.value !== "other").forEach(t => { %><option value="<%= t.value %>"><%= t.label %></option><% }) %><option value="__custom__">기타(직접입력)</option>';
var ipIfaceOptions = '<option value="">-</option><option value="Ethernet">Ethernet</option><option value="InfiniBand">InfiniBand</option>';
var ipSpeedOptions = '<option value="">-</option><option value="1GbE">1GbE</option><option value="10GbE">10GbE</option><option value="25GbE">25GbE</option><option value="40GbE">40GbE</option><option value="100GbE">100GbE</option><option value="200Gbps">200Gbps</option><option value="400Gbps">400Gbps</option><option value="__custom__">직접입력</option>';

function onAssetIpTypeChange(sel) {
