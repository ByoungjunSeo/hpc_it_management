            <select id="ipSubnetSelect" class="form-control" onchange="loadAvailableIps()">
                <option value="">서브넷 선택</option>
                <% appConfig.subnets.forEach(function(s) { %>
                <option value="<%= s.subnet %>"><%= s.label %> (<%= s.subnet %>)</option>
                <% }) %>
            </select>
        </div>
        <div id="ipModalResults" style="max-height:400px; overflow-y:auto;">
