<!-- Fault Repair Modal -->
<div id="faultRepairModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1001; align-items:center; justify-content:center; overflow-y:auto;">
  <div style="background:#fff; border-radius:8px; width:95%; max-width:800px; box-shadow:0 4px 20px rgba(0,0,0,0.3); margin:30px auto;">
    <div style="display:flex; justify-content:space-between; align-items:center; padding:15px 20px; border-bottom:1px solid #eee; background:#fff3cd; border-radius:8px 8px 0 0;">
      <h3 style="margin:0;">장애/수리 처리</h3>
      <button onclick="closeFaultRepairModal()" style="background:none; border:none; font-size:1.5em; cursor:pointer; color:#666;">&times;</button>
    </div>
    <div style="padding:20px;">
      <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:16px;">
        <div class="form-group" style="flex:1; min-width:120px; margin-bottom:0;">
          <label>사유</label>
          <select id="faultReason" class="form-control">
            <option value="장애">장애</option>
            <option value="수리">수리</option>
            <option value="점검">점검</option>
            <option value="교체">교체</option>
          </select>
        </div>
        <div class="form-group" style="flex:1; min-width:120px; margin-bottom:0;">
          <label>처리후 상태</label>
          <select id="faultTargetStatus" class="form-control">
            <option value="maintenance">점검중</option>
            <option value="active">운영중</option>
            <option value="inactive">비활성</option>
          </select>
        </div>
        <div class="form-group" style="flex:2; min-width:200px; margin-bottom:0;">
          <label>비고</label>
          <input type="text" id="faultNotes" class="form-control" placeholder="장애 내용 메모">
        </div>
      </div>

      <div class="table-wrapper" style="margin-bottom:16px; max-height:300px; overflow-y:auto;">
        <table id="faultModuleTable">
          <thead>
            <tr>
              <th>소유</th>
              <th>유형</th>
              <th>모델</th>
              <th>수량</th>
              <th>처리</th>
            </tr>
          </thead>
          <tbody id="faultModuleBody"></tbody>
        </table>
      </div>

      <div id="faultTransferSection" style="display:none; border:1px solid #ddd; border-radius:6px; padding:12px; margin-bottom:16px; background:#f9f9f9;">
        <label style="font-weight:bold; margin-bottom:6px; display:block;">이동 대상 자산</label>
        <input type="text" id="faultTransferSearch" class="form-control" placeholder="관리번호 또는 모델명 검색..." oninput="filterFaultTransferAssets()" style="margin-bottom:6px;">
        <select id="faultTransferAssetSelect" class="form-control" size="5" style="height:auto;">
          <option value="">로딩 중...</option>
        </select>
      </div>

      <div id="faultResultMsg" style="font-size:13px; min-height:20px; margin-bottom:8px;"></div>
      <div style="display:flex; gap:8px; justify-content:flex-end;">
        <button type="button" class="btn btn-outline" onclick="closeFaultRepairModal()">취소</button>
        <button type="button" class="btn btn-warning" onclick="submitFaultRepair()">장애/수리 처리</button>
      </div>
    </div>
  </div>
</div>

<!-- Restore Modal -->
<% if (asset.status === 'maintenance') { %>
<div id="restoreModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1001; align-items:center; justify-content:center;">
  <div style="background:#fff; border-radius:8px; width:90%; max-width:500px; box-shadow:0 4px 20px rgba(0,0,0,0.3);">
    <div style="display:flex; justify-content:space-between; align-items:center; padding:15px 20px; border-bottom:1px solid #eee; background:#d4edda; border-radius:8px 8px 0 0;">
      <h3 style="margin:0;">수리완료 / 복귀</h3>
