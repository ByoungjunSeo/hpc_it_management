<%- include('../partials/header', { title, currentPath, extraCss }) %>

<div class="page-header">
    <h1>자산 상세</h1>
    <div class="btn-group">
        <a href="/assets/<%= asset.id %>/edit" class="btn btn-primary">수정</a>
        <%# T2: SSH 터미널 — 관리자 한정, SSH 자격증명(bmc/etc 제외) 있어야 활성 %>
        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') {
             const sshExcluded = ['bmc', 'ipmi']; // BMC/IPMI는 SSH 후보 아님(sshTerminal.SSH_EXCLUDED_TYPES와 일치)
             const sshOk = (typeof assetCredentials !== 'undefined') && assetCredentials.some(c => !sshExcluded.includes(c.credential_type) && c.has_password); %>
          <% if (sshOk) { %>
          <a href="/assets/<%= asset.id %>/terminal" class="btn btn-secondary">SSH 터미널</a>
          <% } else { %>
          <button class="btn btn-secondary" disabled title="등록된 SSH 자격증명 없음" style="opacity:.5;cursor:not-allowed;">SSH 터미널</button>
          <% } %>
        <% } %>
        <form method="POST" action="/assets/<%= asset.id %>/delete" style="display:inline" onsubmit="return confirmDelete('이 자산을 삭제하시겠습니까?')">
            <button type="submit" class="btn btn-danger">삭제</button>
        </form>
        <% if (modules && modules.length > 0) { %>
        <button class="btn btn-warning" onclick="openFaultRepairModal()">장애/수리</button>
        <% } %>
        <% if (asset.status === 'maintenance') { %>
        <button class="btn btn-success" onclick="openRestoreModal()">수리완료/복귀</button>
        <% } %>
        <a href="/assets" class="btn btn-secondary">목록</a>
    </div>
</div>

<div class="card">
    <div class="card-header"><h2>기본 정보</h2></div>
    <div class="form-row">
        <div class="form-group">
            <label>자산번호</label>
            <p><%= asset.asset_number || '-' %></p>
        </div>
        <div class="form-group">
            <label>관리번호</label>
            <p><%= asset.management_number || '-' %></p>
        </div>
        <div class="form-group">
            <label>유형</label>
            <p><span class="badge badge-<%= asset.asset_type %>"><%= appConfig.assetTypes.find(t => t.value === asset.asset_type)?.label %></span></p>
        </div>
        <div class="form-group">
            <label>소유구분</label>
            <p><span class="badge badge-<%= asset.ownership %>"><%= asset.ownership === 'company' ? '자사' : '업체' %></span>
            <% if (asset.vendor_name) { %>(<%= asset.vendor_name %>)<% } %></p>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>제조사</label>
            <p><%= asset.manufacturer || '-' %></p>
        </div>
        <div class="form-group">
            <label>모델명</label>
            <p><%= asset.model_name || '-' %></p>
        </div>
        <div class="form-group">
            <label>시리얼번호</label>
            <p><%= asset.serial_number || '-' %></p>
        </div>
        <div class="form-group">
            <label>상태</label>
            <p><span class="badge badge-<%= asset.status === 'active' ? 'success' : asset.status === 'returned' ? 'info' : asset.status === 'maintenance' ? 'warning' : 'secondary' %>"><%= appConfig.assetStatuses.find(t => t.value === asset.status)?.label %></span>
            <%# BL-13: 이 자산이 걸린 active 대여 건 배지 — 잔여 수량 기준 역조회 %>
            <% (typeof activeLendings !== 'undefined' ? activeLendings : []).forEach(l => { %>
            <a href="/lendings/<%= l.id %>/edit" style="text-decoration:none">
                <span class="badge badge-<%= l.overdue ? 'danger' : 'warning' %>" title="대여일 <%= l.loan_date || '-' %> / 예정일 <%= l.due_date || '-' %>">
                    <%= l.direction === 'outbound' ? '대여중' : '차입' %>: <%= l.counterparty %><%= l.overdue ? ' (연체)' : '' %>
                </span>
            </a>
            <% }) %>
            </p>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h2>위치 정보</h2></div>
    <div class="form-row">
        <div class="form-group">
            <label>서버실</label>
            <p><%= asset.room_name || '-' %></p>
        </div>
        <div class="form-group">
            <label>랙</label>
            <p><% if (asset.rack_id) { %><a href="/racks/<%= asset.rack_id %>"><%= asset.rack_name %></a><% } else { %>-<% } %></p>
        </div>
        <div class="form-group">
            <label>U 위치</label>
            <% if (asset.rack_unit_start) {
                const su = Math.floor((asset.rack_unit_start - 1) / 3) + 1;
                const sh = ((asset.rack_unit_start - 1) % 3) + 1;
                const endSlot = asset.rack_unit_start + (asset.rack_unit_size || 3) - 1;
                const eu = Math.floor((endSlot - 1) / 3) + 1;
                const eh = ((endSlot - 1) % 3) + 1;
            %>
            <p>U<%= su %>(<%= sh %>)<%= (asset.rack_unit_size || 3) > 1 ? '-U' + eu + '(' + eh + ')' : '' %></p>
            <% } else { %>
            <p>-</p>
            <% } %>
        </div>
    </div>
</div>

<% if (asset.asset_type === 'immersion_tank' && typeof linkedRack !== 'undefined' && linkedRack) { %>
<div class="card">
    <div class="card-header"><h2>탱크 용량</h2></div>
    <div class="form-row">
        <div class="form-group">
            <label>서버 수용 U수</label>
            <p><%= linkedRack.total_units %>U</p>
        </div>
        <div class="form-group">
            <label>스위치 슬롯</label>
            <p><%= linkedRack.switch_slots || 0 %>개</p>
        </div>
        <div class="form-group">
            <label>배치된 장비</label>
            <p><%= typeof linkedRackAssetCount !== 'undefined' ? linkedRackAssetCount : 0 %>대</p>
        </div>
        <div class="form-group" style="align-self:flex-end;">
            <a href="/racks/<%= linkedRack.id %>" class="btn btn-sm btn-outline">랙 상세 보기</a>
        </div>
    </div>
</div>
<% } %>

<% if (asset.parent_asset_id && ['cdu','chiller'].includes(asset.asset_type)) { %>
<div class="card">
    <div class="card-header"><h2>연결 설비</h2></div>
    <div class="form-row">
        <div class="form-group">
            <label>연결 대상</label>
            <p><% if (typeof parentAsset !== 'undefined' && parentAsset) { %>
                <a href="/assets/<%= parentAsset.id %>">
                    <span class="badge badge-<%= parentAsset.asset_type %>"><%= appConfig.assetTypes.find(t => t.value === parentAsset.asset_type)?.label %></span>
                    <%= parentAsset.management_number || parentAsset.model_name || parentAsset.id %>
                </a>
            <% } else { %>-<% } %></p>
        </div>
    </div>
</div>
<% } %>

<%- include('../partials/photo-section', { entityType: 'asset', entityId: asset.id, photos: typeof assetPhotos !== 'undefined' ? assetPhotos : [], editable: true }) %>

<% if (typeof childInfraAssets !== 'undefined' && childInfraAssets && childInfraAssets.length > 0) { %>
<div class="card">
    <div class="card-header"><h2>연결된 하위 설비</h2></div>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>유형</th>
                    <th>관리번호</th>
                    <th>모델명</th>
                    <th>상태</th>
                </tr>
            </thead>
            <tbody>
                <% childInfraAssets.forEach(child => { %>
                <tr>
                    <td><span class="badge badge-<%= child.asset_type %>"><%= appConfig.assetTypes.find(t => t.value === child.asset_type)?.label %></span></td>
                    <td><a href="/assets/<%= child.id %>"><%= child.management_number || '-' %></a></td>
                    <td><%= child.model_name || '-' %></td>
                    <td><span class="badge badge-<%= child.status === 'active' ? 'success' : 'secondary' %>"><%= appConfig.assetStatuses.find(t => t.value === child.status)?.label %></span></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<% } %>

<div class="card">
    <div class="card-header"><h2>IP 주소</h2></div>
    <% if (typeof assetIps !== 'undefined' && assetIps.length > 0) { %>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>유형</th>
                    <th>인터페이스</th>
                    <th>속도</th>
                    <th>IP 주소</th>
                    <th>설명</th>
                </tr>
            </thead>
            <tbody>
                <% assetIps.forEach(ip => { %>
                <tr>
                    <td><span class="badge badge-info"><%= (ip.ip_type === 'other' && ip.description) ? ip.description : (appConfig.ipTypes.find(t => t.value === ip.ip_type)?.label || ip.ip_type) %></span></td>
                    <td><%= ip.interface_type || '-' %></td>
                    <td><%= ip.speed || '-' %></td>
                    <td><%= ip.ip_address %></td>
                    <td><%= (ip.ip_type !== 'other' && ip.description) ? ip.description : '-' %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <% } else if (asset.ip_address) { %>
    <div class="form-row">
        <div class="form-group">
            <label>IP 주소</label>
            <p><%= asset.ip_address %></p>
        </div>
        <div class="form-group">
            <label>SSH 포트</label>
            <p><%= asset.ssh_port || '-' %></p>
        </div>
    </div>
    <% } else { %>
    <p class="text-muted">등록된 IP 주소가 없습니다.</p>
    <% } %>
</div>

<div class="card">
    <div class="card-header"><h2>접속 정보</h2></div>
    <% if (typeof assetCredentials !== 'undefined' && assetCredentials.length > 0) { %>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>유형</th>
                    <th>사용자</th>
                    <th>비밀번호</th>
                    <th>설명</th>
                </tr>
            </thead>
            <tbody>
                <% assetCredentials.forEach(cred => { %>
                <tr>
                    <td><span class="badge badge-info"><%= appConfig.credentialTypes.find(t => t.value === cred.credential_type)?.label || cred.credential_type %></span></td>
                    <td><%= cred.username %></td>
                    <%# BL-11 후속: 비밀번호 값은 서버 렌더에 미포함. [보기] 클릭 시에만 조회. %>
                    <td>
                        <% if (cred.has_password) { %>
                        <span class="cred-cell" data-asset="<%= asset.id %>" data-cred="<%= cred.id %>" data-shown="0">
                            <code class="cred-mask">●●●●●●</code>
                            <button type="button" class="btn btn-sm btn-outline cred-reveal" onclick="revealCredential(this)">보기</button>
                            <button type="button" class="btn btn-sm btn-outline cred-copy" onclick="copyCredential(this)" hidden>복사</button>
                        </span>
                        <% } else { %><span style="color:#94a3b8;">-</span><% } %>
                    </td>
                    <td><%= cred.description || '-' %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <% } else if (asset.ssh_user) { %>
    <div class="form-row">
        <div class="form-group">
            <label>SSH 사용자</label>
            <p><%= asset.ssh_user %></p>
        </div>
        <div class="form-group">
            <label>SSH 포트</label>
            <p><%= asset.ssh_port || 22 %></p>
        </div>
    </div>
    <% } else { %>
    <p class="text-muted">등록된 접속 정보가 없습니다.</p>
    <% } %>
</div>

<div class="card">
    <div class="card-header"><h2>운영 정보</h2></div>
    <div class="form-row">
        <div class="form-group">
            <label>사용자</label>
            <p><%= asset.assigned_user || '-' %></p>
        </div>
        <div class="form-group">
            <label>용도</label>
            <p><%= asset.purpose || '-' %></p>
        </div>
        <div class="form-group">
            <label>구매일</label>
            <p><%= asset.purchase_date || '-' %></p>
        </div>
        <div class="form-group">
            <label>보증만료</label>
            <p><%= asset.warranty_end || '-' %></p>
        </div>
    </div>
    <% if (asset.notes) { %>
    <div class="form-group">
        <label>비고</label>
        <p><%= asset.notes %></p>
    </div>
    <% } %>
</div>

<div class="card">
    <div class="card-header">
        <h2>컴퓨팅 모듈</h2>
        <div style="display:flex; gap:8px; align-items:center;">
            <button type="button" class="btn btn-sm btn-outline" id="bulkTransferBtn" style="display:none" onclick="openBulkTransfer()">선택 이동 (<span id="bulkCount">0</span>)</button>
            <a href="/module-inventory/modules/new?asset_id=<%= asset.id %>" class="btn btn-sm btn-primary">+ 모듈 추가</a>
        </div>
    </div>
<% if (modules && modules.length > 0) { %>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th><input type="checkbox" id="selectAllModules" onchange="toggleAllModules(this)" title="전체 선택"></th>
                    <th>유형</th>
                    <th>소유</th>
                    <th>코드</th>
                    <th>모델</th>
                    <th>제조사</th>
                    <th>용량</th>
                    <th>수량</th>
                    <th>설치유형</th>
                    <th>관리</th>
                </tr>
            </thead>
            <tbody>
                <% modules.forEach(m => { %>
                <tr>
                    <td><input type="checkbox" class="module-check" value="<%= m.id %>" data-label="<%= (m.module_type || '').toUpperCase() + ' ' + (m.model || '') %>" onchange="updateBulkBtn()"></td>
                    <td><span class="badge badge-info"><%= appConfig.moduleTypes.find(t => t.value === m.module_type)?.label || m.module_type %></span></td>
                    <td>
                        <% if (m.owner === 'vendor') { %>
                            <span class="badge badge-warning" title="<%= m.owner_vendor_name || '업체' %>"><%= m.owner_vendor_name || '업체' %></span>
                        <% } else { %>
                            <span class="badge badge-success">자사</span>
                        <% } %>
                    </td>
                    <td><% if (m.item_code) { %><code><%= m.item_code %></code><% } else { %>-<% } %></td>
                    <td><%= m.model || '-' %></td>
                    <td><%= m.manufacturer || '-' %></td>
                    <td><%= m.capacity || '-' %></td>
                    <td><%= m.count %></td>
                    <td>
                        <% if (m.is_onboard) { %>
                            <span class="badge badge-secondary">온보드</span>
                        <% } else { %>
                            <span class="badge badge-info">애드온</span>
                        <% } %>
                    </td>
                    <td style="white-space:nowrap;">
                        <button type="button" class="btn btn-sm btn-outline" onclick="openTransferModal([<%= m.id %>], '<%= (m.module_type || '').toUpperCase() + ' ' + (m.model || '').replace(/'/g, "\\'") %>')">이동</button>
                        <a href="/module-inventory/modules/<%= m.id %>/edit" class="btn btn-sm btn-outline">수정</a>
                        <form method="POST" action="/module-inventory/modules/<%= m.id %>/delete" style="display:inline" onsubmit="return confirm('이 모듈을 삭제하시겠습니까?')">
                            <input type="hidden" name="returnTo" value="/assets/<%= asset.id %>">
                            <button type="submit" class="btn btn-sm btn-danger">삭제</button>
                        </form>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="openModuleActionModal(<%= m.id %>, 'storage', '<%= (m.module_type || '').toUpperCase() + ' ' + (m.model || '').replace(/'/g, "\\'") %>')">장비실</button>
                        <% if (m.owner === 'vendor') { %>
                        <button type="button" class="btn btn-sm btn-warning" onclick="openModuleActionModal(<%= m.id %>, 'vendor_return', '<%= (m.module_type || '').toUpperCase() + ' ' + (m.model || '').replace(/'/g, "\\'") %>')">반납</button>
                        <% } %>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
<% } else { %>
    <p class="text-muted">등록된 컴퓨팅 모듈이 없습니다.</p>
<% } %>
</div>

<% if (typeof equipmentLogs !== 'undefined' && equipmentLogs && equipmentLogs.length > 0) { %>
<div class="card">
    <div class="card-header">
        <h2>입출고 이력</h2>
        <a href="/inventory/equipment/<%= encodeURIComponent(asset.management_number) %>" class="btn btn-sm btn-outline">상세 보기</a>
    </div>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>상태</th>
                    <th>사용날짜</th>
                    <th>반납일자</th>
                    <th>사용자</th>
                    <th>시험명</th>
                    <th>위치</th>
                </tr>
            </thead>
            <tbody>
                <% equipmentLogs.forEach(log => { %>
                <tr>
                    <td>
                        <% if (log.status === '입고') { %>
                        <span class="badge badge-secondary">입고</span>
                        <% } else if (log.status === '사용중') { %>
                        <span class="badge badge-success">사용중</span>
                        <% } else if (log.status === '반납완료') { %>
                        <span class="badge badge-warning">반납완료</span>
                        <% } %>
                    </td>
                    <td><%= log.usage_date || '-' %></td>
                    <td><%= log.return_date || '-' %></td>
                    <td><%= log.user_name || '-' %></td>
                    <td><%= log.test_name || '-' %></td>
                    <td><%= [log.room, log.rack, log.unit].filter(Boolean).join('/') || '-' %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<% } %>

<% if (typeof moduleChangeLogs !== 'undefined' && moduleChangeLogs && moduleChangeLogs.length > 0) { %>
<div class="card">
    <div class="card-header">
        <h2>부품 변경 이력</h2>
    </div>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>일시</th>
                    <th>유형</th>
                    <th>부품코드</th>
                    <th>수량변동</th>
                    <th>사용자</th>
                    <th>비고</th>
                </tr>
            </thead>
            <tbody>
                <%
                  const modEventLabels = { incoming: '입고', outgoing: '출고', installed: '설치', removed: '제거', transfer: '이동', adjust: '조정', transferred: '변경' };
                  const modEventColors = { incoming: 'success', outgoing: 'warning', installed: 'info', removed: 'danger', transfer: 'secondary', adjust: 'warning', transferred: 'secondary' };
                %>
                <% moduleChangeLogs.forEach(log => { %>
                <tr>
                    <td style="white-space:nowrap; font-size:12px;"><%= log.created_at ? log.created_at.replace('T', ' ').substring(0, 16) : '-' %></td>
                    <td><span class="badge badge-<%= modEventColors[log.event_type] || 'secondary' %>"><%= modEventLabels[log.event_type] || log.event_type %></span></td>
                    <td><code><%= log.item_code || '-' %></code></td>
                    <td style="font-weight:bold;"><%= log.quantity_change ? Math.abs(log.quantity_change) : '-' %></td>
                    <td><%= log.username || '-' %></td>
                    <td style="font-size:12px;"><%= log.notes || '-' %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<% } %>

<% if (typeof moduleTransferLogs !== 'undefined' && moduleTransferLogs && moduleTransferLogs.length > 0) { %>
<div class="card">
    <div class="card-header">
        <h2>모듈 이동 이력</h2>
    </div>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>일시</th>
                    <th>유형</th>
                    <th>모델</th>
                    <th>수량</th>
                    <th>출발</th>
                    <th>도착</th>
                    <th>사유</th>
                    <th>처리자</th>
                </tr>
            </thead>
            <tbody>
                <% moduleTransferLogs.forEach(tlog => { %>
                <tr>
                    <td style="white-space:nowrap; font-size:12px;"><%= tlog.created_at ? tlog.created_at.replace('T', ' ').substring(0, 16) : (tlog.transfer_date || '-') %></td>
                    <td><span class="badge badge-info"><%= appConfig.moduleTypes.find(t => t.value === tlog.module_type)?.label || tlog.module_type %></span></td>
                    <td><%= tlog.model || '-' %></td>
                    <td><%= tlog.count || 1 %></td>
                    <td>
                        <% if (tlog.from_asset_id === asset.id) { %>
                            <span class="badge badge-warning"><%= asset.management_number || asset.model_name %></span>
                        <% } else if (tlog.from_asset_id) { %>
                            <a href="/assets/<%= tlog.from_asset_id %>"><%= tlog.from_asset_label || ('ID:' + tlog.from_asset_id) %></a>
                        <% } else { %>
                            <%= tlog.from_asset_label || '-' %>
                        <% } %>
                    </td>
                    <td>
                        <% if (tlog.to_asset_id === asset.id) { %>
                            <span class="badge badge-success"><%= asset.management_number || asset.model_name %></span>
                        <% } else if (tlog.to_asset_id) { %>
                            <a href="/assets/<%= tlog.to_asset_id %>"><%= tlog.to_asset_label || ('ID:' + tlog.to_asset_id) %></a>
                        <% } else { %>
                            <%= tlog.to_asset_label || '-' %>
                        <% } %>
                    </td>
                    <td><%= tlog.reason || '-' %></td>
                    <td><%= tlog.username || '-' %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<% } %>

