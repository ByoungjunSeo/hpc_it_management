# ============================================================
# IT 자산관리 시스템 v2 — 환경 변수 설정
# ============================================================
# 이 파일을 .env로 복사하고 모든 CHANGE_ME 값을 실제 값으로 변경하세요.
# 비밀번호와 시크릿은 절대 git에 커밋되면 안 됩니다.
# 부서/회사별로 다른 .env를 사용하세요.
#
#   cp .env.example .env
#   vi .env
# ============================================================

# === PostgreSQL 데이터베이스 ===
POSTGRES_DB=it_assets
POSTGRES_USER=itadmin
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# === 애플리케이션 ===
APP_PORT=3001
# 외부 웹 접속 포트. 부서별로 변경 가능 (예: 80, 3001, 8080)
# 80 사용 시 시스템 권한 필요할 수 있음

SESSION_SECRET=CHANGE_ME_TO_RANDOM_STRING_AT_LEAST_32_CHARS
# 세션 암호화 키. 부서마다 다른 강력한 값으로

# === 초기 관리자 계정 ===
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_ADMIN_PASSWORD
# admin 계정의 초기 비밀번호.
# 첫 로그인 후 관리자 페이지에서 변경 권장.
# 본인 회사 운영 시에는 v1 사용자 계정이 그대로 마이그레이션되므로
# 이 값은 admin 계정에만 적용됨.

# === 운영 환경 ===
NODE_ENV=production

# === 기능 토글 (배포 환경별 ON/OFF) ===
# true: 메뉴/기능 활성화, false: 메뉴 숨김 + 라우트 비활성화

FEATURE_VENDOR_INTAKE=true
# 벤더 입고 신청서 기능. 본사는 true, 일반 부서는 false 권장

FEATURE_POWER_NODES=true
# 전력분전반(PDU/전원 노드) 관리 기능. 데이터센터는 true, 일반 사무실은 false

# === 디스커버리 ===
SSH_DEFAULT_PASSWORD=CHANGE_ME_SSH_FALLBACK_PASSWORD
# 자산에 자격증명이 없을 때 SSH 스캔 fallback 비밀번호

OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:14b
# AI 스펙 조회(specLookup)용 로컬 Ollama 주소/모델. 미기동 시 degrade 동작
