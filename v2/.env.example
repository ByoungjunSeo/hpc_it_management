# ============================================================
# IT 자산관리 시스템 v2 — 환경 변수 설정
# ============================================================
# 이 파일을 .env로 복사하고 모든 CHANGE_ME 값을 실제 값으로 변경하세요.
# 비밀번호와 시크릿은 절대 git에 커밋되면 안 됩니다.
# 부서/회사별로 다른 .env를 사용하세요.
#
#   cp .env.example .env
#   vi .env
# ============================================================

# === PostgreSQL 데이터베이스 ===
POSTGRES_DB=it_assets
POSTGRES_USER=itadmin
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# === 애플리케이션 ===
APP_PORT=3001
# 외부 웹 접속 포트. 부서별로 변경 가능 (예: 80, 3001, 8080)
# 80 사용 시 시스템 권한 필요할 수 있음

SESSION_SECRET=CHANGE_ME_TO_RANDOM_STRING_AT_LEAST_32_CHARS
# 세션 암호화 키. 부서마다 다른 강력한 값으로
# ★ 32자 이상 필수 — 미설정/CHANGE_ME/기본값이면 기동이 차단됩니다.
#   생성 예: openssl rand -hex 32

# === 초기 관리자 계정 ===
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_ADMIN_PASSWORD
# admin 계정의 초기 비밀번호.
# 첫 로그인 후 관리자 페이지에서 변경 권장.
# 본인 회사 운영 시에는 v1 사용자 계정이 그대로 마이그레이션되므로
# 이 값은 admin 계정에만 적용됨.

# === 운영 환경 ===
NODE_ENV=production

# === 기능 토글 (배포 환경별 ON/OFF) ===
# true: 메뉴/기능 활성화, false: 메뉴 숨김 + 라우트 비활성화

FEATURE_VENDOR_INTAKE=true
# 벤더 입고 신청서 기능. 본사는 true, 일반 부서는 false 권장

FEATURE_POWER_NODES=true
# 전력분전반(PDU/전원 노드) 관리 기능. 데이터센터는 true, 일반 사무실은 false

# === 자격증명 암호화 (BL-11) ===
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_HEX_64_CHARS
# ★ 장비 접속 자격증명(SSH/BMC 비밀번호)을 DB에 AES-256-GCM으로 암호화하는 키.
#   hex 64자(32바이트) 필수 — 생성: openssl rand -hex 32
#   형식이 틀리면 기동 차단. 자격증명 기능을 쓰면 반드시 설정.
#   ⚠ 이 키를 잃으면 저장된 자격증명을 복구할 수 없습니다 —
#     DB 백업과 '별도 장소'에 안전 보관하세요(둘 다 잃으면 재입력만이 복구).

# === 디스커버리 (SSH 스캔 기능) ===
SSH_DEFAULT_PASSWORD=CHANGE_ME_SSH_FALLBACK_PASSWORD
# 자산에 자격증명 미등록 시 SSH 스캔 fallback 비밀번호.
# (참고: 이 값은 .env 파일 권한으로 보호되는 영역 — DB 암호화(BL-11) 대상과 위협 모델이 다름)
SSH_DEFAULT_USER=root
# fallback SSH 계정 (기본 root)

# === 원격 접근 스위트 (v2.2 — 선택, 모두 기본값 있음) ===
# 웹 SSH 터미널(T2) 동시 세션·유휴 제한
#SSH_TERM_MAX_TOTAL=5
#SSH_TERM_MAX_PER_USER=2
#SSH_TERM_IDLE_MINUTES=15
# 웹 BMC SOL 콘솔(T3) 동시 세션·유휴 제한 (동일 BMC는 항상 동시 1세션)
#SOL_TERM_MAX_TOTAL=3
#SOL_TERM_MAX_PER_USER=1
#SOL_TERM_IDLE_MINUTES=15

# === 백업 관리 (T4) ===
# 웹 백업·scripts/backup.sh·restore.sh가 docker exec할 DB 컨테이너명.
# 기본값 it-assets-db-1(compose 표준). ★ 단독 DB 컨테이너 등 이름이 다르면 반드시 지정.
#DB_CONTAINER_NAME=it-assets-db-1
# 웹 백업 보존 개수(기본 14). 생성 시 초과분 오래된 순 자동 삭제.
#BACKUP_KEEP_COUNT=14

# === 사이트 설정 ===
LENDING_ORG_LABEL=CHANGE_ME_ORG_NAME
# 대여 방향 라벨에 쓰이는 기관명 (예: TTA)

SUBNETS_JSON=
# IP 관리 초기 대역(JSON 배열). 미설정 시 빈 상태로 기동(자동 시드 없음).
# 예: [{"subnet":"192.168.1.0/24","zone":"office","label":"Office-1"}]
# zone: office | hpc | aidc
