<%- include('../partials/header', { title, currentPath, extraCss }) %>

<div class="page-header">
    <h1>사무실 장비</h1>
</div>

<% if (rooms.length === 0) { %>
<div class="card text-center">
    <p class="text-muted">등록된 사무실이 없습니다.</p>
</div>
<% } %>

<% rooms.forEach(room => { %>
<div class="card">
    <div class="card-header">
        <h2><%= room.name %></h2>
        <span class="text-muted"><%= room.location || '' %> &middot; 장비 <%= room.assets.length %>대</span>
    </div>

    <% if (room.assets.length === 0) { %>
    <p class="text-muted">등록된 장비가 없습니다.</p>
    <% } else { %>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>자산번호</th>
                    <th>유형</th>
                    <th>모델명</th>
                    <th>IP 주소</th>
                    <th>사용자</th>
                    <th>용도</th>
                    <th>상태</th>
                </tr>
            </thead>
            <tbody>
                <% room.assets.forEach(asset => { %>
                <tr>
                    <td><a href="/assets/<%= asset.id %>"><%= asset.asset_number || '-' %></a></td>
                    <td><span class="badge badge-<%= asset.asset_type %>"><%= appConfig.assetTypes.find(t => t.value === asset.asset_type)?.label || asset.asset_type %></span></td>
                    <td><%= asset.model_name || '-' %></td>
                    <td><%= asset.ip_address || '-' %></td>
                    <td><%= asset.assigned_user || '-' %></td>
                    <td><%= asset.purpose || '-' %></td>
                    <td><span class="badge badge-<%= asset.status === 'active' ? 'success' : asset.status === 'maintenance' ? 'warning' : 'secondary' %>"><%= appConfig.assetStatuses.find(t => t.value === asset.status)?.label || asset.status %></span></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <% } %>
</div>
<% }) %>

<%- include('../partials/footer', { extraJs: null }) %>
