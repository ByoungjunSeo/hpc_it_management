<%- include('../partials/header', { title, currentPath, extraCss }) %>

<div class="page-header">
    <h1>계정 관리</h1>
</div>

<div class="card">
    <div class="card-header"><h2>새 계정 추가</h2></div>
    <form method="POST" action="/admin/users">
        <div class="form-row">
            <div class="form-group">
                <label>아이디 *</label>
                <input type="text" name="username" class="form-control" required>
            </div>
            <div class="form-group">
                <label>비밀번호 *</label>
                <input type="password" name="password" class="form-control" required>
            </div>
            <div class="form-group">
                <label>역할 *</label>
                <select name="role" class="form-control" required>
                    <option value="viewer">조회전용 (viewer)</option>
                    <option value="maintenance">유지보수 (maintenance)</option>
                    <option value="admin">관리자 (admin)</option>
                </select>
            </div>
            <div class="form-group">
                <label>표시 이름</label>
                <input type="text" name="display_name" class="form-control" placeholder="선택사항">
            </div>
        </div>
        <button type="submit" class="btn btn-primary">계정 생성</button>
    </form>
</div>

<div class="card">
    <div class="card-header"><h2>계정 목록</h2></div>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>아이디</th>
                    <th>표시 이름</th>
                    <th>역할</th>
                    <th>생성일</th>
                    <th>관리</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                <tr>
                    <td><strong><%= user.username %></strong></td>
                    <td><%= user.display_name || '-' %></td>
                    <td>
                        <span class="badge badge-<%= user.role === 'admin' ? 'danger' : user.role === 'maintenance' ? 'warning' : 'info' %>">
                            <%= user.role === 'admin' ? '관리자' : user.role === 'maintenance' ? '유지보수' : '조회전용' %>
                        </span>
                    </td>
                    <td><%= user.created_at ? user.created_at.substring(0, 10) : '-' %></td>
                    <td>
                        <button class="btn btn-sm btn-outline" onclick="toggleEdit(<%= user.id %>)">수정</button>
                        <% if (user.username !== 'admin') { %>
                        <form method="POST" action="/admin/users/<%= user.id %>/delete" style="display:inline" onsubmit="return confirm('계정을 삭제하시겠습니까?')">
                            <button type="submit" class="btn btn-sm btn-danger">삭제</button>
                        </form>
                        <% } %>
                    </td>
                </tr>
                <tr id="edit-<%= user.id %>" style="display:none">
                    <td colspan="5">
                        <form method="POST" action="/admin/users/<%= user.id %>" class="form-row" style="align-items:flex-end; gap:8px; padding:8px 0;">
                            <div class="form-group" style="margin:0">
                                <label>아이디</label>
                                <input type="text" name="username" class="form-control" value="<%= user.username %>" required>
                            </div>
                            <div class="form-group" style="margin:0">
                                <label>새 비밀번호</label>
                                <input type="password" name="password" class="form-control" placeholder="변경 시 입력">
                            </div>
                            <div class="form-group" style="margin:0">
                                <label>역할</label>
                                <select name="role" class="form-control">
                                    <option value="viewer" <%= user.role === 'viewer' ? 'selected' : '' %>>조회전용</option>
                                    <option value="maintenance" <%= user.role === 'maintenance' ? 'selected' : '' %>>유지보수</option>
                                    <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>관리자</option>
                                </select>
                            </div>
                            <div class="form-group" style="margin:0">
                                <label>표시 이름</label>
                                <input type="text" name="display_name" class="form-control" value="<%= user.display_name || '' %>">
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary">저장</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<script>
function toggleEdit(id) {
    var row = document.getElementById('edit-' + id);
    row.style.display = row.style.display === 'none' ? '' : 'none';
}
</script>

<%- include('../partials/footer', { extraJs }) %>
